amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

fail_fast = false

local fallow_audit = Step {
  check = "pnpm fallow:audit"
  stomp = true
}

local fallow_ci = Step {
  check = "pnpm check && pnpm next:typegen && pnpm test:coverage && pnpm fallow:ci"
  stomp = true
}

// Pre-commit: scan only the files actually being committed. `--staged` exits 0
// when nothing is staged, and `--blocking warning` fails on any newly
// introduced warning or error.
local react_doctor_staged = Step {
  check = "pnpm react-doctor:staged"
  stomp = true
}

// Pre-push: fail if the branch introduces any warning or error relative to
// origin/master (the PR merge-base), so pushed branches are always
// review-clean. Depends on the `fetch` step so the base ref is fresh.
local react_doctor_changed = Step {
  check = "pnpm react-doctor:changed"
  depends = List("fetch")
  stomp = true
}

local fast_steps = new Mapping<String, Step> {
  ["oxfmt"] = (Builtins.oxfmt) {
    prefix = "pnpm exec --"
  }
  ["oxlint"] = (Builtins.ox_lint) {
    prefix = "pnpm exec --"
    check = "oxlint {{files}}"
    fix = "oxlint --fix {{files}}"
  }
  ["fallow-audit"] = fallow_audit
  ["react-doctor"] = react_doctor_staged
}

local push_steps = new Mapping<String, Step> {
  ["fetch"] {
    check = "git fetch origin master || true"
  }
  ["fallow-ci"] = fallow_ci
  ["react-doctor"] = react_doctor_changed
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast_steps
  }
  ["pre-push"] {
    steps = push_steps
  }
  ["check"] {
    steps = fast_steps
  }
  ["fix"] {
    fix = true
    steps = fast_steps
  }
}
