{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route,default}.{ts,tsx}",
    "convex/**/*.ts",
    "src/i18n/request.ts"
  ],
  "ignorePatterns": [
    ".next/**",
    "scripts/**",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "next.config.ts",
    "postcss.config.*",
    "vitest.config.ts",
    "vitest.setup.ts",
    "convex/test.setup.ts"
  ],
  "ignoreFindings": [
    "convex/_generated/**"
  ],
  "ignoreExports": [
    {
      "file": "src/components/ui/*.tsx",
      "exports": [
        "*"
      ]
    },
    {
      "file": "src/i18n/routing.ts",
      "exports": [
        "usePathname"
      ]
    }
  ],
  "ignoreUnresolvedImports": [
    "../../messages/**"
  ],
  "ignoreDependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "shadcn",
    "tw-animate-css",
    "tailwindcss",
    "fluid-tailwindcss",
    "convex-test",
    "@edge-runtime/vm",
    "lefthook",
    "oxfmt",
    "oxlint",
    "scrape-yt",
    "scrape-youtube",
    "youtube-sr",
    "yt-search"
  ],
  "typeAware": {
    "enabled": true,
    "require": "best-effort",
    "projects": [
      "tsconfig.json",
      "tsconfig.tests.json",
      "convex/tsconfig.json"
    ]
  },
  "rules": {
    "private-type-leaks": "warn"
  },
  "duplicates": {
    "mode": "semantic",
    "minLines": 8,
    "minTokens": 60,
    "minOccurrences": 3,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60
  },
  "audit": {
    "gate": "new-only"
  }
}
