{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route,default}.{ts,tsx}",
    "convex/**/*.ts",
    "src/i18n/request.ts"
  ],
  "ignorePatterns": [
    "scripts/**",
    "convex/_generated/**",
    "oxfmt.config.ts",
    "doctor.config.ts"
  ],
  "ignoreExports": [
    {
      "file": "src/components/ui/*.tsx",
      "exports": [
        "*"
      ]
    }
  ],
  "ignoreDependencies": [
    "scrape-yt",
    "scrape-youtube",
    "@edge-runtime/vm",
    "tailwindcss",
    "react-doctor"
  ],
  "typeAware": {
    "enabled": true,
    "require": "complete",
    "projects": [
      "tsconfig.json",
      "tsconfig.tests.json",
      "convex/tsconfig.json"
    ]
  },
  "rules": {
    "private-type-leaks": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error"
  },
  "duplicates": {
    "mode": "semantic",
    "near": true,
    "minLines": 8,
    "minTokens": 60,
    "minOccurrences": 2,
    "ignoreImports": true,
    "threshold": 11
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60,
    "coverage": "coverage/coverage-final.json"
  },
  "audit": {
    "gate": "all",
    "typeAware": true
  },
  "boundaries": {
    "zones": [
      {
        "name": "backend",
        "patterns": [
          "convex/**"
        ]
      },
      {
        "name": "app",
        "patterns": [
          "src/app/**"
        ]
      },
      {
        "name": "components",
        "patterns": [
          "src/components/**"
        ]
      },
      {
        "name": "lib",
        "patterns": [
          "src/lib/**"
        ]
      },
      {
        "name": "i18n",
        "patterns": [
          "src/i18n/**"
        ]
      }
    ],
    "rules": [
      {
        "from": "backend",
        "allow": []
      },
      {
        "from": "app",
        "allow": [
          "components",
          "lib",
          "i18n"
        ]
      },
      {
        "from": "components",
        "allow": [
          "lib",
          "i18n"
        ]
      },
      {
        "from": "lib",
        "allow": [
          "i18n"
        ]
      },
      {
        "from": "i18n",
        "allow": []
      }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "global.d.ts",
        "next.config.ts",
        "oxlint.config.ts",
        "postcss.config.mjs",
        "vitest.config.ts",
        "vitest.setup.ts"
      ]
    }
  }
}
