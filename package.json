{
  "name": "chronotunes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "just lint",
    "test": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage",
    "next:typegen": "tsc -p tsconfig.json --noEmit",
    "convex:typegen": "convex codegen --url http://127.0.0.1:3210 2>/dev/null || true",
    "convex:dev": "convex dev --local",
    "check": "oxlint . && oxfmt --check .",
    "fix": "oxlint --fix . && oxfmt .",
    "fallow": "fallow",
    "fallow:config": "fallow config",
    "fallow:recommend": "fallow recommend",
    "fallow:status": "fallow type-aware status",
    "fallow:dead-code": "fallow dead-code --type-aware",
    "fallow:dupes": "fallow dupes --mode semantic --near",
    "fallow:health": "fallow health --type-aware --coverage coverage/coverage-final.json --coverage-root \"$PWD\"",
    "fallow:audit": "fallow audit --gate new-only --type-aware",
    "fallow:security": "fallow security",
    "fallow:suppressions": "fallow suppressions",
    "fallow:ci": "fallow audit --gate new-only --type-aware --coverage coverage/coverage-final.json --coverage-root \"$PWD\"",
    "fallow:fix:preview": "fallow fix --type-aware --dry-run",
    "fallow:fix": "fallow fix --type-aware"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@convex-dev/presence": "0.4.0",
    "@daypicker/react": "10.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "convex": "1.44.0",
    "convex-helpers": "0.1.123",
    "embla-carousel-react": "8.6.0",
    "fluid-tailwindcss": "1.1.7",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "next-intl": "4.13.7",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-player": "3.4.0",
    "react-resizable-panels": "4.12.3",
    "recharts": "3.10.1",
    "scrape-yt": "1.4.8",
    "shadcn": "4.18.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "usehooks-ts": "3.1.1",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "convex-test": "0.0.55",
    "fallow": "3.17.0",
    "jsdom": "30.0.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "scrape-youtube": "2.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.22.0"
}
