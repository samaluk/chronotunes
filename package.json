{
  "name": "chronotunes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "just lint",
    "test": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "test:ui": "vitest --ui --coverage",
    "next:typegen": "tsc -p tsconfig.json --noEmit",
    "convex:typegen": "convex codegen --url http://127.0.0.1:3210 2>/dev/null || true",
    "convex:dev": "convex dev --local",
    "prepare": "lefthook install",
    "check": "node scripts/oxlint-ledger.mjs check && oxfmt --check .",
    "fix": "oxlint --fix . && oxfmt .",
    "lint:ledger:update": "node scripts/oxlint-ledger.mjs update"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@convex-dev/presence": "0.3.2",
    "@daypicker/react": "10.0.1",
    "@uidotdev/usehooks": "2.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "convex": "1.42.1",
    "convex-helpers": "0.1.120",
    "embla-carousel-react": "8.6.0",
    "fluid-tailwindcss": "1.1.7",
    "input-otp": "1.4.2",
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "next-intl": "4.13.2",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-player": "3.4.0",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.9.2",
    "scrape-yt": "1.4.8",
    "shadcn": "4.13.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "usehooks-ts": "3.1.1",
    "vaul": "1.1.2",
    "youtube-sr": "4.3.12",
    "yt-search": "2.13.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "convex-test": "0.0.54",
    "eslint-plugin-github": "6.1.1",
    "eslint-plugin-sonarjs": "4.1.0",
    "jsdom": "29.1.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-plugin-react-doctor": "0.7.6",
    "scrape-youtube": "2.4.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "ultracite": "7.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.11.0"
}
