{
  "name": "chronotunes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "just lint",
    "test": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "test:ui": "vitest --ui --coverage",
    "next:typegen": "tsc -p tsconfig.json --noEmit",
    "convex:typegen": "convex codegen --url http://127.0.0.1:3210 2>/dev/null || true",
    "convex:dev": "convex dev --local",
    "prepare": "lefthook install",
    "check": "oxlint . && oxfmt --check .",
    "fix": "oxlint --fix . && oxfmt .",
    "fallow": "fallow",
    "fallow:status": "fallow type-aware status",
    "fallow:dead-code": "fallow dead-code --baseline fallow-baselines/dead-code.json --fail-on-issues",
    "fallow:dupes": "fallow dupes --baseline fallow-baselines/dupes.json --fail-on-issues",
    "fallow:health": "fallow health --baseline fallow-baselines/health.json --baseline-mode identity --fail-on-issues",
    "fallow:audit": "fallow audit --gate new-only --dead-code-baseline fallow-baselines/dead-code.json --health-baseline fallow-baselines/health.json --dupes-baseline fallow-baselines/dupes.json",
    "fallow:regression": "node scripts/fallow-regression-check.mjs",
    "fallow:ci": "node scripts/fallow-ci.mjs",
    "fallow:baseline:update": "node scripts/fallow-baseline-update.mjs",
    "fallow:baseline:check": "node scripts/fallow-baseline-check.mjs",
    "fallow:fix:preview": "fallow fix --type-aware --dry-run",
    "fallow:fix": "fallow fix --type-aware"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@convex-dev/presence": "0.4.0",
    "@daypicker/react": "10.0.1",
    "@uidotdev/usehooks": "2.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "convex": "1.43.0",
    "convex-helpers": "0.1.121",
    "embla-carousel-react": "8.6.0",
    "fluid-tailwindcss": "1.1.7",
    "input-otp": "1.4.2",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "next-intl": "4.13.4",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-player": "3.4.0",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.10.1",
    "scrape-yt": "1.4.8",
    "shadcn": "4.16.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "usehooks-ts": "3.1.1",
    "vaul": "1.1.2",
    "youtube-sr": "4.3.12",
    "yt-search": "2.13.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "convex-test": "0.0.54",
    "fallow": "3.14.0",
    "jsdom": "30.0.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "scrape-youtube": "2.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.19.0"
}
