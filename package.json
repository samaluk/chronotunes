{
  "name": "chronotunes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "just lint",
    "test": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage",
    "next:typegen": "tsc -p tsconfig.json --noEmit",
    "convex:typegen": "convex codegen --url http://127.0.0.1:3210 2>/dev/null || true",
    "convex:dev": "convex dev --local",
    "check": "oxlint . && oxfmt --check .",
    "fix": "oxlint --fix . && oxfmt .",
    "fallow": "fallow",
    "fallow:staged": "git diff --cached | fallow audit --diff-stdin --gate all --type-aware",
    "fallow:audit": "fallow audit --gate all --type-aware --coverage coverage/coverage-final.json --coverage-root \"$PWD\" --dupes-mode semantic --dupes-near --dupes-ignore-imports",
    "fallow:full": "pnpm fallow:audit && pnpm fallow:dead-code && pnpm fallow:dupes && pnpm fallow:health",
    "fallow:config": "fallow config",
    "fallow:recommend": "fallow recommend",
    "fallow:status": "fallow type-aware status",
    "fallow:dead-code": "fallow dead-code --type-aware --fail-on-issues",
    "fallow:dupes": "fallow dupes --mode semantic --near --threshold 5e-324 --fail-on-issues",
    "fallow:health": "fallow health --type-aware --coverage coverage/coverage-final.json --coverage-root \"$PWD\" --fail-on-issues",
    "fallow:security": "fallow security",
    "fallow:suppressions": "fallow suppressions",
    "fallow:fix:preview": "fallow fix --type-aware --dry-run",
    "fallow:fix": "fallow fix --type-aware",
    "react-doctor": "react-doctor --verbose",
    "react-doctor:staged": "react-doctor --staged --yes --no-score --blocking warning",
    "react-doctor:changed": "react-doctor --scope changed --base origin/master --yes --no-score --blocking warning",
    "react-doctor:full": "react-doctor --scope full --yes --no-score --blocking warning",
    "fallow:ci": "pnpm fallow:full"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@convex-dev/presence": "0.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.45.0",
    "convex-helpers": "0.1.123",
    "fluid-tailwindcss": "1.1.7",
    "input-otp": "1.5.0",
    "lucide-react": "1.34.0",
    "next": "16.3.2",
    "next-intl": "4.13.7",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-player": "3.4.0",
    "scrape-yt": "1.4.8",
    "shadcn": "4.19.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "convex-test": "0.0.56",
    "fallow": "3.17.0",
    "jsdom": "30.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-doctor": "0.9.12",
    "scrape-youtube": "2.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.23.0"
}
