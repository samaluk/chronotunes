) {\n00221|       throw new ConvexError(\"No current round in this game\");\n00222|     }\n00223| \n00224|     const round = await ctx.db.get(game.currentRoundId);\n00225| \n00226|     if (!round) {\n00227|       throw new ConvexError(\"Round not found\");\n00228|     }\n00229| \n00230|     if (round.phase !== \"betting\") {\n00231|       throw new ConvexError(\"Can only resolve round during betting phase\");\n00232|     }\n00233| \n00234|     if (!round.placement) {\n00235|       throw new ConvexError(\"Round placement has not been submitted\");\n00236|     }\n00237| \n00238|     const track = await ctx.db.get(round.trackId);\n00239| \n00240|     if (!track) {\n00241|       throw new ConvexError(\"Track not found\");\n00242|     }\n00243| \n00244|     const turnPlayer = await ctx.db.get(round.turnPlayerId);\n00245| \n00246|     if (!turnPlayer) {\n00247|       throw new ConvexError(\"Turn player not found\");\n00248|     }\n00249| \n00250|     const validRange = computeValidIndexRange(turnPlayer.timeline, track.year);\n00251|     const turnPlayerWasCorrect = isPlacementCorrect(round.placement.proposedIndex, validRange);\n00252| \n00253|     const allBets = await ctx.db\n00254|       .query(\"roundBets\")\n00255|       .withIndex(\"by_round\", (q) => q.eq(\"roundId\", round._id))\n00256|       .collect();\n00257| \n00258|     const lockedBets = allBets.filter((bet) => bet.lockedIn);\n00259| \n00260|     const coinDeltas: { playerId: Id<\"players\">; delta: number }[] = [];\n00261|     const awardedPlayerIds: Id<\"players\">[] = [];\n00262| \n00263|     const timelineUpdates: Map<\n00264|       Id<\"players\">,\n00265|       { newTimeline: TimelineEntry[]; newTimelineSize: number }\n00266|     > = new Map();\n00267| \n00268|     for (const player of await ctx.db\n00269|       .query(\"players\")\n00270|       .filter((q) => q.eq(q.field(\"lobbyId\"), lobbyId))\n00271|       .collect()) {\n00272|       timelineUpdates.set(player._id, {\n00273|         newTimeline: [...player.timeline],\n00274|         newTimelineSize: player.timelineSize,\n00275|       });\n00276|     }\n00277| \n00278|     if (turnPlayerWasCorrect) {\n00279|       const turnPlayerUpdate = timelineUpdates.get(turnPlayer._id)!;\n00280|       turnPlayerUpdate.newTimeline.splice(round.placement.proposedIndex, 0, {\n00281|         trackId: track._id,\n00282|         year: track.year,\n00283|         earnedAtRoundNumber: round.roundNumber,\n00284|         earnedBy: \"placement\",\n00285|       });\n00286|       turnPlayerUpdate.newTimelineSize += 1;\n00287|       awardedPlayerIds.push(turnPlayer._id);\n00288|     }\n00289| \n00290|     for (const bet of lockedBets) {\n00291|       const bettor = await ctx.db.get(bet.playerId);\n00292| \n00293|       if (!bettor) {\n00294|         continue;\n00295|       }\n00296| \n00297|       const bettorWasCorrect = isPlacementCorrect(bet.proposedIndex, validRange);\n00298| \n00299|       if (turnPlayerWasCorrect) {\n00300|         coinDeltas.push({ playerId: bettor._id, delta: 0 });\n00301|         await ctx.db.patch(bet._id, { status: \"lost\" });\n00302|       } else if (bettorWasCorrect) {\n00303|         const bettorUpdate = timelineUpdates.get(bettor._id)!;\n00304|         bettorUpdate.newTimeline.splice(bet.proposedIndex, 0, {\n00305|           trackId: track._id,\n00306|           year: track.year,\n00307|           earnedAtRoundNumber: round.roundNumber,\n00308|           earnedBy: \"bet\",\n00309|         });\n00310|         bettorUpdate.newTimelineSize += 1;\n00311|         awardedPlayerIds.push(bettor._id);\n00312|         coinDeltas.push({ playerId: bettor._id, delta: 0 });\n00313|         await ctx.db.patch(bet._id, { status: \"won\" });\n00314|       } else {\n00315|         coinDeltas.push({ playerId: bettor._id, delta: 0 });\n00316|         await ctx.db.patch(bet._id, { status: \"lost\" });\n00317|       }\n00318|     }\n00319| \n00320|     for (const [playerId, update] of timelineUpdates) {\n00321|       await ctx.db.patch(playerId, {\n00322|         timeline: update.newTimeline,\n00323|         timelineSize: update.newTimelineSize,\n00324|       });\n00325|     }\n00326| \n00327|     await ctx.db.patch(round._id, {\n00328|       phase: \"resolved\",\n00329|       resolution: {\n00330|         validIndexMin: validRange.min,\n00331|         validIndexMax: validRange.max,\n00332|         turnPlayerWasCorrect,\n00333|         awardedPlayerIds,\n00334|         coinDeltas,\n00335|         resolvedAt: Date.now(),\n00336|       },\n00337|     });\n00338| \n00339|     const targetTimelineSize = lobby.settings.targetTimelineSize;\n00340| \n00341|     const winner = Array.from(timelineUpdates.entries()).find(\n00342|       ([, update]) => update.newTimelineSize >= targetTimelineSize,\n00343|     );\n00344| \n00345|     if (winner) {\n00346|       await ctx.db.patch(game._id, {\n00347|         status: \"finished\",\n00348|         endedAt: Date.now(),\n00349|         winnerPlayerId: winner[0],\n00350|       });\n00351| \n00352|       await ctx.db.patch(lobbyId, {\n00353|         status: \"finished\",\n00354|       });\n00355| \n00356|       return {\n00357|         gameEnded: true,\n00358|         winnerPlayerId: winner[0],\n00359|         nextRoundId: null,\n00360|         nextTurnPlayerId: null,\n00361|       };\n00362|     }\n00363| \n00364|     const currentTurnIndex = game.turnOrder.indexOf(game.turnPlayerId!);\n00365|     const nextTurnIndex = (currentTurnIndex + 1) % game.turnOrder.length;\n00366|     const nextTurnPlayerId = game.turnOrder[nextTurnIndex]!;\n00367| \n00368|     const nextRoundNumber = game.currentRoundNumber + 1;\n00369|     const selectedTrack = await selectTrackForRound(ctx, {\n00370|       gameId: game._id,\n00371|       minYear: lobby.settings.minYear,\n00372|       maxYear: lobby.settings.maxYear,\n00373|     });\n00374| \n00375|     if (!selectedTrack) {\n00376|       await ctx.db.patch(game._id, {\n00377|         status: \"finished\",\n00378|         endedAt: Date.now(),\n00379|       });\n00380| \n00381|       await ctx.db.patch(lobbyId, {\n00382|         status: \"finished\",\n00383|       });\n00384| \n00385|       return {\n00386|         gameEnded: true,\n00387|         winnerPlayerId: null,\n00388|         nextRoundId: null,\n00389|         nextTurnPlayerId: null,\n00390|         noTracksAvailable: true,\n00391|       };\n00392|     }\n00393| \n00394|     const nextRoundId = await ctx.db.insert(\"rounds\", {\n00395|       gameId: game._id,\n00396|       roundNumber: nextRoundNumber,\n00397|       turnPlayerId: nextTurnPlayerId,\n00398|       trackId: selectedTrack.trackId,\n00399|       phase: \"placing\",\n00400|       startedAt: Date.now(),\n00401|     });\n00402| \n00403|     await ctx.db.patch(game._id, {\n00404|       currentRoundNumber: nextRoundNumber,\n00405|       currentRoundId: nextRoundId,\n00406|       turnPlayerId: nextTurnPlayerId,\n00407|     });\n00408| \n00409|     return {\n00410|       gameEnded: false,\n00411|       winnerPlayerId: null,\n00412|       nextRoundId,\n00413|       nextTurnPlayerId,\n00414|     };\n00415|   },\n00416| });\n00417| \n\n(End of file - total 417 lines)\n</file>","title":"convex/games.ts","metadata":{"preview":"import { ConvexError, v } from \"convex/values\";\nimport type { Id } from \"./_generated/dataModel\";\nimport { mutation, query } from \"./_generated/server\";\nimport { computeValidIndexRange, isPlacementCorrect, type TimelineEntry } from \"./lib/gameLogic\";\nimport { selectTrackForRound } from \"./lib/trackSelection\";\n\nfunction shuffleArray<T>(array: readonly T[]): T[] {\n  const shuffled = [...array];\n  for (let i = shuffled.length - 1; i >= 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    const temp = shuffled[i]!;\n    shuffled[i] = shuffled[j]!;\n    shuffled[j] = temp;\n  }\n  return shuffled;\n}\n\nexport const start = mutation({\n  args: { lobbyId: v.id(\"lobbies\"), sessionId: v.string() },\n  handler: async (ctx, args) => 