{"type":"tool_use","timestamp":1768792519715,"sessionID":"ses_42bc86cacffeJdOyLXyDxG3HPF","part":{"id":"prt_bd43ff416001SPlHrARvNDKSd6","sessionID":"ses_42bc86cacffeJdOyLXyDxG3HPF","messageID":"msg_bd43fde80001qzayObc2ApD0HG","type":"tool","callID":"call_function_949vsdgwu9qy_1","tool":"read","state":{"status":"completed","input":{"filePath":"/Users/smaluk/dev/personal/chronotunes/convex/hostDisconnect.ts"},"output":"<file>\n00001| import { Presence } from \"@convex-dev/presence\";\n00002| import { components } from \"./_generated/api\";\n00003| import { internalMutation } from \"./_generated/server\";\n00004| \n00005| const presenceComponent = new Presence(components.presence);\n00006| \n00007| const HEARTBEAT_TIMEOUT_MS = 10000;\n00008| const HOST_TRANSFER_DEADLINE_MS = 30000;\n00009| \n00010| export const checkHostDisconnect = internalMutation({\n00011|   args: {},\n00012|   handler: async (ctx) => {\n00013|     const now = Date.now();\n00014|     const cutoffTime = now - HEARTBEAT_TIMEOUT_MS;\n00015| \n00016|     const lobbies = await ctx.db\n00017|       .query(\"lobbies\")\n00018|       .filter((q) => q.or(q.eq(q.field(\"status\"), \"lobby\"), q.eq(q.field(\"status\"), \"in_game\")))\n00019|       .collect();\n00020| \n00021|     for (const lobby of lobbies) {\n00022|       if (lobby.hostTransferDeadline && lobby.hostTransferDeadline > now) {\n00023|         continue;\n00024|       }\n00025| \n00026|       const hostPresence = await presenceComponent.listUser(ctx, lobby.hostSessionId, false);\n00027| \n00028|       const isHostOnline =\n00029|         hostPresence.length > 0 &&\n00030|         (hostPresence[0] as { lastSeen?: number }).lastSeen !== undefined &&\n00031|         (hostPresence[0] as { lastSeen?: number }).lastSeen! > cutoffTime;\n00032| \n00033|       if (!isHostOnline) {\n00034|         const hostTransferDeadline = now + HOST_TRANSFER_DEADLINE_MS;\n00035| \n00036|         await ctx.db.patch(lobby._id, { hostTransferDeadline });\n00037| \n00038|         if (lobby.status === \"in_game\" && lobby.activeGameId) {\n00039|           const game = await ctx.db.get(lobby.activeGameId);\n00040|           if (game && game.status === \"active\") {\n00041|             await ctx.db.patch(game._id, { status: \"paused\" });\n00042|           }\n00043|         }\n00044|       }\n00045|     }\n00046|   },\n00047| });\n00048| \n00049| export const checkHostTransfer = internalMutation({\n00050|   args: {},\n00051|   handler: async (ctx) => {\n00052|     const now = Date.now();\n00053| \n00054|     const lobbies = await ctx.db\n00055|       .query(\"lobbies\")\n00056|       .filter((q) =>\n00057|         q.and(\n00058|           q.or(q.eq(q.field(\"status\"), \"lobby\"), q.eq(q.field(\"status\"), \"in_game\")),\n00059|           q.neq(q.field(\"hostTransferDeadline\"), undefined),\n00060|           q.lt(q.field(\"hostTransferDeadline\"), now),\n00061|         ),\n00062|       )\n00063|       .collect();\n00064| \n00065|     for (const lobby of lobbies) {\n00066|       const players = await ctx.db\n00067|         .query(\"players\")\n00068|         .filter((q) => q.eq(q.field(\"lobbyId\"), lobby._id))\n00069|         .collect();\n00070| \n00071|       const cutoffTime = now - HEARTBEAT_TIMEOUT_MS;\n00072| \n00073|       const onlinePlayers: typeof players = [];\n00074| \n00075|       for (const player of players) {\n00076|         const presence = await presenceComponent.listUser(ctx, player.sessionId, false);\n00077|         const isOnline =\n00078|           presence.length > 0 &&\n00079|           (presence[0] as { lastSeen?: number }).lastSeen !== undefined &&\n00080|           (presence[0] as { lastSeen?: number }).lastSeen! > cutoffTime;\n00081| \n00082|         if (isOnline) {\n00083|           onlinePlayers.push(player);\n00084|         }\n00085|       }\n00086| \n00087|       if (onlinePlayers.length === 0) {\n00088|         continue;\n00089|       }\n00090| \n00091|       const randomIndex = Math.floor(Math.random() * onlinePlayers.length);\n00092|       const newHost = onlinePlayers[randomIndex]!;\n00093| \n00094|       const oldHost = players.find((p) => p.isHost);\n00095| \n00096|       if (oldHost) {\n00097|         await ctx.db.patch(oldHost._id, { isHost: false });\n00098|       }\n00099| \n00100|       await ctx.db.patch(newHost._id, { isHost: true });\n00101|       await ctx.db.patch(lobby._id, {\n00102|         hostSessionId: newHost.sessionId,\n00103|         hostTransferDeadline: undefined,\n00104|       });\n00105| \n00106|       if (lobby.status === \"in_game\" && lobby.activeGameId) {\n00107|         const game = await ctx.db.get(lobby.activeGameId);\n00108|         if (game && game.status === \"paused\") {\n00109|           await ctx.db.patch(game._id, { status: \"active\" });\n00110|         }\n00111|       }\n00112|     }\n00113|   },\n00114| });\n00115| \n\n(End of file - total 115 lines)\n</file>","title":"convex/hostDisconnect.ts","metadata":{"preview":"import { Presence } from \"@convex-dev/presence\";\nimport { components } from \"./_generated/api\";\nimport { internalMutation } from \"./_generated/server\";\n\nconst presenceComponent = new Presence(components.presence);\n\nconst HEARTBEAT_TIMEOUT_MS = 10000;\nconst HOST_TRANSFER_DEADLINE_MS = 30000;\n\nexport const checkHostDisconnect = internalMutation({\n  args: {},\n  handler: async (ctx) => {\n    const now = Date.now();\n    const cutoffTime = now - HEARTBEAT_TIMEOUT_MS;\n\n    const lobbies = await ctx.db\n      .query(\"lobbies\")\n      .filter((q) => q.or(q.eq(q.field(\"status\"), \"lobby\"), q.eq(q.field(\"status\"), \"in_game\")))\n      .collect();\n","truncated":false},"time":{"start":1768792519713,"end":1768792519714}}}}
