tive/20\",\n            this.props.className,\n          )}\n        >\n          <div className=\"flex items-center gap-3 mb-4\">\n            <div className=\"flex h-10 w-10 items-center justify-center rounded-full bg-destructive/10\">\n              <AlertCircle className=\"h-5 w-5 text-destructive\" />\n            </div>\n            <h2 className=\"text-lg font-semibold\">Something went wrong</h2>\n          </div>\n          <p className=\"text-sm text-muted-foreground text-center max-w-md mb-4\">\n            An unexpected error occurred. Please try again or refresh the page.\n          </p>\n          <Button onClick={this.handleRetry} variant=\"outline\">\n            <RefreshCw className=\"h-4 w-4 mr-2\" />\n            Try Again\n          </Button>\n        </div>\n      );\n    }\n\n    return this.props.children;\n  }\n}\n\ninterface AsyncErrorBoundaryState {\n  hasError: boolean;\n  error: Error | null;\n}\n\ninterface AsyncErrorBoundaryProps {\n  children: ReactNode;\n  fallback?: (error: Error, retry: () => void) => ReactNode;\n  className?: string;\n}\n\nexport function AsyncErrorBoundary({\n  children,\n  fallback,\n  className,\n}: AsyncErrorBoundaryProps): React.ReactNode {\n  const [state, setState] = React.useState<AsyncErrorBoundaryState>({\n    hasError: false,\n    error: null,\n  });\n\n  const handleRetry = (): void => {\n    setState({ hasError: false, error: null });\n  };\n\n  if (state.hasError && state.error) {\n    if (fallback) {\n      return fallback(state.error, handleRetry);\n    }\n\n    return (\n      <div\n        className={cn(\n          \"flex flex-col items-center justify-center min-h-[200px] p-6 rounded-xl bg-card border border-destructive/20\",\n          className,\n        )}\n      >\n        <div className=\"flex items-center gap-3 mb-4\">\n          <div className=\"flex h-10 w-10 items-center justify-center rounded-full bg-destructive/10\">\n            <AlertCircle className=\"h-5 w-5 text-destructive\" />\n          </div>\n          <h2 className=\"text-lg font-semibold\">Something went wrong</h2>\n        </div>\n        <p className=\"text-sm text-muted-foreground text-center max-w-md mb-4\">\n          {state.error.message || \"An unexpected error occurred.\"}\n        </p>\n        <Button onClick={handleRetry} variant=\"outline\">\n          <RefreshCw className=\"h-4 w-4 mr-2\" />\n          Try Again\n        </Button>\n      </div>\n    );\n  }\n\n  return <>{children}</>;\n}\n","filePath":"/Users/smaluk/dev/personal/chronotunes/src/components/ui/error-boundary.tsx"},"output":"Wrote file successfully.\n\nLSP errors detected in other files:\n<diagnostics file=\"/Users/smaluk/dev/personal/chronotunes/src/components/lobby/SettingsPanel.tsx\">\nERROR [64:9] Object literal may only specify known properties, and 'lobbyId' does not exist in type '{ code: string; settings: { targetTimelineSize: number; startingCoins: number; turnSeconds: number; bettingWindowSeconds: number; allowGuessTitleArtist: boolean; showLiveBets: boolean; allowBetRetraction: boolean; minYear: number; maxYear: number; }; sessionId: string; }'.\n</diagnostics>\n\nLSP errors detected in other files:\n<diagnostics file=\"/Users/smaluk/dev/personal/chronotunes/src/app/providers.tsx\">\nERROR [18:7] Object literal may only specify known properties, and 'onWillRefreshAuthTokens' does not exist in type 'ConvexReactClientOptions'.\n</diagnostics>","title":"src/components/ui/error-boundary.tsx","metadata":{"diagnostics":{"/Users/smaluk/dev/personal/chronotunes/package.json":[],"/Users/smaluk/dev/personal/chronotunes/src/app/page.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/app/layout.tsx":[{"code":"lint/correctness/noUnusedFunctionParameters","codeDescription":{"href":"https://biomejs.dev/linter/rules/no-unused-function-parameters"},"message":"This parameter is unused.","range":{"end":{"character":10,"line":3},"start":{"character":2,"line":3}},"severity":2,"source":"biome"},{"range":{"start":{"line