 GenericId<\"players\">[];\n00048|     coinDeltas: Array<{\n00049|       playerId: GenericId<\"players\">;\n00050|       delta: number;\n00051|     }>;\n00052|     resolvedAt: number;\n00053|   } | null;\n00054| }\n00055| \n00056| export function CurrentRoundPanel({\n00057|   phase,\n00058|   isMyTurn,\n00059|   lobbyId,\n00060|   me,\n00061|   players,\n00062|   track,\n00063|   existingPreviewIndex,\n00064|   turnPlayerTimeline,\n00065|   turnPlayerTimelineSize,\n00066|   resolution,\n00067| }: CurrentRoundPanelProps): React.ReactNode {\n00068|   const renderPhaseContent = (): React.ReactNode => {\n00069|     switch (phase) {\n00070|       case \"placing\":\n00071|         if (isMyTurn && lobbyId && me && track) {\n00072|           return (\n00073|             <TimelinePlacer\n00074|               lobbyId={lobbyId}\n00075|               player={me}\n00076|               currentTrack={track}\n00077|               existingPreviewIndex={existingPreviewIndex ?? null}\n00078|             />\n00079|           );\n00080|         }\n00081|         return (\n00082|           <div className=\"flex flex-col items-center justify-center py-12 space-y-4\">\n00083|             <div className=\"flex h-16 w-16 items-center justify-center rounded-full bg-primary/10\">\n00084|               <Music className=\"h-8 w-8 text-primary animate-pulse\" />\n00085|             </div>\n00086|             <div className=\"text-center space-y-2\">\n00087|               <p className=\"text-lg font-medium\">\n00088|                 {isMyTurn ? \"Place the song on your timeline\" : \"Player is placing the song...\"}\n00089|               </p>\n00090|               <p className=\"text-sm text-muted-foreground\">\n00091|                 {isMyTurn\n00092|                   ? \"Drag and drop the song card to the correct position\"\n00093|                   : \"Wait for the player to finish placing\"}\n00094|               </p>\n00095|             </div>\n00096|           </div>\n00097|         );\n00098| \n00099|       case \"betting\":\n00100|         if (lobbyId && me && track && !isMyTurn) {\n00101|           return (\n00102|             <BettingPanel\n00103|               lobbyId={lobbyId}\n00104|               me={me}\n00105|               track={track}\n00106|               turnPlayerTimeline={turnPlayerTimeline ?? []}\n00107|               turnPlayerTimelineSize={turnPlayerTimelineSize ?? 0}\n00108|             />\n00109|           );\n00110|         }\n00111|         return (\n00112|           <div className=\"flex flex-col items-center justify-center py-12 space-y-4\">\n00113|             <div className=\"flex h-16 w-16 items-center justify-center rounded-full bg-amber-100 dark:bg-amber-900/30\">\n00114|               <Music className=\"h-8 w-8 text-amber-600 dark:text-amber-400\" />\n00115|             </div>\n00116|             <div className=\"text-center space-y-2\">\n00117|               <p className=\"text-lg font-medium\">Place your bet!</p>\n00118|               <p className=\"text-sm text-muted-foreground\">\n00119|                 Where should the song go on the timeline?\n00120|               </p>\n00121|             </div>\n00122|           </div>\n00123|         );\n00124| \n00125|       case \"resolved\":\n00126|         if (lobbyId && track && resolution && players) {\n00127|           const turnPlayer = players.find((p) => p._id === resolution.awardedPlayerIds[0]) ?? {\n00128|             _id: \"\" as GenericId<\"players\">,\n00129|             displayName: \"Unknown\",\n00130|             timeline: [],\n00131|             timelineSize: 0,\n00132|             coins: 0,\n00133|             isHost: false,\n00134|             sessionId: \"\",\n00135|           };\n00136|           const _turnPlayerTimelineEntry = turnPlayerTimeline ?? [];\n00137|           const _turnPlayerTimelineSizeValue = turnPlayerTimelineSize ?? 0;\n00138| \n00139|           return (\n00140|             <RoundResults\n00141|               lobbyId={lobbyId}\n00142|               track={track}\n00143|               resolution={resolution}\n00144|               turnPlayer={turnPlayer}\n00145|               bets={[]}\n00146|               players={players}\n00147|               me={me ?? null}\n00148|             />\n00149|           );\n00150|         }\n00151|         return (\n00152|           <div className=\"flex flex-col items-center justify-center py-12 space-y-4\">\n00153|             <div className=\"flex h-16 w-16 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/30\">\n00154|               <Music className=\"h-8 w-8 text-green-600 dark:text-green-400\" />\n00155|             </div>\n00156|             <div className=\"text-center space-y-2\">\n00157|               <p className=\"text-lg font-medium\">Round Results</p>\n00158|               <p className=\"text-sm text-muted-foreground\">\n00159|                 The song has been revealed and results are in!\n00160|               </p>\n00161|             </div>\n00162|             {track && (\n00163|               <div className=\"mt-4 p-4 rounded-lg bg-card border max-w-md w-full text-center\">\n00164|                 <p className=\"text-sm text-muted-foreground\">The song was</p>\n00165|                 <p className=\"text-xl font-bold mt-1\">\n00166|                   {track.title} - {track.artist} ({track.year})\n00167|                 </p>\n00168|               </div>\n00169|             )}\n00170|           </div>\n00171|         );\n00172| \n00173|       default:\n00174|         return (\n00175|           <div className=\"flex flex-col items-center justify-center py-12\">\n00176|             <p className=\"text-muted-foreground\">Waiting for round to start...</p>\n00177|           </div>\n00178|         );\n00179|     }\n00180|   };\n00181| \n00182|   return (\n00183|     <div className=\"w-full\">\n00184|       <div className=\"rounded-xl bg-card border overflow-hidden\">\n00185|         <div className=\"px-4 py-3 border-b bg-muted/50\">\n00186|           <div className=\"flex items-center justify-between\">\n00187|             <span className=\"text-sm font-medium\">Current Round</span>\n00188|             <span\n00189|               className={`\n00190|                 inline-flex items-center px-2 py-1 rounded-full text-xs font-medium\n00191|                 ${\n00192|                   phase === \"placing\"\n00193|                     ? \"bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400\"\n00194|                     : phase === \"betting\"\n00195|                       ? \"bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400\"\n00196|                       : \"bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400\"\n00197|                 }\n00198|               `}\n00199|             >\n00200|               {phase.charAt(0).toUpperCase() + phase.slice(1)}\n00201|             </span>\n00202|           </div>\n00203|         </div>\n00204|         <div className=\"p-6\">{renderPhaseContent()}</div>\n00205|       </div>\n00206|     </div>\n00207|   );\n00208| }\n00209| \n\n(End of file - total 209 lines)\n</file>","title":"src/components/game/CurrentRoundPanel.tsx","metadata":{"preview":"\"use client\";\n\nimport type { GenericId } from \"convex/values\";\nimport { Music } from \"lucide-react\";\nimport { BettingPanel } from \"./BettingPanel\";\nimport { RoundResults } from \"./RoundResults\";\nimport { TimelinePlacer } from \"./TimelinePlacer\";\n\nexport type RoundPhase = \"placing\" | \"betting\" | \"resolved\";\n\ninterface TimelineEntry {\n  trackId: GenericId<\"tracks\">;\n  year: number;\n  earnedAtRoundNumber: number;\n  earnedBy: \"placement\" | \"bet\";\n}\n\ninterface Player {\n  _id: GenericId<\"players\">;\n  displayName: string;","truncated":false},"time":{"start":1768790161001,"end":1768790161002}}}}
