{"type":"tool_use","timestamp":1768790192082,"sessionID":"ses_42be52c35ffeA2x5zclllX64lp","part":{"id":"prt_bd41c48510011zbnOwwtZrKRMJ","sessionID":"ses_42be52c35ffeA2x5zclllX64lp","messageID":"msg_bd41c39a0001fdQhP2T3O0lkmz","type":"tool","callID":"call_function_mf4z1w0kseug_1","tool":"write","state":{"status":"completed","input":{"content":"\"use client\";\n\nimport { Timer, AlertTriangle } from \"lucide-react\";\nimport { useEffect, useState } from \"react\";\nimport { Progress, ProgressTrack, ProgressIndicator } from \"@/components/ui/progress\";\n\ninterface SoftTimerProps {\n  startedAt: number;\n  turnSeconds: number;\n  lowTimeThreshold?: number;\n  showProgress?: boolean;\n  className?: string;\n}\n\nexport function SoftTimer({\n  startedAt,\n  turnSeconds,\n  lowTimeThreshold = 10,\n  showProgress = true,\n  className,\n}: SoftTimerProps): React.ReactNode {\n  const [timeRemaining, setTimeRemaining] = useState<number | null>(null);\n\n  useEffect(() => {\n    const calculateTimeRemaining = (): number => {\n      const elapsed = (Date.now() - startedAt) / 1000;\n      const remaining = turnSeconds - elapsed;\n      return remaining;\n    };\n\n    setTimeRemaining(calculateTimeRemaining());\n\n    const interval = setInterval(() => {\n      const remaining = calculateTimeRemaining();\n      setTimeRemaining(remaining);\n    }, 100);\n\n    return () => clearInterval(interval);\n  }, [startedAt, turnSeconds]);\n\n  const formatTime = (seconds: number): string => {\n    const absSeconds = Math.abs(seconds);\n    const mins = Math.floor(absSeconds / 60);\n    const secs = Math.floor(absSeconds % 60);\n    const sign = seconds < 0 ? \"-\" : \"\";\n    return `${sign}${mins}:${secs.toString().padStart(2, \"0\")}`;\n  };\n\n  const isLowTime = timeRemaining !== null && timeRemaining <= lowTimeThreshold && timeRemaining > -60;\n  const isOverdue = timeRemaining !== null && timeRemaining <= -60;\n  const progressValue = timeRemaining !== null ? Math.max(0, Math.min(100, (timeRemaining / turnSeconds) * 100)) : null;\n\n  return (\n    <div className={className}>\n      <div\n        className={`\n          inline-flex items-center gap-2 px-4 py-2 rounded-lg font-mono text-lg\n          ${isLowTime && !isOverdue ? \"bg-destructive/10 text-destructive animate-pulse\" : \"\"}\n          ${isOverdue ? \"bg-muted text-muted-foreground\" : \"bg-muted\"}\n        `}\n      >\n        <Timer className={`h-5 w-5 ${isLowTime && !isOverdue ? \"animate-pulse\" : \"\"}`} />\n        <span>{timeRemaining !== null ? formatTime(timeRemaining) : \"--:--\"}</span>\n        {isLowTime && !isOverdue && <AlertTriangle className=\"h-4 w-4 animate-pulse\" />}\n      </div>\n      {showProgress && progressValue !== null && (\n        <div className=\"mt-2\">\n          <Progress value={progressValue} className=\"h-1.5\">\n            <ProgressTrack>\n              <ProgressIndicator\n                className={\n                  progressValue <= (lowTimeThreshold / turnSeconds) * 100\n                    ? \"bg-destructive animate-pulse\"\n                    : \"\"\n                }\n              />\n            </ProgressTrack>\n          </Progress>\n        </div>\n      )}\n    </div>\n  );\n}\n","filePath":"/Users/smaluk/dev/personal/chronotunes/src/components/game/SoftTimer.tsx"},"output":"Wrote file successfully.","title":"src/components/game/SoftTimer.tsx","metadata":{"diagnostics":{"/Users/smaluk/dev/personal/chronotunes/convex/schema.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/rounds.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/games.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/GameView.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/ui/progress.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/GameHeader.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/CurrentRoundPanel.tsx":[{"range":{"start":{"line":135,"character":16},"end":{"line":135,"character":40}},"message":"'_turnPlayerTimelineEntry' is declared but its value is never read.","severity":4,"code":6133,"source":"typescript"},{"range":{"start":{"line":136,"character":16},"end":{"line":136,"character":44}},"message":"'_turnPlayerTimelineSizeValue' is declared but its value is never read.","severity":4,"code":6133,"source":"typescript"}],"/Users/smaluk/dev/personal/chronotunes/src/components/game/BettingPanel.test.tsx":[],"/Users/smaluk/dev/personal/chronotunes/vitest.config.ts":[{"code":"lint/style/useNodejsImportProtocol","codeDescription":{"href":"https://biomejs.dev/linter/rules/use-nodejs-import-protocol"},"message":"A Node.js builtin module should be imported with the node: protocol.","range":{"end":{"character":23,"line":0},"start":{"character":17,"line":0}},"severity":3,"source":"biome"}],"/Users/smaluk/dev/personal/chronotunes/src/components/game/SoftTimer.tsx":[],"/Users/smaluk/dev/personal/chronotunes/package.json":[]},"filepath":"/Users/smaluk/dev/personal/chronotunes/src/components/game/SoftTimer.tsx","exists":false,"truncated":false},"time":{"start":1768790191355,"end":1768790192081}}}}
