{"type":"tool_use","timestamp":1768790312908,"sessionID":"ses_42be52c35ffeA2x5zclllX64lp","part":{"id":"prt_bd41e1df300190sK4e7vXL7UPe","sessionID":"ses_42be52c35ffeA2x5zclllX64lp","messageID":"msg_bd41e0d8f001QSZ0ywxIMbFdpy","type":"tool","callID":"call_function_ecdke2gwr4zj_1","tool":"write","state":{"status":"completed","input":{"content":"import { render, screen } from \"@testing-library/react\";\nimport { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";\nimport { SoftTimer } from \"./SoftTimer\";\n\ndescribe(\"SoftTimer\", () => {\n  beforeEach(() => {\n    vi.useFakeTimers();\n    vi.spyOn(Date, \"now\").mockImplementation(() => {\n      return 0;\n    });\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n    vi.restoreAllMocks();\n  });\n\n  it(\"displays time in MM:SS format\", () => {\n    const startedAt = Date.now() - 30 * 1000;\n\n    render(<SoftTimer startedAt={startedAt} turnSeconds={60} />);\n\n    expect(screen.getByText(/0:30/)).toBeInTheDocument();\n  });\n\n  it(\"shows warning styling when time is low\", () => {\n    const startedAt = Date.now() - 55 * 1000;\n\n    render(<SoftTimer startedAt={startedAt} turnSeconds={60} lowTimeThreshold={10} />);\n\n    expect(screen.getByText(/0:05/)).toBeInTheDocument();\n    const timerContainer = screen.getByText(/0:05/).closest(\"div\");\n    expect(timerContainer).toHaveClass(\"bg-destructive/10\");\n    expect(timerContainer).toHaveClass(\"text-destructive\");\n  });\n\n  it(\"shows overdue format when time exceeds duration\", () => {\n    const startedAt = Date.now() - 90 * 1000;\n\n    render(<SoftTimer startedAt={startedAt} turnSeconds={60} />);\n\n    expect(screen.getByText(/-1:30/)).toBeInTheDocument();\n  });\n\n  it(\"hides progress bar when showProgress is false\", () => {\n    const startedAt = Date.now() - 30 * 1000;\n\n    render(<SoftTimer startedAt={startedAt} turnSeconds={60} showProgress={false} />);\n\n    expect(screen.queryByRole(\"progressbar\")).not.toBeInTheDocument();\n  });\n\n  it(\"accepts custom lowTimeThreshold\", () => {\n    const startedAt = Date.now() - 15 * 1000;\n\n    render(\n      <SoftTimer startedAt={startedAt} turnSeconds={60} lowTimeThreshold={10} />,\n    );\n\n    expect(screen.getByText(/0:45/)).toBeInTheDocument();\n  });\n\n  it(\"applies custom className\", () => {\n    const startedAt = Date.now() - 30 * 1000;\n\n    render(<SoftTimer startedAt={startedAt} turnSeconds={60} className=\"custom-class\" />);\n\n    expect(screen.getByText(/0:30/).closest(\".custom-class\")).not.toBeNull();\n  });\n\n  it(\"shows --:-- when startedAt is 0\", () => {\n    render(<SoftTimer startedAt={0} turnSeconds={60} />);\n\n    expect(screen.getByText(\"--:--\")).toBeInTheDocument();\n  });\n\n  it(\"shows 0:00 when time remaining is exactly zero\", () => {\n    const startedAt = Date.now();\n\n    render(<SoftTimer startedAt={startedAt} turnSeconds={60} />);\n\n    expect(screen.getByText(\"0:00\")).toBeInTheDocument();\n  });\n\n  it(\"progress bar shows correct percentage\", () => {\n    const startedAt = Date.now() - 30 * 1000;\n\n    render(<SoftTimer startedAt={startedAt} turnSeconds={60} showProgress={true} />);\n\n    const progressBar = screen.getByRole(\"progressbar\");\n    expect(progressBar).toBeInTheDocument();\n  });\n});\n","filePath":"/Users/smaluk/dev/personal/chronotunes/src/components/game/SoftTimer.test.tsx"},"output":"Wrote file successfully.","title":"src/components/game/SoftTimer.test.tsx","metadata":{"diagnostics":{"/Users/smaluk/dev/personal/chronotunes/convex/schema.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/rounds.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/games.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/GameView.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/ui/progress.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/GameHeader.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/CurrentRoundPanel.tsx":[{"range":{"start":{"line":135,"character":16},"end":{"line":135,"character":40}},"message":"'_turnPlayerTimelineEntry' is declared but its value is never read.","severity":4,"code":6133,"source":"typescript"},{"range":{"start":{"line":136,"character":16},"end":{"line":136,"character":44}},"message":"'_turnPlayerTimelineSizeValue' is declared but its value is never read.","severity":4,"code":6133,"source":"typescript"}],"/Users/smaluk/dev/personal/chronotunes/src/components/game/BettingPanel.test.tsx":[],"/Users/smaluk/dev/personal/chronotunes/vitest.config.ts":[{"code":"lint/style/useNodejsImportProtocol","codeDescription":{"href":"https://biomejs.dev/linter/rules/use-nodejs-import-protocol"},"message":"A Node.js builtin module should be imported with the node: protocol.","range":{"end":{"character":23,"line":0},"start":{"character":17,"line":0}},"severity":3,"source":"biome"}],"/Users/smaluk/dev/personal/chronotunes/src/components/game/SoftTimer.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/SoftTimer.test.tsx":[],"/Users/smaluk/dev/personal/chronotunes/package.json":[]},"filepath":"/Users/smaluk/dev/personal/chronotunes/src/components/game/SoftTimer.test.tsx","exists":true,"truncated":false},"time":{"start":1768790312269,"end":1768790312907}}}}
