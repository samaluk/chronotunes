le,\n00048|           artist: track.artist,\n00049|           year: track.year,\n00050|           youtubeVideoId: track.externalIds.youtubeVideoId ?? \"\",\n00051|         };\n00052|       }\n00053|     } else {\n00054|       trackInfo = { trackId: round.trackId };\n00055|     }\n00056| \n00057|     return {\n00058|       _id: round._id,\n00059|       _creationTime: round._creationTime,\n00060|       gameId: round.gameId,\n00061|       roundNumber: round.roundNumber,\n00062|       turnPlayerId: round.turnPlayerId,\n00063|       phase: round.phase,\n00064|       startedAt: round.startedAt,\n00065|       placementPreview: round.placementPreview,\n00066|       placement: round.placement,\n00067|       guess: round.guess,\n00068|       resolution: round.resolution,\n00069|       track: trackInfo,\n00070|       isHost,\n00071|     };\n00072|   },\n00073| });\n00074| \n00075| export const setPlacementPreview = mutation({\n00076|   args: { lobbyId: v.id(\"lobbies\"), sessionId: v.string(), proposedIndex: v.number() },\n00077|   handler: async (ctx, args) => {\n00078|     const { lobbyId, sessionId, proposedIndex } = args;\n00079| \n00080|     const lobby = await ctx.db.get(lobbyId);\n00081| \n00082|     if (!lobby) {\n00083|       throw new ConvexError(\"Lobby not found\");\n00084|     }\n00085| \n00086|     if (!lobby.activeGameId) {\n00087|       throw new ConvexError(\"No active game in this lobby\");\n00088|     }\n00089| \n00090|     const game = await ctx.db.get(lobby.activeGameId);\n00091| \n00092|     if (!game) {\n00093|       throw new ConvexError(\"Game not found\");\n00094|     }\n00095| \n00096|     if (!game.currentRoundId) {\n00097|       throw new ConvexError(\"No current round in this game\");\n00098|     }\n00099| \n00100|     const round = await ctx.db.get(game.currentRoundId);\n00101| \n00102|     if (!round) {\n00103|       throw new ConvexError(\"Round not found\");\n00104|     }\n00105| \n00106|     if (round.phase !== \"placing\") {\n00107|       throw new ConvexError(\"Can only preview placement during placing phase\");\n00108|     }\n00109| \n00110|     const player = await ctx.db\n00111|       .query(\"players\")\n00112|       .filter((q) =>\n00113|         q.and(q.eq(q.field(\"lobbyId\"), lobbyId), q.eq(q.field(\"sessionId\"), sessionId)),\n00114|       )\n00115|       .first();\n00116| \n00117|     if (!player) {\n00118|       throw new ConvexError(\"Player not found in this lobby\");\n00119|     }\n00120| \n00121|     if (round.turnPlayerId !== player._id) {\n00122|       throw new ConvexError(\"Only the turn player can preview placement\");\n00123|     }\n00124| \n00125|     if (proposedIndex < 0) {\n00126|       throw new ConvexError(\"Proposed index cannot be negative\");\n00127|     }\n00128| \n00129|     await ctx.db.patch(round._id, {\n00130|       placementPreview: {\n00131|         proposedIndex,\n00132|         updatedAt: Date.now(),\n00133|       },\n00134|     });\n00135|   },\n00136| });\n00137| \n00138| export const submitPlacement = mutation({\n00139|   args: { lobbyId: v.id(\"lobbies\"), sessionId: v.string() },\n00140|   handler: async (ctx, args) => {\n00141|     const { lobbyId, sessionId } = args;\n00142| \n00143|     const lobby = await ctx.db.get(lobbyId);\n00144| \n00145|     if (!lobby) {\n00146|       throw new ConvexError(\"Lobby not found\");\n00147|     }\n00148| \n00149|     if (!lobby.activeGameId) {\n00150|       throw new ConvexError(\"No active game in this lobby\");\n00151|     }\n00152| \n00153|     const game = await ctx.db.get(lobby.activeGameId);\n00154| \n00155|     if (!game) {\n00156|       throw new ConvexError(\"Game not found\");\n00157|     }\n00158| \n00159|     if (!game.currentRoundId) {\n00160|       throw new ConvexError(\"No current round in this game\");\n00161|     }\n00162| \n00163|     const round = await ctx.db.get(game.currentRoundId);\n00164| \n00165|     if (!round) {\n00166|       throw new ConvexError(\"Round not found\");\n00167|     }\n00168| 