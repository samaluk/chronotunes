extRoundId,\n00678|       nextTurnPlayerId,\n00679|     };\n00680|   },\n00681| });\n00682| \n\n(End of file - total 682 lines)\n</file>","title":"convex/games.ts","metadata":{"preview":"import { ConvexError, v } from \"convex/values\";\nimport type { Id } from \"./_generated/dataModel\";\nimport { mutation, query } from \"./_generated/server\";\nimport { computeValidIndexRange, isPlacementCorrect, type TimelineEntry } from \"./lib/gameLogic\";\nimport { selectTrackForRound } from \"./lib/trackSelection\";\n\nfunction shuffleArray<T>(array: readonly T[]): T[] {\n  const shuffled = [...array];\n  for (let i = shuffled.length - 1; i >= 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    const temp = shuffled[i]!;\n    shuffled[i] = shuffled[j]!;\n    shuffled[j] = temp;\n  }\n  return shuffled;\n}\n\nexport const start = mutation({\n  args: { lobbyId: v.id(\"lobbies\"), sessionId: v.string() },\n  handler: async (ctx, args) => {","truncated":false},"time":{"start":1768792992519,"end":1768792992521}}}}
