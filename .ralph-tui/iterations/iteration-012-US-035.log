ndings sorted by timeline size\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByText(\"Final Standings\")).toBeInTheDocument();\n\n    const standings = screen.getAllByText(/songs collected/);\n    expect(standings).toHaveLength(3);\n  });\n\n  it(\"displays song history with years\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByText(\"Song History\")).toBeInTheDocument();\n    expect(screen.getByText(\"Bohemian Rhapsody\")).toBeInTheDocument();\n    expect(screen.getByText(\"Queen\")).toBeInTheDocument();\n    expect(screen.getByText(\"1975\")).toBeInTheDocument();\n    expect(screen.getByText(\"Stairway to Heaven\")).toBeInTheDocument();\n    expect(screen.getByText(\"Led Zeppelin\")).toBeInTheDocument();\n    expect(screen.getByText(\"1971\")).toBeInTheDocument();\n  });\n\n  it(\"has play again button\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByRole(\"button\", { name: /Play Again/i })).toBeInTheDocument();\n  });\n\n  it(\"shows game duration\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByText(/rounds played/i)).toBeInTheDocument();\n    expect(screen.getByText(\"5 rounds played\")).toBeInTheDocument();\n  });\n\n  it(\"highlights winner with trophy icon\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByTestId(\"trophy-icon\")).toBeInTheDocument();\n  });\n\n  it(\"shows current user with (You) indicator\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByText(\"(You)\")).toBeInTheDocument();\n  });\n\n  it(\"shows loading state when results are undefined\", () => {\n    vi.doMock(\"convex/react\", () => ({\n      useMutation: vi.fn(() => vi.fn()),\n      useQuery: vi.fn(() => undefined),\n    }));\n\n    const { GameResults: GameResultsLoading } = await import(\"./GameResults\");\n\n    render(<GameResultsLoading lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByText(\"Loading game results...\")).toBeInTheDocument();\n  });\n\n  it(\"shows empty state when no results found\", () => {\n    vi.doMock(\"convex/react\", () => ({\n      useMutation: vi.fn(() => vi.fn()),\n      useQuery: vi.fn(() => null),\n    }));\n\n    const { GameResults: GameResultsEmpty } = await import(\"./GameResults\");\n\n    render(<GameResultsEmpty lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByText(\"No game results found\")).toBeInTheDocument();\n  });\n\n  it(\"displays ranking numbers\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    const ranks = screen.getAllByText((content) => /^[123]$/.test(content));\n    expect(ranks).toHaveLength(3);\n  });\n\n  it(\"shows songs collected count for each player\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByText(\"5 songs collected\")).toBeInTheDocument();\n    expect(screen.getByText(\"4 songs collected\")).toBeInTheDocument();\n    expect(screen.getByText(\"3 songs collected\")).toBeInTheDocument();\n  });\n});\n","filePath":"/Users/smaluk/dev/personal/chronotunes/src/components/game/GameResults.test.tsx"},"output":"Wrote file successfully.\n\nLSP errors detected in other files:\n<diagnostics file=\"/Users/smaluk/dev/personal/chronotunes/src/components/lobby/SettingsPanel.tsx\">\nERROR [60:9] Object literal may only specify known properties, and 'lobbyId' does not exist in type '{ code: string; settings: { targetTimelineSize: number; startingCoins: number; turnSeconds: number; bettingWindowSeconds: number; allowGuessTitleArtist: boolean; showLiveBets: boolean; allowBetRetraction: boolean; minYear: number; maxYear: number; }; sessionId: string; }'.\n</diagnostics>\n\nLSP errors detected in this file, please fix:\n<diagnostics file=\"/Us