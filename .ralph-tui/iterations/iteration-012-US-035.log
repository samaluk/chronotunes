\" as GenericId<\"players\">,\n        },\n        players: [\n          {\n            _id: \"player1\" as GenericId<\"players\">,\n            displayName: \"WinnerPlayer\",\n            timelineSize: 5,\n            timeline: [],\n            coins: 3,\n            isHost: true,\n          },\n          {\n            _id: \"player2\" as GenericId<\"players\">,\n            displayName: \"SecondPlayer\",\n            timelineSize: 4,\n            timeline: [],\n            coins: 2,\n            isHost: false,\n          },\n          {\n            _id: \"player3\" as GenericId<\"players\">,\n            displayName: \"ThirdPlayer\",\n            timelineSize: 3,\n            timeline: [],\n            coins: 1,\n            isHost: false,\n          },\n        ],\n        rounds: [\n          {\n            _id: \"round1\" as GenericId<\"rounds\">,\n            roundNumber: 1,\n            trackId: \"track1\" as GenericId<\"tracks\">,\n            track: {\n              _id: \"track1\" as GenericId<\"tracks\">,\n              title: \"Bohemian Rhapsody\",\n              artist: \"Queen\",\n              year: 1975,\n            },\n            phase: \"resolved\",\n          },\n          {\n            _id: \"round2\" as GenericId<\"rounds\">,\n            roundNumber: 2,\n            trackId: \"track2\" as GenericId<\"tracks\">,\n            track: {\n              _id: \"track2\" as GenericId<\"tracks\">,\n              title: \"Stairway to Heaven\",\n              artist: \"Led Zeppelin\",\n              year: 1971,\n            },\n            phase: \"resolved\",\n          },\n          {\n            _id: \"round3\" as GenericId<\"rounds\">,\n            roundNumber: 3,\n            trackId: \"track3\" as GenericId<\"tracks\">,\n            track: {\n              _id: \"track3\" as GenericId<\"tracks\">,\n              title: \"Hotel California\",\n              artist: \"Eagles\",\n              year: 1977,\n            },\n            phase: \"resolved\",\n          },\n        ],\n      };\n    }\n\n    if (api === \"players/getMe\") {\n      return {\n        _id: \"player2\" as GenericId<\"players\">,\n        displayName: \"SecondPlayer\",\n        isHost: false,\n      };\n    }\n\n    return null;\n  }),\n}));\n\nvi.mock(\"@/lib/hooks/use-session-id\", () => ({\n  useSessionId: vi.fn(() => \"session123\"),\n}));\n\nvi.mock(\"react\", () => ({\n  useState: vi.fn((initial) => {\n    if (typeof initial === \"function\") {\n      return [initial(), vi.fn()];\n    }\n    return [initial, vi.fn()];\n  }),\n}));\n\nafterEach(() => {\n  cleanup();\n});\n\nconst mockLobbyId = \"lobby123\" as GenericId<\"lobbies\">;\n\ndescribe(\"GameResults\", () => {\n  it(\"displays game over header\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByText(\"Game Over!\")).toBeInTheDocument();\n    expect(screen.getByText(\"Congratulations to the winner\")).toBeInTheDocument();\n  });\n\n  it(\"displays winner prominently\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByText(\"Winner\")).toBeInTheDocument();\n    expect(screen.getByText(\"WinnerPlayer\")).toBeInTheDocument();\n  });\n\n  it(\"shows final standings sorted by timeline size\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByText(\"Final Standings\")).toBeInTheDocument();\n\n    const standings = screen.getAllByText(/songs collected/);\n    expect(standings).toHaveLength(3);\n\n    const positions = screen.getAllByRole(\"heading\", { level: 3 });\n    expect(positions[0]).toHaveTextContent(\"WinnerPlayer\");\n    expect(positions[1]).toHaveTextContent(\"SecondPlayer\");\n    expect(positions[2]).toHaveTextContent(\"ThirdPlayer\");\n  });\n\n  it(\"displays song history with years\", () => {\n    render(<GameResults lobbyId={mockLobbyId} code=\"ABC123\" />);\n\n    expect(screen.getByText(\"Song History\")