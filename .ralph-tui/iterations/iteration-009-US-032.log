x.db.patch(playerId, {\n00322|         timeline: update.newTimeline,\n00323|         timelineSize: update.newTimelineSize,\n00324|       });\n00325|     }\n00326| \n00327|     await ctx.db.patch(round._id, {\n00328|       phase: \"resolved\",\n00329|       resolution: {\n00330|         validIndexMin: validRange.min,\n00331|         validIndexMax: validRange.max,\n00332|         turnPlayerWasCorrect,\n00333|         awardedPlayerIds,\n00334|         coinDeltas,\n00335|         resolvedAt: Date.now(),\n00336|       },\n00337|     });\n00338| \n00339|     const targetTimelineSize = lobby.settings.targetTimelineSize;\n00340| \n00341|     const winner = Array.from(timelineUpdates.entries()).find(\n00342|       ([, update]) => update.newTimelineSize >= targetTimelineSize,\n00343|     );\n00344| \n00345|     if (winner) {\n00346|       await ctx.db.patch(game._id, {\n00347|         status: \"finished\",\n00348|         endedAt: Date.now(),\n00349|         winnerPlayerId: winner[0],\n00350|       });\n00351| \n00352|       await ctx.db.patch(lobbyId, {\n00353|         status: \"finished\",\n00354|       });\n00355| \n00356|       return {\n00357|         gameEnded: true,\n00358|         winnerPlayerId: winner[0],\n00359|         nextRoundId: null,\n00360|         nextTurnPlayerId: null,\n00361|       };\n00362|     }\n00363| \n00364|     const currentTurnIndex = game.turnOrder.indexOf(game.turnPlayerId!);\n00365|     const nextTurnIndex = (currentTurnIndex + 1) % game.turnOrder.length;\n00366|     const nextTurnPlayerId = game.turnOrder[nextTurnIndex]!;\n00367| \n00368|     const nextRoundNumber = game.currentRoundNumber + 1;\n00369|     const selectedTrack = await selectTrackForRound(ctx, {\n00370|       gameId: game._id,\n00371|       minYear: lobby.settings.minYear,\n00372|       maxYear: lobby.settings.maxYear,\n00373|     });\n00374| \n00375|     if (!selectedTrack) {\n00376|       await ctx.db.patch(game._id, {\n00377|         status: \"finished\",\n00378|         endedAt: Date.now(),\n00379|       });\n00380| \n00381|       await ctx.db.patch(lobbyId, {\n00382|         status: \"finished\",\n00383|       });\n00384| \n00385|       return {\n00386|         gameEnded: true,\n00387|         winnerPlayerId: null,\n00388|         nextRoundId: null,\n00389|         nextTurnPlayerId: null,\n00390|         noTracksAvailable: true,\n00391|       };\n00392|     }\n00393| \n00394|     const nextRoundId = await ctx.db.insert(\"rounds\", {\n00395|       gameId: game._id,\n00396|       roundNumber: nextRoundNumber,\n00397|       turnPlayerId: nextTurnPlayerId,\n00398|       trackId: selectedTrack.trackId,\n00399|       phase: \"placing\",\n00400|       startedAt: Date.now(),\n00401|     });\n00402| \n00403|     await ctx.db.patch(game._id, {\n00404|       currentRoundNumber: nextRoundNumber,\n00405|       currentRoundId: nextRoundId,\n00406|       turnPlayerId: nextTurnPlayerId,\n00407|     });\n00408| \n00409|     return {\n00410|       gameEnded: false,\n00411|       winnerPlayerId: null,\n00412|       nextRoundId,\n00413|       nextTurnPlayerId,\n00414|     };\n00415|   },\n00416| });\n00417| \n\n(End of file - total 417 lines)\n</file>","title":"convex/games.ts","metadata":{"preview":"import { ConvexError, v } from \"convex/values\";\nimport type { Id } from \"./_generated/dataModel\";\nimport { mutation, query } from \"./_generated/server\";\nimport { computeValidIndexRange, isPlacementCorrect, type TimelineEntry } from \"./lib/gameLogic\";\nimport { selectTrackForRound } from \"./lib/trackSelection\";\n\nfunction shuffleArray<T>(array: readonly T[]): T[] {\n  const shuffled = [...array];\n  for (let i = shuffled.length - 1; i >= 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    const temp = shuffled[i]!;\n    shuffled[i] = shuffled[j]!;\n    shuffled[j] = temp;\n  }\n  return shuffled;\n}\n\nexport const start = mutation({\n  args: { lobbyId: v.id(\"lobbies\"), sessionId: v.string() },\n  handler: async (ctx, args) => 