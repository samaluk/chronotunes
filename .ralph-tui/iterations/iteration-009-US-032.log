{"type":"tool_use","timestamp":1768791628037,"sessionID":"ses_42bd0b22affezSWq9SZp6F7aKL","part":{"id":"prt_bd431e281001xvfONXlj253v3k","sessionID":"ses_42bd0b22affezSWq9SZp6F7aKL","messageID":"msg_bd431c915001RzKBcvFM8NGqMJ","type":"tool","callID":"call_function_0gxanw09a28h_1","tool":"write","state":{"status":"completed","input":{"content":"import { convexTest } from \"convex-test\";\nimport { expect, test, vi } from \"vitest\";\nimport { internal } from \"./_generated/api\";\nimport schema from \"./schema\";\n\ntest(\"host disconnect sets hostTransferDeadline when host is offline\", async () => {\n  const t = convexTest(schema);\n\n  await t.run(async (ctx) => {\n    const lobbyId = await ctx.db.insert(\"lobbies\", {\n      code: \"DISCNT\",\n      hostSessionId: \"host-session-123\",\n      status: \"lobby\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId,\n      sessionId: \"host-session-123\",\n      displayName: \"HostPlayer\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n\n    const oldPresence = await ctx.db.insert(\"presence\", {\n      sessionId: \"host-session-123\",\n      lastSeen: Date.now() - 30000,\n    });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const lobby = await t.run(async (ctx) => {\n    const lobbies = await ctx.db.query(\"lobbies\").collect();\n    return lobbies[0];\n  });\n\n  expect(lobby).not.toBeNull();\n  expect(lobby?.hostTransferDeadline).toBeDefined();\n  expect(lobby?.hostTransferDeadline!).toBeGreaterThan(Date.now());\n});\n\ntest(\"host disconnect pauses game when host is offline during active game\", async () => {\n  const t = convexTest(schema);\n\n  let lobbyId: string;\n\n  await t.run(async (ctx) => {\n    lobbyId = await ctx.db.insert(\"lobbies\", {\n      code: \"INNGAM\",\n      hostSessionId: \"host-session-game\",\n      status: \"in_game\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId,\n      sessionId: \"host-session-game\",\n      displayName: \"HostGame\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n\n    const gameId = await ctx.db.insert(\"games\", {\n      lobbyId,\n      status: \"active\",\n      startedAt: Date.now(),\n      currentRoundNumber: 1,\n      turnOrder: [],\n      turnPlayerId: undefined,\n    });\n\n    await ctx.db.patch(lobbyId, { activeGameId: gameId });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const game = await t.run(async (ctx) => {\n    const games = await ctx.db.query(\"games\").collect();\n    return games[0];\n  });\n\n  expect(game).not.toBeNull();\n  expect(game?.status).toBe(\"paused\");\n});\n\ntest(\"host disconnect does not set deadline when host is online\", async () => {\n  const t = convexTest(schema);\n\n  await t.run(async (ctx) => {\n    const lobbyId = await ctx.db.insert(\"lobbies\", {\n      code: \"ONLINE\",\n      hostSessionId: \"host-session-online\",\n      status: \"lobby\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId,\n      sessionId: \"host-session-online\",\n      displayName: \"OnlineHost\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n\n    await ctx.db.insert(\"presence\", {\n      sessionId: \"host-session-online\",\n      lastSeen: Date.now(),\n    });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const lobby = await t.run(async (ctx) => {\n    const lobbies = await ctx.db.query(\"lobbies\").collect();\n    return lobbies[0];\n  });\n\n  expect(lobby).not.toBeNull();\n  expect(lobby?.hostTransferDeadline).toBeUndefined();\n});\n\ntest(\"host disconnect skips lobbies with pending transfer deadline\", async () => {\n  const t = convexTest(schema);\n\n  await t.run(async (ctx) => {\n    const lobbyId = await ctx.db.insert(\"lobbies\", {\n      code: \"PENDING\",\n      hostSessionId: \"host-session-pending\",\n      status: \"lobby\",\n      hostTransferDeadline: Date.now() + 60000,\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId,\n      sessionId: \"host-session-pending\",\n      displayName: \"PendingHost\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const lobby = await t.run(async (ctx) => {\n    const lobbies = await ctx.db.query(\"lobbies\").collect();\n    return lobbies[0];\n  });\n\n  expect(lobby).not.toBeNull();\n  expect(lobby?.hostTransferDeadline).toBeDefined();\n});\n\ntest(\"host disconnect does not affect finished lobbies\", async () => {\n  const t = convexTest(schema);\n\n  await t.run(async (ctx) => {\n    await ctx.db.insert(\"lobbies\", {\n      code: \"FINISH\",\n      hostSessionId: \"host-session-finish\",\n      status: \"finished\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const lobby = await t.run(async (ctx) => {\n    const lobbies = await ctx.db.query(\"lobbies\").collect();\n    return lobbies[0];\n  });\n\n  expect(lobby).not.toBeNull();\n  expect(lobby?.status).toBe(\"finished\");\n  expect(lobby?.hostTransferDeadline).toBeUndefined();\n});\n\ntest(\"host disconnect handles multiple lobbies correctly\", async () => {\n  const t = convexTest(schema);\n\n  await t.run(async (ctx) => {\n    const lobbyId1 = await ctx.db.insert(\"lobbies\", {\n      code: \"LOBBY1\",\n      hostSessionId: \"host-session-1\",\n      status: \"lobby\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId: lobbyId1,\n      sessionId: \"host-session-1\",\n      displayName: \"Host1\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n\n    const lobbyId2 = await ctx.db.insert(\"lobbies\", {\n      code: \"LOBBY2\",\n      hostSessionId: \"host-session-2\",\n      status: \"lobby\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId: lobbyId2,\n      sessionId: \"host-session-2\",\n      displayName: \"Host2\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n\n    await ctx.db.insert(\"presence\", {\n      sessionId: \"host-session-2\",\n      lastSeen: Date.now(),\n    });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const lobbies = await t.run(async (ctx) => {\n    return await ctx.db.query(\"lobbies\").collect();\n  });\n\n  expect(lobbies).toHaveLength(2);\n\n  const lobby1 = lobbies.find((l) => l.code === \"LOBBY1\");\n  const lobby2 = lobbies.find((l) => l.code === \"LOBBY2\");\n\n  expect(lobby1?.hostTransferDeadline).toBeDefined();\n  expect(lobby2?.hostTransferDeadline).toBeUndefined();\n});\n\ntest(\"host disconnect sets deadline in the future\", async () => {\n  const t = convexTest(schema);\n\n  await t.run(async (ctx) => {\n    await ctx.db.insert(\"lobbies\", {\n      code: \"FUTURE\",\n      hostSessionId: \"host-session-future\",\n      status: \"lobby\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId: (await ctx.db.query(\"lobbies\").first())!._id,\n      sessionId: \"host-session-future\",\n      displayName: \"FutureHost\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n  });\n\n  const beforeTime = Date.now();\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n  const afterTime = Date.now();\n\n  const lobby = await t.run(async (ctx) => {\n    const lobbies = await ctx.db.query(\"lobbies\").collect();\n    return lobbies[0];\n  });\n\n  expect(lobby).not.toBeNull();\n  expect(lobby?.hostTransferDeadline!).toBeGreaterThanOrEqual(beforeTime + 60000);\n  expect(lobby?.hostTransferDeadline!).toBeLessThanOrEqual(afterTime + 60000);\n});\n","filePath":"/Users/smaluk/dev/personal/chronotunes/convex/hostDisconnect.test.ts"},"output":"Wrote file successfully.\n\nLSP errors detected in this file, please fix:\n<diagnostics file=\"/Users/smaluk/dev/personal/chronotunes/convex/hostDisconnect.test.ts\">\nERROR [2:24] 'vi' is declared but its value is never read.\nERROR [38:11] 'oldPresence' is declared but its value is never read.\nERROR [38:45] Argument of type '\"presence\"' is not assignable to parameter of type 'TableNamesInDataModel<{ games: { document: { _id: Id<\"games\">; _creationTime: number; endedAt?: number; currentRoundId?: Id<\"rounds\">; turnPlayerId?: Id<\"players\">; winnerPlayerId?: Id<\"players\">; ... 4 more ...; turnOrder: Id<...>[]; }; fieldPaths: ExtractFieldPaths<...> | \"_id\"; indexes: { ...; }; searchIndexes: {...'.\nERROR [44:60] Expected 1 arguments, but got 2.\nERROR [80:7] Type 'string' is not assignable to type 'Id<\"lobbies\">'.\n  Type 'string' is not assignable to type '{ __tableName: \"lobbies\"; }'.\nERROR [91:7] Type 'string' is not assignable to type 'Id<\"lobbies\">'.\n  Type 'string' is not assignable to type '{ __tableName: \"lobbies\"; }'.\nERROR [99:24] Argument of type 'string' is not assignable to parameter of type 'Id<TableNamesInDataModel<{ games: { document: { _id: Id<\"games\">; _creationTime: number; endedAt?: number; currentRoundId?: Id<\"rounds\">; turnPlayerId?: Id<\"players\">; winnerPlayerId?: Id<\"players\">; ... 4 more ...; turnOrder: Id<...>[]; }; fieldPaths: ExtractFieldPaths<...> | \"_id\"; indexes: { ...; };