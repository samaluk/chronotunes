n00041|   await t.mutation(api.lobbies.create, {\n00042|     sessionId: \"test-session-host\",\n00043|     displayName: \"HostPlayer\",\n00044|   });\n00045| \n00046|   const players = await t.run(async (ctx) => {\n00047|     const allPlayers = await ctx.db.query(\"players\").collect();\n00048|     return allPlayers;\n00049|   });\n00050|   expect(players).toHaveLength(1);\n00051|   expect(players[0]?.isHost).toBe(true);\n00052|   expect(players[0]?.displayName).toBe(\"HostPlayer\");\n00053| });\n00054| \n00055| test(\"create lobby creates host with default starting coins\", async () => {\n00056|   const t = convexTest(schema);\n00057|   await t.mutation(api.lobbies.create, {\n00058|     sessionId: \"test-session-coins\",\n00059|     displayName: \"CoinsHost\",\n00060|   });\n00061| \n00062|   const players = await t.run(async (ctx) => {\n00063|     const allPlayers = await ctx.db.query(\"players\").collect();\n00064|     return allPlayers;\n00065|   });\n00066|   expect(players[0]?.coins).toBe(3);\n00067| });\n00068| \n00069| test(\"create lobby rejects empty display name\", async () => {\n00070|   const t = convexTest(schema);\n00071|   await expect(\n00072|     t.mutation(api.lobbies.create, {\n00073|       sessionId: \"test-session-empty\",\n00074|       displayName: \"\",\n00075|     }),\n00076|   ).rejects.toThrow();\n00077| });\n00078| \n00079| test(\"create lobby rejects display name too long\", async () => {\n00080|   const t = convexTest(schema);\n00081|   await expect(\n00082|     t.mutation(api.lobbies.create, {\n00083|       sessionId: \"test-session-long\",\n00084|       displayName: \"ThisDisplayNameIsWayTooLongToBeValid\",\n00085|     }),\n00086|   ).rejects.toThrow();\n00087| });\n00088| \n00089| test(\"create lobby generates unique codes\", async () => {\n00090|   const t = convexTest(schema);\n00091|   const codes = new Set<string>();\n00092| \n00093|   for (let i = 0; i < 10; i++) {\n00094|     const result = await t.mutation(api.lobbies.create, {\n00095|       sessionId: `test-session-${i}`,\n00096|       displayName: `Host${i}`,\n00097|     });\n00098|     codes.add(result.code);\n00099|   }\n00100| \n00101|   expect(codes.size).toBe(10);\n00102| });\n00103| \n00104| test(\"join lobby adds player to existing lobby\", async () => {\n00105|   const t = convexTest(schema);\n00106| \n00107|   const { code } = await t.mutation(api.lobbies.create, {\n00108|     sessionId: \"host-session\",\n00109|     displayName: \"HostPlayer\",\n00110|   });\n00111| \n00112|   await t.mutation(api.lobbies.join, {\n00113|     code,\n00114|     sessionId: \"player-session\",\n00115|     displayName: \"NewPlayer\",\n00116|   });\n00117| \n00118|   const players = await t.run(async (ctx) => {\n00119|     const allPlayers = await ctx.db.query(\"players\").collect();\n00120|     return allPlayers;\n00121|   });\n00122| \n00123|   expect(players).toHaveLength(2);\n00124|   const newPlayer = players.find((p) => p.sessionId === \"player-session\");\n00125|   expect(newPlayer).not.toBeUndefined();\n00126|   expect(newPlayer?.displayName).toBe(\"NewPlayer\");\n00127|   expect(newPlayer?.isHost).toBe(false);\n00128|   expect(newPlayer?.coins).toBe(3);\n00129| });\n00130| \n00131| test(\"join lobby returns lobby id\", async () => {\n00132|   const t = convexTest(schema);\n00133| \n00134|   const { code } = await t.mutation(api.lobbies.create, {\n00135|     sessionId: \"host-session-return\",\n00136|     displayName: \"HostReturn\",\n00137|   });\n00138| \n00139|   const result = await t.mutation(api.lobbies.join, {\n00140|     code,\n00141|     sessionId: \"player-session-return\",\n00142|     displayName: \"PlayerReturn\",\n00143|   });\n00144| \n00145|   expect(result.lobbyId).toBeDefined();\n00146| });\n00147| \n00148| test(\"join lobby rejects invalid code\", async () => {\n00149|   const t = convexTest(schema);\n00150| \n00151|   await expect(\n00152|     t.mutation(api.lobbies.join, {\n00153|       code: \"INVALID\",\n00154|       s