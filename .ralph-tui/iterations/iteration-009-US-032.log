ings, {\n00959|       code,\n00960|       sessionId: \"host-session-max-min\",\n00961|       settings: {\n00962|         targetTimelineSize: 10,\n00963|         startingCoins: 3,\n00964|         turnSeconds: 30,\n00965|         bettingWindowSeconds: 15,\n00966|         allowGuessTitleArtist: true,\n00967|         showLiveBets: true,\n00968|         allowBetRetraction: true,\n00969|         minYear: 1950,\n00970|         maxYear: 1940,\n00971|       },\n00972|     }),\n00973|   ).rejects.toThrow(\"Invalid minimum year\");\n00974| });\n00975| \n00976| test(\"updateSettings rejects maxYear above 2030\", async () => {\n00977|   const t = convexTest(schema);\n00978| \n00979|   const { code } = await t.mutation(api.lobbies.create, {\n00980|     sessionId: \"host-session-max-future\",\n00981|     displayName: \"HostMaxFuture\",\n00982|   });\n00983| \n00984|   await expect(\n00985|     t.mutation(api.lobbies.updateSettings, {\n00986|       code,\n00987|       sessionId: \"host-session-max-future\",\n00988|       settings: {\n00989|         targetTimelineSize: 10,\n00990|         startingCoins: 3,\n00991|         turnSeconds: 30,\n00992|         bettingWindowSeconds: 15,\n00993|         allowGuessTitleArtist: true,\n00994|         showLiveBets: true,\n00995|         allowBetRetraction: true,\n00996|         minYear: 1950,\n00997|         maxYear: 2031,\n00998|       },\n00999|     }),\n01000|   ).rejects.toThrow(\"Invalid maximum year\");\n01001| });\n01002| \n01003| test(\"updateSettings rejects when lobby not found\", async () => {\n01004|   const t = convexTest(schema);\n01005| \n01006|   await expect(\n01007|     t.mutation(api.lobbies.updateSettings, {\n01008|       code: \"NOTFOUND\",\n01009|       sessionId: \"some-session\",\n01010|       settings: {\n01011|         targetTimelineSize: 10,\n01012|         startingCoins: 3,\n01013|         turnSeconds: 30,\n01014|         bettingWindowSeconds: 15,\n01015|         allowGuessTitleArtist: true,\n01016|         showLiveBets: true,\n01017|         allowBetRetraction: true,\n01018|         minYear: 1950,\n01019|         maxYear: 2025,\n01020|       },\n01021|     }),\n01022|   ).rejects.toThrow(\"Lobby not found\");\n01023| });\n01024| \n01025| test(\"updateSettings rejects when lobby status is in_game\", async () => {\n01026|   const t = convexTest(schema);\n01027| \n01028|   const { code } = await t.mutation(api.lobbies.create, {\n01029|     sessionId: \"host-session-game\",\n01030|     displayName: \"HostGame\",\n01031|   });\n01032| \n01033|   await t.run(async (ctx) => {\n01034|     const lobby = await ctx.db.query(\"lobbies\").first();\n01035|     if (lobby) {\n01036|       await ctx.db.patch(lobby._id, { status: \"in_game\" });\n01037|     }\n01038|   });\n01039| \n01040|   await expect(\n01041|     t.mutation(api.lobbies.updateSettings, {\n01042|       code,\n01043|       sessionId: \"host-session-game\",\n01044|       settings: {\n01045|         targetTimelineSize: 10,\n01046|         startingCoins: 3,\n01047|         turnSeconds: 30,\n01048|         bettingWindowSeconds: 15,\n01049|         allowGuessTitleArtist: true,\n01050|         showLiveBets: true,\n01051|         allowBetRetraction: true,\n01052|         minYear: 1950,\n01053|         maxYear: 2025,\n01054|       },\n01055|     }),\n01056|   ).rejects.toThrow(\"Cannot update settings for a lobby that is not in lobby status\");\n01057| });\n01058| \n01059| test(\"updateSettings is case insensitive for code\", async () => {\n01060|   const t = convexTest(schema);\n01061| \n01062|   const { code } = await t.mutation(api.lobbies.create, {\n01063|     sessionId: \"host-session-case\",\n01064|     displayName: \"HostCase\",\n01065|   });\n01066| \n01067|   await t.mutation(api.lobbies.updateSettings, {\n01068|     code: code.toLowerCase(),\n01069|     sessionId: \"host-session-case\",\n01070|     settings: {\n01071|       targetTimelineSize: 12,\n01072|       startingCoins: 3,\n01073|       turnSeconds: 30,\n01074|       bettingWindowSeconds: 15,\n01075|       allowGuessTitleArtist: true,\n01076|       showLiveBets: true,\n01077|       allowBetRetraction: true,\n01078|       minYear: 1950,\n01079|       maxYear: 2025,\n01080|     },\n01081|   });\n01082| \n01083|   const lobby = await t.query(api.lobbies.get, { code: code.toUpperCase() });\n01084|   expect(lobby?.settings.targetTimelineSize).toBe(12);\n01085| });\n01086| \n01087| test(\"updateSettings allows host to toggle boolean settings\", async () => {\n01088|   const t = convexTest(schema);\n01089| \n01090|   const { code } = await t.mutation(api.lobbies.create, {\n01091|     sessionId: \"host-session-bool\",\n01092|     displayName: \"HostBool\",\n01093|   });\n01094| \n01095|   await t.mutation(api.lobbies.updateSettings, {\n01096|     code,\n01097|     sessionId: \"host-session-bool\",\n01098|     settings: {\n01099|       targetTimelineSize: 10,\n01100|       startingCoins: 3,\n01101|       turnSeconds: 30,\n01102|       bettingWindowSeconds: 15,\n01103|       allowGuessTitleArtist: false,\n01104|       showLiveBets: false,\n01105|       allowBetRetraction: false,\n01106|       minYear: 1950,\n01107|       maxYear: 2025,\n01108|     },\n01109|   });\n01110| \n01111|   const lobby = await t.query(api.lobbies.get, { code });\n01112|   expect(lobby?.settings.allowGuessTitleArtist).toBe(false);\n01113|   expect(lobby?.settings.showLiveBets).toBe(false);\n01114|   expect(lobby?.settings.allowBetRetraction).toBe(false);\n01115| });\n01116| \n\n(End of file - total 1116 lines)\n</file>","title":"convex/lobbies.test.ts","metadata":{"preview":"import { convexTest } from \"convex-test\";\nimport { expect, test } from \"vitest\";\nimport { api } from \"./_generated/api\";\nimport schema from \"./schema\";\n\ntest(\"create lobby generates 6-char code\", async () => {\n  const t = convexTest(schema);\n  const result = await t.mutation(api.lobbies.create, {\n    sessionId: \"test-session-123\",\n    displayName: \"TestHost\",\n  });\n  expect(result.code).toHaveLength(6);\n});\n\ntest(\"create lobby returns alphanumeric code only\", async () => {\n  const t = convexTest(schema);\n  const result = await t.mutation(api.lobbies.create, {\n    sessionId: \"test-session-456\",\n    displayName: \"AnotherHost\",\n  });","truncated":false},"time":{"start":1768791524514,"end":1768791524515}}}}
