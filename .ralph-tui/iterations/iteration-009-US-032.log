) {\n00221|       throw new ConvexError(\"No current round in this game\");\n00222|     }\n00223| \n00224|     const round = await ctx.db.get(game.currentRoundId);\n00225| \n00226|     if (!round) {\n00227|       throw new ConvexError(\"Round not found\");\n00228|     }\n00229| \n00230|     if (round.phase !== \"betting\") {\n00231|       throw new ConvexError(\"Can only resolve round during betting phase\");\n00232|     }\n00233| \n00234|     if (!round.placement) {\n00235|       throw new ConvexError(\"Round placement has not been submitted\");\n00236|     }\n00237| \n00238|     const track = await ctx.db.get(round.trackId);\n00239| \n00240|     if (!track) {\n00241|       throw new ConvexError(\"Track not found\");\n00242|     }\n00243| \n00244|     const turnPlayer = await ctx.db.get(round.turnPlayerId);\n00245| \n00246|     if (!turnPlayer) {\n00247|       throw new ConvexError(\"Turn player not found\");\n00248|     }\n00249| \n00250|     const validRange = computeValidIndexRange(turnPlayer.timeline, track.year);\n00251|     const turnPlayerWasCorrect = isPlacementCorrect(round.placement.proposedIndex, validRange);\n00252| \n00253|     const allBets = await ctx.db\n00254|       .query(\"roundBets\")\n00255|       .withIndex(\"by_round\", (q) => q.eq(\"roundId\", round._id))\n00256|       .collect();\n00257| \n00258|     const lockedBets = allBets.filter((bet) => bet.lockedIn);\n00259| \n00260|     const coinDeltas: { playerId: Id<\"players\">; delta: number }[] = [];\n00261|     const awardedPlayerIds: Id<\"players\">[] = [];\n00262| \n00263|     const timelineUpdates: Map<\n00264|       Id<\"players\">,\n00265|       { newTimeline: TimelineEntry[]; newTimelineSize: number }\n00266|     > = new Map();\n00267| \n00268|     for (const player of await ctx.db\n00269|       .query(\"players\")\n00270|       .filter((q) => q.eq(q.field(\"lobbyId\"), lobbyId))\n00271|       .collect()) {\n00272|       timelineUpdates.set(player._id, {\n00273|         newTimeline: [..