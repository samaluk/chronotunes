"Only the host can update settings\");\n00229|     }\n00230| \n00231|     if (lobby.status !== \"lobby\") {\n00232|       throw new ConvexError(\"Cannot update settings for a lobby that is not in lobby status\");\n00233|     }\n00234| \n00235|     if (settings.targetTimelineSize < 5 || settings.targetTimelineSize > 15) {\n00236|       throw new ConvexError(\"Target timeline size must be between 5 and 15\");\n00237|     }\n00238| \n00239|     if (settings.startingCoins < 1 || settings.startingCoins > 10) {\n00240|       throw new ConvexError(\"Starting coins must be between 1 and 10\");\n00241|     }\n00242| \n00243|     if (settings.turnSeconds < 15 || settings.turnSeconds > 120) {\n00244|       throw new ConvexError(\"Turn seconds must be between 15 and 120\");\n00245|     }\n00246| \n00247|     if (settings.bettingWindowSeconds < 5 || settings.bettingWindowSeconds > 60) {\n00248|       throw new ConvexError(\"Betting window seconds must be between 5 and 60\");\n00249|     }\n00250| \n00251|     if (settings.minYear < 1900 || settings.minYear > settings.maxYear) {\n00252|       throw new ConvexError(\"Invalid minimum year\");\n00253|     }\n00254| \n00255|     if (settings.maxYear < settings.minYear || settings.maxYear > 2030) {\n00256|       throw new ConvexError(\"Invalid maximum year\");\n00257|     }\n00258| \n00259|     await ctx.db.patch(lobby._id, { settings });\n00260|   },\n00261| });\n00262| \n\n(End of file - total 262 lines)\n</file>","title":"convex/lobbies.ts","metadata":{"preview":"import { ConvexError, v } from \"convex/values\";\nimport { mutation, query } from \"./_generated/server\";\n\nconst LOBBY_CODE_CHARS = \"ABCDEFGHJKLMNPQRSTUVWXYZ23456789\";\nconst LOBBY_CODE_LENGTH = 6;\n\nconst DEFAULT_SETTINGS = {\n  targetTimelineSize: 10,\n  startingCoins: 3,\n  turnSeconds: 30,\n  bettingWindowSeconds: 15,\n  allowGuessTitleArtist: true,\n  showLiveBets: true,\n  allowBetRetraction: true,\n  minYear: 1950,\n  maxYear: 2025,\n} as const;\n\nfunction g