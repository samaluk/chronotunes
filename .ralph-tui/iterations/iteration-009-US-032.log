        if (lobby.status === \"in_game\" && lobby.activeGameId) {\n00039|           const game = await ctx.db.get(lobby.activeGameId);\n00040|           if (game && game.status === \"active\") {\n00041|             await ctx.db.patch(game._id, { status: \"paused\" });\n00042|           }\n00043|         }\n00044|       }\n00045|     }\n00046|   },\n00047| });\n00048| \n\n(End of file - total 48 lines)\n</file>","title":"convex/hostDisconnect.ts","metadata":{"preview":"import { Presence } from \"@convex-dev/presence\";\nimport { components } from \"./_generated/api\";\nimport { internalMutation } from \"./_generated/server\";\n\nconst presenceComponent = new Presence(components.presence);\n\nconst HEARTBEAT_TIMEOUT_MS = 10000;\nconst HOST_TRANSFER_DEADLINE_MS = 60000;\n\nexport const checkHostDisconnect = internalMutation({\n  args: {},\n  handler: async (ctx) => {\n    const now = Date.now();\n    const cutoffTime = now - HEARTBEAT_TIMEOUT_MS;\n\n    const lobbies = await ctx.db\n      .query(\"lobbies\")\n      .filter((q) => q.or(q.eq(q.field(\"status\"), \"lobby\"), q.eq(q.field(\"status\"), \"in_game\")))\n      .collect();\n","truncated":false},"time":{"start":1768791917327,"end":1768791917328}}}}
