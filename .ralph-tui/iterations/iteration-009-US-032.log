{"type":"tool_use","timestamp":1768791569501,"sessionID":"ses_42bd0b22affezSWq9SZp6F7aKL","part":{"id":"prt_bd4315ec6001y2RgCONhtIWLRG","sessionID":"ses_42bd0b22affezSWq9SZp6F7aKL","messageID":"msg_bd43113ca00192l5VOmrGVKV8x","type":"tool","callID":"call_function_8llf2lg05ngv_1","tool":"write","state":{"status":"completed","input":{"content":"import { Presence } from \"@convex-dev/presence\";\nimport { v } from \"convex/values\";\nimport { components } from \"./_generated/api\";\nimport { internalMutation } from \"./_generated/server\";\n\nconst presenceComponent = new Presence(components.presence);\n\nconst HEARTBEAT_TIMEOUT_MS = 10000;\nconst HOST_TRANSFER_DEADLINE_MS = 60000;\n\nexport const checkHostDisconnect = internalMutation({\n  args: {},\n  handler: async (ctx) => {\n    const now = Date.now();\n    const cutoffTime = now - HEARTBEAT_TIMEOUT_MS;\n\n    const lobbies = await ctx.db\n      .query(\"lobbies\")\n      .filter((q) =>\n        q.or(q.eq(q.field(\"status\"), \"lobby\"), q.eq(q.field(\"status\"), \"in_game\")),\n      )\n      .collect();\n\n    for (const lobby of lobbies) {\n      if (lobby.hostTransferDeadline && lobby.hostTransferDeadline > now) {\n        continue;\n      }\n\n      const hostPresence = await presenceComponent.listUser(\n        ctx,\n        lobby.hostSessionId,\n        false,\n      );\n\n      const isHostOnline =\n        hostPresence.length > 0 &&\n        (hostPresence[0] as { lastSeen?: number }).lastSeen !== undefined &&\n        (hostPresence[0] as { lastSeen?: number }).lastSeen! > cutoffTime;\n\n      if (!isHostOnline) {\n        const hostTransferDeadline = now + HOST_TRANSFER_DEADLINE_MS;\n\n        await ctx.db.patch(lobby._id, { hostTransferDeadline });\n\n        if (lobby.status === \"in_game\" && lobby.activeGameId) {\n          const game = await ctx.db.get(lobby.activeGameId);\n          if (game && game.status === \"active\") {\n            await ctx.db.patch(game._id, { status: \"paused\" });\n          }\n        }\n      }\n    }\n  },\n});\n","filePath":"/Users/smaluk/dev/personal/chronotunes/convex/hostDisconnect.ts"},"output":"Wrote file successfully.\n\nLSP errors detected in this file, please fix:\n<diagnostics file=\"/Users/smaluk/dev/personal/chronotunes/convex/hostDisconnect.ts\">\nERROR [2:1] 'v' is declared but its value is never read.\n</diagnostics>","title":"convex/hostDisconnect.ts","metadata":{"diagnostics":{"/Users/smaluk/dev/personal/chronotunes/convex/schema.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/lobbies.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/players.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/games.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/lib/sessionWrapper.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/presence.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/convex.config.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/rounds.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/bets.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/tracks.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/lib/gameLogic.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/lobbies.test.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/hostDisconnect.ts":[{"range":{"start":{"line":1,"character":0},"end":{"line":1,"character":34}},"message":"'v' is declared but its value is never read.","severity":1,"code":6133,"source":"typescript"},{"code":"lint/correctness/noUnusedImports","codeDescription":{"href":"https://biomejs.dev/linter/rules/no-unused-imports"},"message":"This import is unused.","range":{"end":{"character":12,"line":1},"start":{"character":7,"line":1}},"severity":2,"source":"biome"}]},"filepath":"/Users/smaluk/dev/personal/chronotunes/convex/hostDisconnect.ts","exists":false,"truncated":false},"time":{"start":1768791568817,"end":1768791569500}}}}
