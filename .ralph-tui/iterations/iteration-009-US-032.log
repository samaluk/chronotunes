{"type":"tool_use","timestamp":1768791716601,"sessionID":"ses_42bd0b22affezSWq9SZp6F7aKL","part":{"id":"prt_bd432eee80011m3K5OT7pZhyyE","sessionID":"ses_42bd0b22affezSWq9SZp6F7aKL","messageID":"msg_bd432a3100019k6PJ3SQ4Hp2Pu","type":"tool","callID":"call_function_klzbqc2yj44k_1","tool":"write","state":{"status":"completed","input":{"content":"import { convexTest } from \"convex-test\";\nimport { expect, test } from \"vitest\";\nimport { internal } from \"./_generated/api\";\nimport schema from \"./schema\";\n\ntest(\"host disconnect sets hostTransferDeadline when host is offline in lobby\", async () => {\n  const t = convexTest(schema);\n\n  await t.run(async (ctx) => {\n    await ctx.db.insert(\"lobbies\", {\n      code: \"DISCNT\",\n      hostSessionId: \"host-session-offline\",\n      status: \"lobby\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    const lobby = await ctx.db.query(\"lobbies\").first();\n    await ctx.db.insert(\"players\", {\n      lobbyId: lobby!._id,\n      sessionId: \"host-session-offline\",\n      displayName: \"HostPlayer\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const lobby = await t.run(async (ctx) => {\n    const lobbies = await ctx.db.query(\"lobbies\").collect();\n    return lobbies[0];\n  });\n\n  expect(lobby).not.toBeNull();\n  expect(lobby?.hostTransferDeadline).toBeDefined();\n  expect(lobby!.hostTransferDeadline).toBeGreaterThan(Date.now());\n});\n\ntest(\"host disconnect pauses game when host is offline during active game\", async () => {\n  const t = convexTest(schema);\n\n  let gameId: string;\n\n  await t.run(async (ctx) => {\n    const lobbyId = await ctx.db.insert(\"lobbies\", {\n      code: \"INNGAM\",\n      hostSessionId: \"host-session-game\",\n      status: \"in_game\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId,\n      sessionId: \"host-session-game\",\n      displayName: \"HostGame\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n\n    gameId = await ctx.db.insert(\"games\", {\n      lobbyId,\n      status: \"active\",\n      startedAt: Date.now(),\n      currentRoundNumber: 1,\n      turnOrder: [],\n      turnPlayerId: undefined,\n    });\n\n    await ctx.db.patch(lobbyId, { activeGameId: gameId });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const game = await t.run(async (ctx) => {\n    const games = await ctx.db.query(\"games\").collect();\n    return games[0];\n  });\n\n  expect(game).not.toBeNull();\n  expect(game?.status).toBe(\"paused\");\n});\n\ntest(\"host disconnect does not affect finished lobbies\", async () => {\n  const t = convexTest(schema);\n\n  await t.run(async (ctx) => {\n    await ctx.db.insert(\"lobbies\", {\n      code: \"FINISH\",\n      hostSessionId: \"host-session-finish\",\n      status: \"finished\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const lobby = await t.run(async (ctx) => {\n    const lobbies = await ctx.db.query(\"lobbies\").collect();\n    return lobbies[0];\n  });\n\n  expect(lobby).not.toBeNull();\n  expect(lobby?.status).toBe(\"finished\");\n  expect(lobby?.hostTransferDeadline).toBeUndefined();\n});\n\ntest(\"host disconnect handles multiple lobbies correctly\", async () => {\n  const t = convexTest(schema);\n\n  await t.run(async (ctx) => {\n    const lobbyId1 = await ctx.db.insert(\"lobbies\", {\n      code: \"LOBBY1\",\n      hostSessionId: \"host-session-1\",\n      status: \"lobby\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId: lobbyId1,\n      sessionId: \"host-session-1\",\n      displayName: \"Host1\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n\n    const lobbyId2 = await ctx.db.insert(\"lobbies\", {\n      code: \"LOBBY2\",\n      hostSessionId: \"host-session-2\",\n      status: \"lobby\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId: lobbyId2,\n      sessionId: \"host-session-2\",\n      displayName: \"Host2\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const lobbies = await t.run(async (ctx) => {\n    return await ctx.db.query(\"lobbies\").collect();\n  });\n\n  expect(lobbies).toHaveLength(2);\n\n  const lobby1 = lobbies.find((l) => l.code === \"LOBBY1\");\n  const lobby2 = lobbies.find((l) => l.code === \"LOBBY2\");\n\n  expect(lobby1?.hostTransferDeadline).toBeDefined();\n  expect(lobby2?.hostTransferDeadline).toBeDefined();\n});\n\ntest(\"host disconnect sets deadline in the future (60 seconds)\", async () => {\n  const t = convexTest(schema);\n\n  await t.run(async (ctx) => {\n    const lobbyId = await ctx.db.insert(\"lobbies\", {\n      code: \"FUTURE\",\n      hostSessionId: \"host-session-future\",\n      status: \"lobby\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId,\n      sessionId: \"host-session-future\",\n      displayName: \"FutureHost\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n  });\n\n  const beforeTime = Date.now();\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n  const afterTime = Date.now();\n\n  const lobby = await t.run(async (ctx) => {\n    const lobbies = await ctx.db.query(\"lobbies\").collect();\n    return lobbies[0];\n  });\n\n  expect(lobby).not.toBeNull();\n  expect(lobby!.hostTransferDeadline).toBeGreaterThanOrEqual(beforeTime + 60000);\n  expect(lobby!.hostTransferDeadline).toBeLessThanOrEqual(afterTime + 60000);\n});\n\ntest(\"host disconnect skips lobbies with pending transfer deadline in future\", async () => {\n  const t = convexTest(schema);\n\n  await t.run(async (ctx) => {\n    const lobbyId = await ctx.db.insert(\"lobbies\", {\n      code: \"PENDING\",\n      hostSessionId: \"host-session-pending\",\n      status: \"lobby\",\n      hostTransferDeadline: Date.now() + 60000,\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId,\n      sessionId: \"host-session-pending\",\n      displayName: \"PendingHost\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n  });\n\n  const originalDeadline = await t.run(async (ctx) => {\n    const lobby = await ctx.db.query(\"lobbies\").first();\n    return lobby?.hostTransferDeadline;\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const lobby = await t.run(async (ctx) => {\n    const lobbies = await ctx.db.query(\"lobbies\").collect();\n    return lobbies[0];\n  });\n\n  expect(lobby).not.toBeNull();\n  expect(lobby!.hostTransferDeadline).toBe(originalDeadline);\n});\n\ntest(\"host disconnect does not pause already paused game\", async () => {\n  const t = convexTest(schema);\n\n  let gameId: string;\n\n  await t.run(async (ctx) => {\n    const lobbyId = await ctx.db.insert(\"lobbies\", {\n      code: \"PAUSED\",\n      hostSessionId: \"host-session-paused\",\n      status: \"in_game\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId,\n      sessionId: \"host-session-paused\",\n      displayName: \"PausedHost\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n\n    gameId = await ctx.db.insert(\"games\", {\n      lobbyId,\n      status: \"paused\",\n      startedAt: Date.now(),\n      currentRoundNumber: 1,\n      turnOrder: [],\n      turnPlayerId: undefined,\n    });\n\n    await ctx.db.patch(lobbyId, { activeGameId: gameId });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const game = await t.run(async (ctx) => {\n    const games = await ctx.db.query(\"games\").collect();\n    return games[0];\n  });\n\n  expect(game).not.toBeNull();\n  expect(game?.status).toBe(\"paused\");\n});\n\ntest(\"host disconnect does not pause finished game\", async () => {\n  const t = convexTest(schema);\n\n  let gameId: string;\n\n  await t.run(async (ctx) => {\n    const lobbyId = await ctx.db.insert(\"lobbies\", {\n      code: \"FINGAM\",\n      hostSessionId: \"host-session-fingame\",\n      status: \"in_game\",\n      settings: {\n        targetTimelineSize: 10,\n        startingCoins: 3,\n        turnSeconds: 30,\n        bettingWindowSeconds: 15,\n        allowGuessTitleArtist: true,\n        showLiveBets: true,\n        allowBetRetraction: true,\n        minYear: 1950,\n        maxYear: 2025,\n      },\n    });\n\n    await ctx.db.insert(\"players\", {\n      lobbyId,\n      sessionId: \"host-session-fingame\",\n      displayName: \"FinHost\",\n      isHost: true,\n      coins: 3,\n      timeline: [],\n      timelineSize: 0,\n      createdAt: Date.now(),\n    });\n\n    gameId = await ctx.db.insert(\"games\", {\n      lobbyId,\n      status: \"finished\",\n      startedAt: Date.now() - 3600000,\n      currentRoundNumber: 5,\n      turnOrder: [],\n      turnPlayerId: undefined,\n    });\n\n    await ctx.db.patch(lobbyId, { activeGameId: gameId });\n  });\n\n  await t.run(internal.hostDisconnect.checkHostDisconnect, {});\n\n  const game = await t.run(async (ctx) => {\n    const games = await ctx.db.query(\"games\").collect();\n    return games[0];\n  });\n\n  expect(game).not.toBeNull();\n  expect(game?.stat