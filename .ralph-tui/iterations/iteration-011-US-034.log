{"type":"tool_use","timestamp":1768792694722,"sessionID":"ses_42bbee2f9ffeBgGYzJ6pW8e2td","part":{"id":"prt_bd4429e84001ycfme1m7aUzV3k","sessionID":"ses_42bbee2f9ffeBgGYzJ6pW8e2td","messageID":"msg_bd4428c8a001Cd0zpBHO9VW7c2","type":"tool","callID":"call_function_rcsc1havqcvl_1","tool":"read","state":{"status":"completed","input":{"filePath":"/Users/smaluk/dev/personal/chronotunes/convex/lobbies.ts","offset":260},"output":"<file>\n00261| });\n00262| \n00263| export const transferHost = mutation({\n00264|   args: {\n00265|     code: v.string(),\n00266|     sessionId: v.string(),\n00267|     newHostSessionId: v.string(),\n00268|   },\n00269|   handler: async (ctx, args) => {\n00270|     const { code, sessionId, newHostSessionId } = args;\n00271| \n00272|     const lobby = await ctx.db\n00273|       .query(\"lobbies\")\n00274|       .filter((q) => q.eq(q.field(\"code\"), code.toUpperCase()))\n00275|       .first();\n00276| \n00277|     if (!lobby) {\n00278|       throw new ConvexError(\"Lobby not found\");\n00279|     }\n00280| \n00281|     if (lobby.hostSessionId !== sessionId) {\n00282|       throw new ConvexError(\"Only the host can transfer host privileges\");\n00283|     }\n00284| \n00285|     if (sessionId === newHostSessionId) {\n00286|       throw new ConvexError(\"Cannot transfer host to yourself\");\n00287|     }\n00288| \n00289|     const currentHostPlayer = await ctx.db\n00290|       .query(\"players\")\n00291|       .filter((q) =>\n00292|         q.and(q.eq(q.field(\"lobbyId\"), lobby._id), q.eq(q.field(\"sessionId\"), sessionId)),\n00293|       )\n00294|       .first();\n00295| \n00296|     if (!currentHostPlayer) {\n00297|       throw new ConvexError(\"You are not in this lobby\");\n00298|     }\n00299| \n00300|     const newHostPlayer = await ctx.db\n00301|       .query(\"players\")\n00302|       .filter((q) =>\n00303|         q.and(q.eq(q.field(\"lobbyId\"), lobby._id), q.eq(q.field(\"sessionId\"), newHostSessionId)),\n00304|       )\n00305|       .first();\n00306| \n00307|     if (!newHostPlayer) {\n00308|       throw new ConvexError(\"New host player is not in this lobby\");\n00309|     }\n00310| \n00311|     await ctx.db.patch(currentHostPlayer._id, { isHost: false });\n00312|     await ctx.db.patch(newHostPlayer._id, { isHost: true });\n00313|     await ctx.db.patch(lobby._id, { hostSessionId: newHostSessionId });\n00314|   },\n00315| });\n00316| \n\n(End of file - total 316 lines)\n</file>","title":"convex/lobbies.ts","metadata":{"preview":"});\n\nexport const transferHost = mutation({\n  args: {\n    code: v.string(),\n    sessionId: v.string(),\n    newHostSessionId: v.string(),\n  },\n  handler: async (ctx, args) => {\n    const { code, sessionId, newHostSessionId } = args;\n\n    const lobby = await ctx.db\n      .query(\"lobbies\")\n      .filter((q) => q.eq(q.field(\"code\"), code.toUpperCase()))\n      .first();\n\n    if (!lobby) {\n      throw new ConvexError(\"Lobby not found\");\n    }\n","truncated":false},"time":{"start":1768792694720,"end":1768792694721}}}}
