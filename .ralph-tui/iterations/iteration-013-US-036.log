{"type":"tool_use","timestamp":1768793812760,"sessionID":"ses_42bafe514ffeSkiPn0smgax61J","part":{"id":"prt_bd45383d10013TsEhZRNTbFhqS","sessionID":"ses_42bafe514ffeSkiPn0smgax61J","messageID":"msg_bd453749d001Hziosz2I2sGuZd","type":"tool","callID":"call_function_pqissoqdozxb_1","tool":"write","state":{"status":"completed","input":{"filePath":"/Users/smaluk/dev/personal/chronotunes/src/lib/hooks/use-convex-status.ts","content":"\"use client\";\n\nimport {\n  ConvexReactClient,\n  useConvexReactClient,\n} from \"convex/react\";\nimport { useEffect, useState } from \"react\";\n\nexport type ConvexConnectionStatus =\n  | \"connecting\"\n  | \"connected\"\n  | \"disconnected\"\n  | \"reconnecting\"\n  | \"error\";\n\ninterface UseConvexStatusReturn {\n  status: ConvexConnectionStatus;\n  isConnected: boolean;\n  isReconnecting: boolean;\n  error: Error | null;\n  retry: () => void;\n}\n\nexport function useConvexStatus(): UseConvexStatusReturn {\n  const client = useConvexReactClient();\n  const [status, setStatus] = useState<ConvexConnectionStatus>(\"connecting\");\n  const [error, setError] = useState<Error | null>(null);\n\n  useEffect(() => {\n    if (!client) {\n      setStatus(\"disconnected\");\n      return;\n    }\n\n    const handleStatusChange = (newStatus: string): void => {\n      switch (newStatus) {\n        case \"connecting\":\n          setStatus(\"connecting\");\n          setError(null);\n          break;\n        case \"connected\":\n          setStatus(\"connected\");\n          setError(null);\n          break;\n        case \"disconnected\":\n          setStatus(\"disconnected\");\n          break;\n        case \"reconnecting\":\n          setStatus(\"reconnecting\");\n          setError(null);\n          break;\n        case \"error\":\n          setStatus(\"error\");\n          break;\n      }\n    };\n\n    const handleError = (err: Error): void => {\n      setError(err);\n      setStatus(\"error\");\n    };\n\n    const unsubscribeStatus = client.onStatusChange(handleStatusChange);\n    client.onError(handleError);\n\n    const initialStatus = client.status;\n    if (initialStatus) {\n      handleStatusChange(initialStatus);\n    }\n\n    return () => {\n      unsubscribeStatus();\n    };\n  }, [client]);\n\n  const retry = (): void => {\n    if (client) {\n      setStatus(\"connecting\");\n      client.retry();\n    }\n  };\n\n  return {\n    status,\n    isConnected: status === \"connected\",\n    isReconnecting: status === \"reconnecting\",\n    error,\n    retry,\n  };\n}\n\nlet globalConvexClient: ConvexReactClient | null = null;\n\nexport function setGlobalConvexClient(client: ConvexReactClient): void {\n  globalConvexClient = client;\n}\n\nexport function getGlobalConvexClient(): ConvexReactClient | null {\n  return globalConvexClient;\n}\n"},"output":"Wrote file successfully.\n\nLSP errors detected in other files:\n<diagnostics file=\"/Users/smaluk/dev/personal/chronotunes/src/components/ui/skeletons.tsx\">\nERROR [48:46] Avoid using the index of an array as key property in an element.\nERROR [61:32] Avoid using the index of an array as key property in an element.\nERROR [119:38] Avoid using the index of an array as key property in an element.\nERROR [153:35] Avoid using the index of an array as key property in an element.\nERROR [176:38] Avoid using the index of an array as key property in an element.\n</diagnostics>\n\nLSP errors detected in other files:\n<diagnostics file=\"/Users/smaluk/dev/personal/chronotunes/src/components/ui/error-boundary.tsx\">\nERROR [33:21] Type 'string | null | undefined' is not assignable to type 'string | null'.\n  Type 'undefined' is not assignable to type 'string | null'.\n</diagnostics>","title":"src/lib/hooks/use-convex-status.ts","metadata":{"diagnostics":{"/Users/smaluk/dev/personal/chronotunes/convex/schema.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/lib/utils.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/components/ui/spinner.tsx":[{"code":"as