.number(),\n00040|   updatedAt: v.number(),\n00041| });\n00042| \n00043| // Placement object\n00044| const placement = v.object({\n00045|   proposedIndex: v.number(),\n00046|   submittedAt: v.number(),\n00047| });\n00048| \n00049| // Guess object for title/artist guessing\n00050| const guess = v.object({\n00051|   guessedTitle: v.optional(v.string()),\n00052|   guessedArtist: v.optional(v.string()),\n00053|   isCorrect: v.boolean(),\n00054|   awardedCoin: v.boolean(),\n00055|   submittedAt: v.number(),\n00056| });\n00057| \n00058| // Round resolution object\n00059| const resolution = v.object({\n00060|   validIndexMin: v.number(),\n00061|   validIndexMax: v.number(),\n00062|   turnPlayerWasCorrect: v.boolean(),\n00063|   awardedPlayerIds: v.array(v.id(\"players\")),\n00064|   coinDeltas: v.array(\n00065|     v.object({\n00066|       playerId: v.id(\"players\"),\n00067|       delta: v.number(),\n00068|     }),\n00069|   ),\n00070|   resolvedAt: v.number(),\n00071| });\n00072| \n00073| // External IDs for tracks (Spotify, YouTube, Deezer)\n00074| const externalIds = v.object({\n00075|   spotifyTrackId: v.optional(v.string()),\n00076|   youtubeVideoId: v.optional(v.string()),\n00077|   deezerTrackId: v.optional(v.string()),\n00078| });\n00079| \n00080| // Links for tracks\n00081| const trackLinks = v.object({\n00082|   spotifyUrl: v.optional(v.string()),\n00083|   youtubeUrl: v.optional(v.string()),\n00084|   deezerUrl: v.optional(v.string()),\n00085| });\n00086| \n00087| export default defineSchema({\n00088|   // Lobbies table\n00089|   lobbies: defineTable({\n00090|     code: v.string(),\n00091|     hostSessionId: v.string(),\n00092|     hostTransferDeadline: v.optional(v.number()),\n00093|     status: lobbyStatus,\n00094|     settings: lobbySettings,\n00095|     activeGameId: v.optional(v.id(\"games\")),\n00096|   }).index(\"by_code\", [\"code\"]),\n00097| \n00098|   // Players table\n00099|   players: defineTable({\n00100|     lobbyId: v.id(\"lobbies\"),\n00101|   