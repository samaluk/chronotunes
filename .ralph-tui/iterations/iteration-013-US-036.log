{"type":"tool_use","timestamp":1768793786161,"sessionID":"ses_42bafe514ffeSkiPn0smgax61J","part":{"id":"prt_bd4530c2f001mce9e6HU0XxPqw","sessionID":"ses_42bafe514ffeSkiPn0smgax61J","messageID":"msg_bd452ef95001ThxTG1rNHF2uPi","type":"tool","callID":"call_function_jk9me2ti4qcv_1","tool":"write","state":{"status":"completed","input":{"content":"\"use client\";\n\nimport type { ReactNode } from \"react\";\nimport { RefreshCw, AlertCircle } from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport { cn } from \"@/lib/utils\";\n\ninterface ErrorBoundaryState {\n  hasError: boolean;\n  error: Error | null;\n  errorInfo: string | null;\n}\n\ninterface ErrorBoundaryProps {\n  children: ReactNode;\n  fallback?: ReactNode;\n  onError?: (error: Error, errorInfo: string) => void;\n  className?: string;\n}\n\nexport class ErrorBoundary extends React.Component<\n  ErrorBoundaryProps,\n  ErrorBoundaryState\n> {\n  constructor(props: ErrorBoundaryProps) {\n    super(props);\n    this.state = { hasError: false, error: null, errorInfo: null };\n  }\n\n  static getDerivedStateFromError(error: Error): Partial<ErrorBoundaryState> {\n    return { hasError: true, error };\n  }\n\n  componentDidCatch(error: Error, errorInfo: React.ErrorInfo) {\n    console.error(\"ErrorBoundary caught an error:\", error, errorInfo);\n    this.setState({ errorInfo: errorInfo.componentStack });\n    if (this.props.onError) {\n      this.props.onError(error, errorInfo.componentStack || \"\");\n    }\n  }\n\n  handleRetry = (): void => {\n    this.setState({ hasError: false, error: null, errorInfo: null });\n  };\n\n  render(): ReactNode {\n    if (this.state.hasError) {\n      if (this.props.fallback) {\n        return this.props.fallback;\n      }\n\n      return (\n        <div\n          className={cn(\n            \"flex flex-col items-center justify-center min-h-[200px] p-6 rounded-xl bg-card border border-destructive/20\",\n            this.props.className,\n          )}\n        >\n          <div className=\"flex items-center gap-3 mb-4\">\n            <div className=\"flex h-10 w-10 items-center justify-center rounded-full bg-destructive/10\">\n              <AlertCircle className=\"h-5 w-5 text-destructive\" />\n            </div>\n            <h2 className=\"text-lg font-semibold\">Something went wrong</h2>\n          </div>\n          <p className=\"text-sm text-muted-foreground text-center max-w-md mb-4\">\n            An unexpected error occurred. Please try again or refresh the page.\n          </p>\n          <Button onClick={this.handleRetry} variant=\"outline\">\n            <RefreshCw className=\"h-4 w-4 mr-2\" />\n            Try Again\n          </Button>\n        </div>\n      );\n    }\n\n    return this.props.children;\n  }\n}\n\ninterface AsyncErrorBoundaryState {\n  hasError: boolean;\n  error: Error | null;\n}\n\ninterface AsyncErrorBoundaryProps {\n  children: ReactNode;\n  fallback?: (error: Error, retry: () => void) => ReactNode;\n  onError?: (error: Error) => void;\n  className?: string;\n}\n\ninterface AsyncErrorBoundaryState2 {\n  hasError: boolean;\n  error: Error | null;\n}\n\nexport function AsyncErrorBoundary({\n  children,\n  fallback,\n  onError,\n  className,\n}: AsyncErrorBoundaryProps): ReactNode {\n  const [state, setState] = React.useState<AsyncErrorBoundaryState2>({\n    hasError: false,\n    error: null,\n  });\n\n  const handleRetry = (): void => {\n    setState({ hasError: false, error: null });\n  };\n\n  if (state.hasError && state.error) {\n    if (fallback) {\n      return fallback(state.error, handleRetry);\n    }\n\n    return (\n      <div\n        className={cn(\n          \"flex flex-col items-center justify-center min-h-[200px] p-6 rounded-xl bg-card border border-destructive/20\",\n          className,\n        )}\n      >\n        <div className=\"flex items-center gap-3 mb-4\">\n          <div className=\"flex h-10 w-10 items-center justify-center rounded-full bg-destructive/10\">\n            <AlertCircle className=\"h-5 w-5 text-destructive\" />\n          </div>\n          <h2 className=\"text-lg font-semibold\">Something went wrong</h2>\n        </div>\n        <p className=\"text-sm text-muted-foreground text-center max-w-md mb-4\">\n          {state.error.message || \"An unexpected error occurred.\"}\n        </p>\n        <Button onClick={handleRetry} variant=\"outline\">\n          <RefreshCw className=\"h-4 w-4 mr-2\" />\n          Try Again\n        </Button>\n      </div>\n    );\n  }\n\n  return <>{children}</>;\n}\n","filePath":"/Users/smaluk/dev/personal/chronotunes/src/components/ui/error-boundary.tsx"},"output":"Wrote file successfully.\n\nLSP errors detected in other files:\n<diagnostics file=\"/Users/smaluk/dev/personal/chronotunes/src/components/ui/skeletons.tsx\">\nERROR [48:46] Avoid using the index of an array as key property in an element.\nERROR [61:32] Avoid using the index of an array as key property in an element.\nERROR [119:38] Avoid using the index of an array as key property in an element.\nERROR [153:35] Avoid using the index of an array as key property in an element.\nERROR [176:38] Avoid using the index of an array as key property in an element.\n</diagnostics>","title":"src/components/ui/error-boundary.tsx","metadata":{"diagnostics":{"/Users/smaluk/dev/personal/chronotunes/convex/schema.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/lib/utils.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/components/ui/spinner.tsx":[{"code":"assist/source/organizeImports","codeDescription":{"href":"https://biomejs.dev/assist/actions/organize-imports"},"message":"The imports and exports are not sorted.","range":{"end":{"character":33,"line":0},"start":{"character":0,"line":0}},"severity":3,"source":"biome"}],"/Users/smaluk/dev/personal/chronotunes/src/components/game/PlayersBar.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/CurrentRoundPanel.tsx":[{"range":{"start":{"line":135,"character":16},"end":{"l