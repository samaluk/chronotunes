{"type":"tool_use","timestamp":1768793860301,"sessionID":"ses_42bafe514ffeSkiPn0smgax61J","part":{"id":"prt_bd4543577001Sv266aR3rUhcS3","sessionID":"ses_42bafe514ffeSkiPn0smgax61J","messageID":"msg_bd4542afb001Tk8Ng3rgtwQyFO","type":"tool","callID":"call_function_5zrj2s7hg9jk_1","tool":"write","state":{"status":"completed","input":{"content":"\"use client\";\n\nimport { useConvexStatus, type ConvexConnectionStatus } from \"@/lib/hooks/use-convex-status\";\nimport { WifiOff, RefreshCw, CheckCircle2, CircleDashed } from \"lucide-react\";\nimport { cn } from \"@/lib/utils\";\n\ninterface NetworkStatusProps {\n  className?: string;\n  showLabel?: boolean;\n}\n\nexport function NetworkStatus({ className, showLabel = true }: NetworkStatusProps) {\n  const { status, isReconnecting, retry } = useConvexStatus();\n\n  if (status === \"connected\") {\n    return null;\n  }\n\n  return (\n    <div\n      className={cn(\n        \"flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium transition-all\",\n        status === \"error\" && \"bg-destructive/10 text-destructive\",\n        status === \"disconnected\" && \"bg-muted text-muted-foreground\",\n        status === \"connecting\" && \"bg-primary/10 text-primary\",\n        status === \"reconnecting\" && \"bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300\",\n        className,\n      )}\n    >\n      <StatusIcon status={status} />\n      {showLabel && <StatusLabel status={status} onRetry={retry} />}\n    </div>\n  );\n}\n\nfunction StatusIcon({ status }: { status: ConvexConnectionStatus }) {\n  switch (status) {\n    case \"connecting\":\n      return <CircleDashed className=\"h-3.5 w-3.5 animate-spin\" />;\n    case \"reconnecting\":\n      return <RefreshCw className=\"h-3.5 w-3.5 animate-spin\" />;\n    case \"disconnected\":\n      return <WifiOff className=\"h-3.5 w-3.5\" />;\n    case \"error\":\n      return <WifiOff className=\"h-3.5 w-3.5\" />;\n    case \"connected\":\n      return <CheckCircle2 className=\"h-3.5 w-3.5\" />;\n  }\n}\n\nfunction StatusLabel({\n  status,\n  onRetry,\n}: {\n  status: ConvexConnectionStatus;\n  onRetry: () => void;\n}) {\n  switch (status) {\n    case \"connecting\":\n      return <span>Connecting...</span>;\n    case \"reconnecting\":\n      return (\n        <span className=\"flex items-center gap-1.5\">\n          Reconnecting\n          <button\n            type=\"button\"\n            onClick={(e) => {\n              e.stopPropagation();\n              onRetry();\n            }}\n            className=\"underline hover:no-underline\"\n          >\n            Retry now\n          </button>\n        </span>\n      );\n    case \"disconnected\":\n      return <span>Disconnected</span>;\n    case \"error\":\n      return (\n        <span className=\"flex items-center gap-1.5\">\n          Connection error\n          <button\n            type=\"button\"\n            onClick={(e) => {\n              e.stopPropagation();\n              onRetry();\n            }}\n            className=\"underline hover:no-underline\"\n          >\n            Retry\n          </button>\n        </span>\n      );\n    case \"connected\":\n      return <span>Connected</span>;\n  }\n}\n\nexport function ConnectionBanner() {\n  const { status, isReconnecting, retry } = useConvexStatus();\n\n  if (status === \"connected\") {\n    return null;\n  }\n\n  return (\n    <div\n      className={cn(\n        \"fixed bottom-0 left-0 right-0 z-50 flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium\",\n        status === \"error\" && \"bg-destructive text-destructive-foreground\",\n        status === \"disconnected\" && \"bg-muted text-muted-foreground\",\n        status === \"connecting\" && \"bg-primary/10 text-primary\",\n        status === \"reconnecting\" && \"bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300\",\n      )}\n    >\n      <StatusIcon status={status} />\n      <StatusLabel status={status} onRetry={retry} />\n    </div>\n  );\n}\n","filePath":"/Users/smaluk/dev/personal/chronotunes/src/components/ui/network-status.tsx"},"output":"Wrote file successfully.\n\nLSP errors detected in other files:\n<diagnostics file=\"/Users/smaluk/dev/personal/chronotunes/src/components/ui/skeletons.tsx\">\nERROR [48:46] Avoid using the index of an array as key property in an element.\nERROR [61:32] Avoid using the index of an array as key property in an element.\nERROR [119:38] Avoid using the index of an array as key property in an element.\nERROR [153:35] Avoid using the index of an array as key property in an element.\nERROR [176:38] Avoid using the index of an array as key property in an element.\n</diagnostics>\n\nLSP errors detected in other files:\n<diagnostics file=\"/Users/smaluk/dev/personal/chronotunes/src/lib/hooks/use-convex-status.ts\">\nERROR [3:34] '\"convex/react\"' has no exported member named 'useConvexReactClient'. Did you mean 'ConvexReactClient'?\n</diagnostics>","title":"src/components/ui/network-status.tsx","metadata":{"diagnostics":{"/Users/smaluk/dev/personal/chronotunes/convex/schema.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/lib/utils.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/components/ui/spinner.tsx":[{"code":"assist/source/organizeImports","codeDescription":{"href":"https://biomejs.dev/assist/actions/organize-imports"},"message":"The imports and exports are not sorted.","range":{"end":{"character":33,"line":0},"start":{"character":0,"line":0}},"severity":3,"source":"biome"}],"/Users/smaluk/dev/personal/chronotunes/src/components/game/PlayersBar.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/CurrentRoundPanel.tsx":[{"range":{"start":{"line":135,"character":16},"end":{"line":135,"character":40}},"message":"'_turnPlayerTimelineEntry' is declared but its value is never read.","severity":4,"code":6133,"source":"typescript"},{"range":{"start":{"line":136,"character":16},"end":{"line":136,"character":44}},"message"