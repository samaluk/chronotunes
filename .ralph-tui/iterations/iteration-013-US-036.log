           track={track}\n00143|               resolution={resolution}\n00144|               turnPlayer={turnPlayer}\n00145|               bets={[]}\n00146|               players={players}\n00147|               me={me ?? null}\n00148|             />\n00149|           );\n00150|         }\n00151|         return (\n00152|           <div className=\"flex flex-col items-center justify-center py-12 space-y-4\">\n00153|             <div className=\"flex h-16 w-16 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/30\">\n00154|               <Music className=\"h-8 w-8 text-green-600 dark:text-green-400\" />\n00155|             </div>\n00156|             <div className=\"text-center space-y-2\">\n00157|               <p className=\"text-lg font-medium\">Round Results</p>\n00158|               <p className=\"text-sm text-muted-foreground\">\n00159|                 The song has been revealed and results are in!\n00160|               </p>\n00161|             </div>\n00162|             {track && (\n00163|               <div className=\"mt-4 p-4 rounded-lg bg-card border max-w-md w-full text-center\">\n00164|                 <p className=\"text-sm text-muted-foreground\">The song was</p>\n00165|                 <p className=\"text-xl font-bold mt-1\">\n00166|                   {track.title} - {track.artist} ({track.year})\n00167|                 </p>\n00168|               </div>\n00169|             )}\n00170|           </div>\n00171|         );\n00172| \n00173|       default:\n00174|         return (\n00175|           <div className=\"flex flex-col items-center justify-center py-12\">\n00176|             <p className=\"text-muted-foreground\">Waiting for round to start...</p>\n00177|           </div>\n00178|         );\n00179|     }\n00180|   };\n00181| \n00182|   return (\n00183|     <div className=\"w-full\">\n00184|       <div className=\"rounded-xl bg-card border overflow-hidden\">\n00185|         <div className=\"px-4 py-3 border-b bg-muted/50\">\n00186