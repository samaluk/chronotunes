{"type":"tool_use","timestamp":1768789465976,"sessionID":"ses_42bf06b73fferOyRzWXGUvK9Pd","part":{"id":"prt_bd41159b100155IfDZ9W7ZLgpk","sessionID":"ses_42bf06b73fferOyRzWXGUvK9Pd","messageID":"msg_bd4114ef3001LldDGe7CzuHFM9","type":"tool","callID":"call_function_rf1nyos33mdq_1","tool":"read","state":{"status":"completed","input":{"filePath":"/Users/smaluk/dev/personal/chronotunes/node_modules/@convex-dev/presence/dist/client/index.js"},"output":"<file>\n00001| export class Presence {\n00002|     component;\n00003|     /**\n00004|      * The Presence component tracks the presence of users in a room.\n00005|      * A \"room\" is a unit of presence state, e.g., a chat room, document, game\n00006|      * etc. Rooms need a unique string ID that in many applications will just be a\n00007|      * Convex ID.\n00008|      *\n00009|      * See [../react/index.ts](../react/index.ts) for the usePresence hook that\n00010|      * maintains presence in a client-side React component and\n00011|      * [public.ts](../component/public.ts) for the implementation of these\n00012|      * functions.\n00013|      */\n00014|     constructor(component) {\n00015|         this.component = component;\n00016|     }\n00017|     /**\n00018|      * ============================================================================\n00019|      * MAIN PRESENCE FUNCTIONS\n00020|      * ============================================================================\n00021|      *\n00022|      * These functions are the core API for maintaining presence state.\n00023|      * They will typically be exposed directly to end users, with heartbeat\n00024|      * wrapped in authentication.\n00025|      */\n00026|     /**\n00027|      * Keepalive heartbeat mutation. Session ID must be unique for a given\n00028|      * room/user. Interval is the time between heartbeats. User will be\n00029|      * disconnected if no heartbeat is received for 2.5x the interval or if a\n00030|      * graceful disconnect message is received. Returns room and session tokens.\n00031|      */\n00032|     async heartbeat(ctx, roomId, userId, sessionId, interval) {\n00033|         return ctx.runMutation(this.component.public.heartbeat, {\n00034|             roomId,\n00035|             userId,\n00036|             sessionId,\n00037|             interval,\n00038|         });\n00039|     }\n00040|     /**\n00041|      * List presence state for all users in the room, up to the limit of users.\n00042|      */\n00043|     async list(ctx, roomToken, limit = 104) {\n00044|         return ctx.runQuery(this.component.public.list, {\n00045|             roomToken,\n00046|             limit,\n00047|         });\n00048|     }\n00049|     /**\n00050|      * Updates a users presence data in a room.\n00051|      */\n00052|     async updateRoomUser(ctx, roomId, userId, data) {\n00053|         return ctx.runMutation(this.component.public.updateRoomUser, {\n00054|             roomId,\n00055|             userId,\n00056|             data,\n00057|         });\n00058|     }\n00059|     // Gracefully disconnect a user.\n00060|     async disconnect(ctx, sessionToken) {\n00061|         return ctx.runMutation(this.component.public.disconnect, { sessionToken });\n00062|     }\n00063|     /**\n00064|      * ============================================================================\n00065|      * HELPERS AND MAINTENANCE FUNCTIONS\n00066|      * ============================================================================\n00067|      *\n00068|      * These functions are convenient to use within your parent application but\n00069|      * don't include their own authentication so you should be careful about exposing\n00070|      * them directly to end users.\n00071|      */\n00072|     /**\n00073|      * List all users in a room.\n00074|      */\n00075|     async listRoom(ctx, roomId, onlineOnly = false, // only show users online in the room\n00076|     limit = 104) {\n00077|         return ctx.runQuery(this.component.public.listRoom, {\n00078|             roomId,\n00079|             onlineOnly,\n00080|             limit,\n00081|         });\n00082|     }\n00083|     /**\n00084|      * List all rooms a user is in.\n00085|      */\n00086|     async listUser(ctx, userId, onlineOnly = false, // only show rooms the user is online in\n00087|     limit = 104) {\n00088|         return ctx.runQuery(this.component.public.listUser, {\n00089|             userId,\n00090|             onlineOnly,\n00091|             limit,\n00092|         });\n00093|     }\n00094|     /**\n00095|      * Remove a user from a room.\n00096|      */\n00097|     async removeRoomUser(ctx, roomId, userId) {\n00098|         return ctx.runMutation(this.component.public.removeRoomUser, {\n00099|             roomId,\n00100|             userId,\n00101|         });\n00102|     }\n00103|     /**\n00104|      * Remove a room.\n00105|      */\n00106|     async removeRoom(ctx, roomId) {\n00107|         return ctx.runMutation(this.component.public.removeRoom, { roomId });\n00108|     }\n00109| }\n00110| //# sourceMappingURL=index.js.map\n\n(End of file - total 110 lines)\n</file>","title":"node_modules/@convex-dev/presence/dist/client/index.js","metadata":{"preview":"export class Presence {\n    component;\n    /**\n     * The Presence component tracks the presence of users in a room.\n     * A \"room\" is a unit of presence state, e.g., a chat room, document, game\n     * etc. Rooms need a unique string ID that in many applications will just be a\n     * Convex ID.\n     *\n     * See [../react/index.ts](../react/index.ts) for the usePresence hook that\n     * maintains presence in a client-side React component and\n     * [public.ts](../component/public.ts) for the implementation of these\n     * functions.\n     */\n    constructor(component) {\n        this.component = component;\n    }\n    /**\n     * ============================================================================\n     * MAIN PRESENCE FUNCTIONS\n     * ============================================================================","truncated":false},"time":{"start":1768789465975,"end":1768789465976}}}}
