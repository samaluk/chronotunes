{"type":"tool_use","timestamp":1768789745320,"sessionID":"ses_42bf06b73fferOyRzWXGUvK9Pd","part":{"id":"prt_bd4158a18001U699bkLV7gzG4T","sessionID":"ses_42bf06b73fferOyRzWXGUvK9Pd","messageID":"msg_bd415784b001YLJOA2JlDOTfAc","type":"tool","callID":"call_function_e9cxkyhwnm2c_1","tool":"write","state":{"status":"completed","input":{"content":"\"use client\";\n\nimport { Circle } from \"lucide-react\";\nimport { cn } from \"@/lib/utils\";\n\ninterface PresenceIndicatorProps {\n  online: boolean;\n  className?: string;\n  size?: \"sm\" | \"md\" | \"lg\";\n  showPulse?: boolean;\n}\n\nconst sizeClasses = {\n  sm: \"h-2 w-2\",\n  md: \"h-3 w-3\",\n  lg: \"h-4 w-4\",\n};\n\nconst pulseSizeClasses = {\n  sm: \"h-2 w-2\",\n  md: \"h-3 w-3\",\n  lg: \"h-4 w-4\",\n};\n\nexport function PresenceIndicator({\n  online,\n  className,\n  size = \"md\",\n  showPulse = true,\n}: PresenceIndicatorProps): React.ReactNode {\n  return (\n    <span className={cn(\"relative inline-flex\", className)}>\n      {showPulse && online && (\n        <span\n          className={cn(\n            \"absolute inline-flex h-full w-full animate-ping rounded-full opacity-75\",\n            pulseSizeClasses[size],\n            \"bg-green-400\",\n          )}\n        />\n      )}\n      <Circle\n        className={cn(\n          \"relative inline-flex rounded-full\",\n          sizeClasses[size],\n          online\n            ? \"fill-green-500 text-green-500\"\n            : \"fill-muted text-muted-foreground\",\n        )}\n      />\n    </span>\n  );\n}\n","filePath":"/Users/smaluk/dev/personal/chronotunes/src/components/game/PresenceIndicator.tsx"},"output":"Wrote file successfully.","title":"src/components/game/PresenceIndicator.tsx","metadata":{"diagnostics":{"/Users/smaluk/dev/personal/chronotunes/convex/schema.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/lobbies.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/convex.config.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/lib