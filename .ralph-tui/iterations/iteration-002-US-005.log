{"type":"tool_use","timestamp":1768789612961,"sessionID":"ses_42bf06b73fferOyRzWXGUvK9Pd","part":{"id":"prt_bd41369e1001p3SQtfNrKm4hhz","sessionID":"ses_42bf06b73fferOyRzWXGUvK9Pd","messageID":"msg_bd4135ac7001EBBj0Emky65ZIi","type":"tool","callID":"call_function_iwnjdhp6u99x_1","tool":"write","state":{"status":"completed","input":{"content":"\"use client\";\n\nimport { useEffect, useRef, useState, useMemo } from \"react\";\nimport { useQuery, useMutation, useConvex } from \"convex/react\";\nimport { api } from \"@/convex/_generated/api\";\n\ninterface PresenceState {\n  userId: string;\n  online: boolean;\n  lastDisconnected: number;\n  data?: unknown;\n}\n\ninterface UsePresenceOptions {\n  roomId: string;\n  userId: string;\n  interval?: number;\n}\n\nexport function usePresence({\n  roomId,\n  userId,\n  interval = 15000,\n}: UsePresenceOptions): PresenceState[] | null | undefined {\n  const convex = useConvex();\n  const hasMounted = useRef(false);\n  const intervalRef = useRef<ReturnType<typeof setInterval> | null>(null);\n\n  const [sessionId, setSessionId] = useState(() => crypto.randomUUID());\n  const [roomToken, setRoomToken] = useState<string | null>(null);\n  const [sessionToken, setSessionToken] = useState<string | null>(null);\n\n  const heartbeat = useMutation(api.presence.sendHeartbeat);\n  const disconnect = useMutation(api.presence.disconnectPresence);\n  const baseUrl = convex.url;\n\n  useEffect(() => {\n    if (intervalRef.current) {\n      clearInterval(intervalRef.current);\n      intervalRef.current = null;\n    }\n    if (sessionToken) {\n      void disconnect({ sessionToken });\n    }\n    setSessionId(crypto.randomUUID());\n    setRoomToken(null);\n    setSessionToken(null);\n  }, [roomId, userId, disconnect, sessionToken]);\n\n  useEffect(() => {\n    const sendHeartbeat = async () => {\n      try {\n        const result = await heartbeat({\n          roomId,\n          userId,\n          sessionId,\n          interval,\n        });\n        setRoomToken(result.roomToken);\n        setSessionToken(result.sessionToken);\n      } catch (error) {\n        console.error(\"Heartbeat failed:\", error);\n      }\n    };\n\n    void sendHeartbeat();\n\n    intervalRef.current = setInterval(sendHeartbeat, interval);\n\n    const handleUnload = () => {\n      if (sessionToken) {\n        const blob = new Blob(\n          [\n            JSON.stringify({\n              path: \"presence:disconnectPresence\",\n              args: { sessionToken },\n            }),\n          ],\n          { type: \"application/json\" },\n        );\n        navigator.sendBeacon(`${baseUrl}/api/mutation`, blob);\n      }\n    };\n\n    window.addEventListener(\"beforeunload\", handleUnload);\n\n    const handleVisibility = async () => {\n      if (document.hidden) {\n        if (intervalRef.current) {\n          clearInterval(intervalRef.current);\n          intervalRef.current = null;\n        }\n        if (sessionToken) {\n          await disconnect({ sessionToken });\n        }\n      } else {\n        void sendHeartbeat();\n        if (intervalRef.current) {\n          clearInterval(intervalRef.current);\n        }\n        intervalRef.current = setInterval(sendHeartbeat, interval);\n      }\n    };\n\n    document.addEventListener(\"visibilitychange\", handleVisibility);\n\n    return () => {\n      if (intervalRef.current) {\n        clearInterval(intervalRef.current);\n      }\n      document.removeEventListener(\"visibilitychange\", handleVisibility);\n      window.removeEventListener(\"beforeunload\", handleUnload);\n\n      if (hasMounted.current && sessionToken) {\n        void disconnect({ sessionToken });\n      }\n    };\n  }, [heartbeat, disconnect, roomId, userId, baseUrl, interval, sessionId, roomToken]);\n\n  useEffect(() => {\n    hasMounted.current = true;\n  }, []);\n\n  const state = useQuery(\n    api.presence.getPresenceList,\n    roomToken ? { roomToken } : \"skip\",\n  );\n\n  return useMemo(() => {\n    if (!state) return state;\n    return state\n      .slice()\n      .sort((a, b) => {\n        if (a.userId === userId) return -1;\n        if (b.userId === userId) return 1;\n        return 0;\n      });\n  }, [state, userId]);\n}\n\nexport function useIsOnline(\n  userId: string,\n  presence: PresenceState[] | null | undefined,\n): boolean {\n  const myPresence = presence?.find((p) => p.userId === userId);\n  return myPresence?.online ?? false;\n}\n","filePath":"/Users/smaluk/dev/personal/chronotunes/src/lib/hooks/usePresence.ts"},"output":"Wrote file successfully.\n\nLSP errors detected in this file, please fix:\n<diagnostics file=\"/Users/smaluk/dev/personal/chronotunes/src/lib/hooks/usePresence.ts\">\nERROR [37:3] This hook specifies more dependencies than necessary: roomId, userId.\nERROR [50:3] This hook does not specify its dependency on sessionToken.\nERROR [50:3] This hook specifies more dependencies than necessary: roomToken.\n</diagnostics>","title":"src/lib/hooks/usePresence.ts","metadata":{"diagnostics":{"/Users/smaluk/dev/personal/chronotunes/convex/schema.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/lobbies.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/convex.config.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/lib/sessionWrapper.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/app/lobby/[code]/LobbyPageContent.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/lib/hooks/use-session-id.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/players.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/components/lobby/PlayerList.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/lib/session.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/presence.ts":[],"/Users/smaluk/dev/personal/chronotunes/node_modules/@convex-dev/presence/dist/client/index.js":[],"/Users/smaluk/dev/personal/chronotunes/node_modules/@convex-dev/presence/dist/component/public.js":[],"/Users/smaluk/dev/personal/chronotunes/convex/_generated/api.d.ts":[