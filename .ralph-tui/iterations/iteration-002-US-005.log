ve);\n00034| \n00035|   useEffect(() => {\n00036|     setMounted(true);\n00037|   }, []);\n00038| \n00039|   useEffect(() => {\n00040|     if (mounted && lobby === null && code) {\n00041|       toast.error(\"Lobby not found\");\n00042|       router.push(\"/\");\n00043|     }\n00044|   }, [mounted, lobby, code, router]);\n00045| \n00046|   const handleCopyCode = (): void => {\n00047|     navigator.clipboard.writeText(code);\n00048|     toast.success(\"Lobby code copied to clipboard\");\n00049|   };\n00050| \n00051|   const handleShare = async (): Promise<void> => {\n00052|     if (navigator.share) {\n00053|       try {\n00054|         await navigator.share({\n00055|           title: \"ChronoTunes Game\",\n00056|           text: `Join my ChronoTunes game with code: ${code}`,\n00057|           url: window.location.href,\n00058|         });\n00059|       } catch (error) {\n00060|         if ((error as Error).name !== \"AbortError\") {\n00061|           handleCopyCode();\n00062|         }\n00063|       }\n00064|     } else {\n00065|       handleCopyCode();\n00066|     }\n00067|   };\n00068| \n00069|   const handleLeaveLobby = async (): Promise<void> => {\n00070|     if (!sessionId) return;\n00071|     try {\n00072|       await leaveLobby({ code, sessionId });\n00073|       toast.success(\"Left lobby\");\n00074|       router.push(\"/\");\n00075|     } catch (error) {\n00076|       const message = error instanceof Error ? error.message : \"Failed to leave lobby\";\n00077|       toast.error(message);\n00078|     }\n00079|   };\n00080| \n00081|   if (!mounted) {\n00082|     return (\n00083|       <div className=\"flex min-h-screen items-center justify-center bg-background\">\n00084|         <div className=\"text-center\">\n00085|           <div className=\"animate-spin rounded-full h-8 w-8 border-b-2 border-primary mx-auto\"></div>\n00086|           <p className=\"mt-4 text-muted-foreground\">Loading...</p>\n00087|         </div>\n00088|       </div>\n00089|     );\n00090|  