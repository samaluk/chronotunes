{"type":"tool_use","timestamp":1768789365694,"sessionID":"ses_42bf06b73fferOyRzWXGUvK9Pd","part":{"id":"prt_bd40fd2e8001Sbw9s0Yuuo9jtE","sessionID":"ses_42bf06b73fferOyRzWXGUvK9Pd","messageID":"msg_bd40fc582001PklkphYyU09T20","type":"tool","callID":"call_function_g2ckd6gknze5_2","tool":"read","state":{"status":"completed","input":{"filePath":"/Users/smaluk/dev/personal/chronotunes/convex/lobbies.ts"},"output":"<file>\n00001| import { ConvexError, v } from \"convex/values\";\n00002| import { mutation, query } from \"./_generated/server\";\n00003| \n00004| const LOBBY_CODE_CHARS = \"ABCDEFGHJKLMNPQRSTUVWXYZ23456789\";\n00005| const LOBBY_CODE_LENGTH = 6;\n00006| \n00007| const DEFAULT_SETTINGS = {\n00008|   targetTimelineSize: 10,\n00009|   startingCoins: 3,\n00010|   turnSeconds: 30,\n00011|   bettingWindowSeconds: 15,\n00012|   allowGuessTitleArtist: true,\n00013|   showLiveBets: true,\n00014|   allowBetRetraction: true,\n00015|   minYear: 1950,\n00016|   maxYear: 2025,\n00017| } as const;\n00018| \n00019| function generateLobbyCode(): string {\n00020|   let code = \"\";\n00021|   const randomValues = new Uint8Array(LOBBY_CODE_LENGTH);\n00022|   crypto.getRandomValues(randomValues);\n00023|   for (let i = 0; i < LOBBY_CODE_LENGTH; i++) {\n00024|     const rawIndex = randomValues[i];\n00025|     if (rawIndex === undefined) {\n00026|       throw new Error(\"Failed to generate random values\");\n00027|     }\n00028|     const index = rawIndex % LOBBY_CODE_CHARS.length;\n00029|     code += LOBBY_CODE_CHARS[index];\n00030|   }\n00031|   return code;\n00032| }\n00033| \n00034| export const create = mutation({\n00035|   args: {\n00036|     sessionId: v.string(),\n00037|     displayName: v.string(),\n00038|   },\n00039|   handler: async (ctx, args) => {\n00040|     const { sessionId, displayName } = args;\n00041| \n00042|     if (displayName.length < 1 || displayName.length > 20) {\n00043|       throw new ConvexError(\"Display name must be between 1 and 20 characters\");\n00044|     }\n00045| \n00046|     let code: string;\n00047|     const maxAttempts = 10;\n00048|     for (let attempt = 0; attempt < maxAttempts; attempt++) {\n00049|       code = generateLobbyCode();\n00050|       const existing = await ctx.db\n00051|         .query(\"lobbies\")\n00052|         .filter((q) => q.eq(q.field(\"code\"), code))\n00053|         .first();\n00054|       if (!existing) {\n00055|         break;\n00056|       }\n00057|       if (attempt === maxAttempts - 1) {\n00058|         throw new ConvexError(\"Failed to generate unique lobby code\");\n00059|       }\n00060|     }\n00061| \n00062|     const lobbyId = await ctx.db.insert(\"lobbies\", {\n00063|       code: code!,\n00064|       hostSessionId: sessionId,\n00065|       status: \"lobby\",\n00066|       settings: DEFAULT_SETTINGS,\n00067|     });\n00068| \n00069|     await ctx.db.insert(\"players\", {\n00070|       lobbyId,\n00071|       sessionId,\n00072|       displayName,\n00073|       isHost: true,\n00074|       coins: DEFAULT_SETTINGS.startingCoins,\n00075|       timeline: [],\n00076|       timelineSize: 0,\n00077|       createdAt: Date.now(),\n00078|     });\n00079| \n00080|     return { code: code! };\n00081|   },\n00082| });\n00083| \n00084| export const join = mutation({\n00085|   args: {\n00086|     code: v.string(),\n00087|     sessionId: v.string(),\n00088|     displayName: v.string(),\n00089|   },\n00090|   handler: async (ctx, args) => {\n00091|     const { code, sessionId, displayName } = args;\n00092| \n00093|     if (displayName.length < 1 || displayName.length > 20) {\n00094|       throw new ConvexError(\"Display name must be between 1 and 20 characters\");\n00095|     }\n00096| \n00097|     const lobby = await ctx.db\n00098|       .query(\"lobbies\")\n00099|       .filter((q) => q.eq(q.field(\"code\"), code.toUpperCase()))\n00100|       .first();\n00101| \n00102|     if (!lobby) {\n00103|       throw new ConvexError(\"Lobby not found\");\n00104|     }\n00105| \n00106|     if (lobby.status !== \"lobby\") {\n00107|       throw new ConvexError(\"Cannot join lobby that is not in lobby status\");\n00108|     }\n00109| \n00110|     const existingPlayer = await ctx.db\n00111|       .query(\"players\")\n00112|       .filter((q) =>\n00113|         q.and(q.eq(q.field(\"lobbyId\"), lobby._id), q.eq(q.field(\"sessionId\"), sessionId)),\n00114|       )\n00115|       .first();\n00116| \n00117|     if (existingPlayer) {\n00118|       throw new ConvexError(\"You are already in this lobby\");\n00119|     }\n00120| \n00121|     await ctx.db.insert(\"players\", {\n00122|       lobbyId: lobby._id,\n00123|       sessionId,\n00124|       displayName,\n00125|       isHost: false,\n00126|       coins: lobby.settings.startingCoins,\n00127|       timeline: [],\n00128|       timelineSize: 0,\n00129|       createdAt: Date.now(),\n00130|     });\n00131| \n00132|     return { lobbyId: lobby._id };\n00133|   },\n00134| });\n00135| \n00136| export const leave = mutation({\n00137|   args: {\n00138|     code: v.string(),\n00139|     sessionId: v.string(),\n00140|   },\n00141|   handler: async (ctx, args) => {\n00142|     const { code, sessionId } = args;\n00143| \n00144|     const lobby = await ctx.db\n00145|       .query(\"lobbies\")\n00146|       .filter((q) => q.eq(q.field(\"code\"), code.toUpperCase()))\n00147|       .first();\n00148| \n00149|     if (!lobby) {\n00150|       throw new ConvexError(\"Lobby not found\");\n00151|     }\n00152| \n00153|     const player = await ctx.db\n00154|       .query(\"players\")\n00155|       .filter((q) =>\n00156|         q.and(q.eq(q.field(\"lobbyId\"), lobby._id), q.eq(q.field(\"sessionId\"), sessionId)),\n00157|       )\n00158|       .first();\n00159| \n00160|     if (!player) {\n00161|       throw new ConvexError(\"You are not in this lobby\");\n00162|     }\n00163| \n00164|     await ctx.db.delete(player._id);\n00165| \n00166|     if (player.isHost) {\n00167|       const remainingPlayers = await ctx.db\n00168|         .query(\"players\")\n00169|         .filter((q) => q.eq(q.field(\"lobbyId\"), lobby._id))\n00170|         .collect();\n00171| \n00172|       if (remainingPlayers.length === 0) {\n00173|         await ctx.db.delete(lobby._id);\n00174|       } else {\n00175|         const newHost = remainingPlayers[0]!;\n00176|         await ctx.db.patch(newHost._id, { isHost: true });\n00177|         await ctx.db.patch(lobby._id, { hostSessionId: newHost.sessionId });\n00178|       }\n00179|     }\n00180|   },\n00181| });\n00182| \n00183| export const get = query({\n00184|   args: { code: v.string() },\n00185|   handler: async (ctx, args) => {\n00186|     const { code } = args;\n00187| \n00188|     const lobby = await ctx.db\n00189|       .query(\"lobbies\")\n00190|       .filter((q) => q.eq(q.field(\"code\"), code.toUpperCase()))\n00191|       .first();\n00192| \n00193|     return lobby;\n00194|   },\n00195| });\n00196| \n00197| const lobbySettingsValidator = v.object({\n00198|   targetTimelineSize: v.number(),\n00199|   startingCoins: v.number(),\n00200|   turnSeconds: v.number(),\n00201|   bettingWindowSeconds: v.number(),\n00202|   allowGuessTitleArtist: v.boolean(),\n00203|   showLiveBets: v.boolean(),\n00204|   allowBetRetraction: v.boolean(),\n00205|   minYear: v.number(),\n00206|   maxYear: v.number(),\n00207| });\n00208| \n00209| export const updateSettings = mutation({\n00210|   args: {\n00211|     code: v.string(),\n00212|     sessionId: v.string(),\n00213|     settings: lobbySettingsValidator,\n00214|   },\n00215|   handler: async (ctx, args) => {\n00216|     const { code, sessionId, settings } = args;\n00217| \n00218|     const lobby = await ctx.db\n00219|       .query(\"lobbies\")\n00220|       .filter((q) => q.eq(q.field(\"code\"), code.toUpperCase()))\n00221|       .first();\n00222| \n00223|     if (!lobby) {\n00224|       throw new ConvexError(\"Lobby not found\");\n00225|     }\n00226| \n00227|     if (lobby.hostSessionId !== sessionId) {\n00228|       throw new ConvexError(\