d ${MAX_YEAR}`);\n00046|   }\n00047| \n00048|   if (item.youtubeVideoId !== undefined && item.youtubeVideoId.trim().length === 0) {\n00049|     throw new ConvexError(\"YouTube video ID must be a non-empty string if provided\");\n00050|   }\n00051| \n00052|   if (item.mbid !== undefined && item.mbid.trim().length === 0) {\n00053|     throw new ConvexError(\"MusicBrainz ID must be a non-empty string if provided\");\n00054|   }\n00055| \n00056|   if (item.durationMs !== undefined && item.durationMs < 0) {\n00057|     throw new ConvexError(\"Duration must be a non-negative number if provided\");\n00058|   }\n00059| }\n00060| \n00061| export const importTracks = mutation({\n00062|   args: { tracks: v.array(trackImportItem) },\n00063|   handler: async (ctx, args) => {\n00064|     const { tracks } = args;\n00065| \n00066|     if (tracks.length === 0) {\n00067|       throw new ConvexError(\"At least one track must be provided\");\n00068|     }\n00069| \n00070|     if (tracks.length > 1000) {\n00071|       throw new ConvexError(\"Cannot import more than 1000 tracks at once\");\n00072|     }\n00073| \n00074|     const importedIds: string[] = [];\n00075|     const now = Date.now();\n00076| \n00077|     for (const track of tracks) {\n00078|       validateTrackItem(track);\n00079| \n00080|       const trackId = await ctx.db.insert(\"tracks\", {\n00081|         title: track.title.trim(),\n00082|         artist: track.artist.trim(),\n00083|         year: track.year,\n00084|         externalIds: {\n00085|           ...(track.youtubeVideoId ? { youtubeVideoId: track.youtubeVideoId.trim() } : {}),\n00086|         },\n00087|         links: {},\n00088|         createdAt: now,\n00089|         source: \"import\",\n00090|         ...(track.mbid ? { mbid: track.mbid.trim() } : {}),\n00091|         ...(track.durationMs !== undefined ? { durationMs: track.durationMs } : {}),\n00092|       });\n00093| \n00094|       importedIds.push(trackId);\n00095|     }\n00096| \n00097|     return { importedCount: importedIds.length, trackIds: importedIds };\n00098|   },\n00099| });\n00100| \n\n(End of file - total 100 lines)\n</file>","title":"convex/tracks.ts","metadata":{"preview":"import { ConvexError, v } from \"convex/values\";\nimport { mutation, query } from \"./_generated/server\";\n\nconst MIN_YEAR = 1900;\nconst MAX_YEAR = 2030;\n\nexport const get = query({\n  args: { trackIds: v.array(v.id(\"tracks\")) },\n  handler: async (ctx, args) => {\n    const { trackIds } = args;\n\n    const tracks = await Promise.all(trackIds.map((trackId) => ctx.db.get(trackId)));\n\n    return tracks;\n  },\n});\n\nexport const list = query({\n  args: {},\n  handler: async (ctx) => {","truncated":false},"time":{"start":1768791213201,"end":1768791213202}}}}
