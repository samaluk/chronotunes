  sessionId: v.string(),\n00102|     displayName: v.string(),\n00103|     isHost: v.boolean(),\n00104|     coins: v.number(),\n00105|     timeline: v.array(timelineEntry),\n00106|     timelineSize: v.number(),\n00107|     createdAt: v.number(),\n00108|   })\n00109|     .index(\"by_lobby\", [\"lobbyId\"])\n00110|     .index(\"by_lobby_and_session\", [\"lobbyId\", \"sessionId\"]),\n00111| \n00112|   // Games table\n00113|   games: defineTable({\n00114|     lobbyId: v.id(\"lobbies\"),\n00115|     status: gameStatus,\n00116|     startedAt: v.number(),\n00117|     endedAt: v.optional(v.number()),\n00118|     currentRoundNumber: v.number(),\n00119|     currentRoundId: v.optional(v.id(\"rounds\")),\n00120|     turnPlayerId: v.optional(v.id(\"players\")),\n00121|     turnOrder: v.array(v.id(\"players\")),\n00122|     winnerPlayerId: v.optional(v.id(\"players\")),\n00123|   }).index(\"by_lobby\", [\"lobbyId\"]),\n00124| \n00125|   // Rounds table\n00126|   rounds: defineTable({\n00127|     gameId: v.id(\"games\"),\n00128|     roundNumber: v.number(),\n00129|     turnPlayerId: v.id(\"players\"),\n00130|     trackId: v.id(\"tracks\"),\n00131|     phase: roundPhase,\n00132|     startedAt: v.number(),\n00133|     placementPreview: v.optional(placementPreview),\n00134|     placement: v.optional(placement),\n00135|     guess: v.optional(guess),\n00136|     resolution: v.optional(resolution),\n00137|   }).index(\"by_game\", [\"gameId\"]),\n00138| \n00139|   // RoundBets table\n00140|   roundBets: defineTable({\n00141|     roundId: v.id(\"rounds\"),\n00142|     playerId: v.id(\"players\"),\n00143|     proposedIndex: v.number(),\n00144|     placedAt: v.number(),\n00145|     lockedIn: v.boolean(),\n00146|     status: betStatus,\n00147|   })\n00148|     .index(\"by_round\", [\"roundId\"])\n00149|     .index(\"by_round_and_player\", [\"roundId\", \"playerId\"]),\n00150| \n00151|   // Tracks table\n00152|   tracks: defineTable({\n00153|     mbid: v.optional(v.string()),\n00154|     title