urrentRoundId);\n00054| \n00055|     if (!round) {\n00056|       return null;\n00057|     }\n00058| \n00059|     const track = await ctx.db.get(round.trackId);\n00060| \n00061|     if (!track) {\n00062|       return null;\n00063|     }\n00064| \n00065|     return {\n00066|       trackId: track._id,\n00067|       title: track.title,\n00068|       artist: track.artist,\n00069|       year: track.year,\n00070|       durationMs: track.durationMs,\n00071|       mbid: track.mbid,\n00072|       externalIds: track.externalIds,\n00073|       links: track.links,\n00074|       source: track.source,\n00075|     };\n00076|   },\n00077| });\n00078| \n00079| export const getPublic = query({\n00080|   args: { roundId: v.id(\"rounds\") },\n00081|   handler: async (ctx, args) => {\n00082|     const { roundId } = args;\n00083| \n00084|     const round = await ctx.db.get(roundId);\n00085| \n00086|     if (!round) {\n00087|       return null;\n00088|     }\n00089| \n00090|     if (round.phase !== \"resolved\") {\n00091|       return null;\n00092|     }\n00093| \n00094|     const track = await ctx.db.get(round.trackId);\n00095| \n00096|     if (!track) {\n00097|       return null;\n00098|     }\n00099| \n00100|     return {\n00101|       trackId: track._id,\n00102|       title: track.title,\n00103|       artist: track.artist,\n00104|       year: track.year,\n00105|       youtubeVideoId: track.externalIds.youtubeVideoId ?? null,\n00106|     };\n00107|   },\n00108| });\n00109| \n00110| const trackImportItem = v.object({\n00111|   title: v.string(),\n00112|   artist: v.string(),\n00113|   year: v.number(),\n00114|   youtubeVideoId: v.optional(v.string()),\n00115|   mbid: v.optional(v.string()),\n00116|   durationMs: v.optional(v.number()),\n00117| });\n00118| \n00119| function validateTrackItem(item: (typeof trackImportItem)[\"type\"]): void {\n00120|   if (!item.title || item.title.trim().length === 0) {\n00121|     throw new ConvexError(\"Track title is required\");\n00122|   }\n00123| \n00124|   if (!item.artist || item.artist.trim().length === 0) {\n00125|     throw new ConvexError(\"Track artist is required\");\n00126|   }\n00127| \n00128|   if (item.year < MIN_YEAR || item.year > MAX_YEAR) {\n00129|     throw new ConvexError(`Track year must be between ${MIN_YEAR} and ${MAX_YEAR}`);\n00130|   }\n00131| \n00132|   if (item.youtubeVideoId !== undefined && item.youtubeVideoId.trim().length === 0) {\n00133|     throw new ConvexError(\"YouTube video ID must be a non-empty string if provided\");\n00134|   }\n00135| \n00136|   if (item.mbid !== undefined && item.mbid.trim().length === 0) {\n00137|     throw new ConvexError(\"MusicBrainz ID must be a non-empty string if provided\");\n00138|   }\n00139| \n00140|   if (item.durationMs !== undefined && item.durationMs < 0) {\n00141|     throw new ConvexError(\"Duration must be a non-negative number if provided\");\n00142|   }\n00143| }\n00144| \n00145| export const importTracks = mutation({\n00146|   args: { tracks: v.array(trackImportItem) },\n00147|   handler: async (ctx, args) => {\n00148|     const { tracks } = args;\n00149| \n00150|     if (tracks.length === 0) {\n00151|       throw new ConvexError(\"At least one track must be provided\");\n00152|     }\n00153| \n00154|     if (tracks.length > 1000) {\n00155|       throw new ConvexError(\"Cannot import more than 1000 tracks at once\");\n00156|     }\n00157| \n00158|     const importedIds: string[] = [];\n00159|     const now = Date.now();\n00160| \n00161|     for (const track of tracks) {\n00162|       validateTrackItem(track);\n00163| \n00164|       const trackId = await ctx.db.insert(\"tracks\", {\n00165|         title: track.title.trim(),\n00166|         artist: track.artist.trim(),\n00167|         year: track.year,\n00168|         externalIds: {\n00169|           ...(track.youtubeVideoId ? { youtubeVideoId: track.youtubeVideoId.trim() } : {}),\n00170|         },\n00171|         links: {},\n00172|         createdAt: now,\n00173|         source: \"import\",\n00174|         ...(track.mbid ? { mbid: track.mbid.trim() } : {}),\n00175|         ...(track.durationMs !== undefined ? { durationMs: track.durationMs } : {}),\n00176|       });\n00177| \n00178|       importedIds.push(trackId);\n00179|     }\n00180| \n00181|     return { importedCount: importedIds.length, trackIds: importedIds };\n00182|   },\n00183| });\n00184| \n\n(End of file - total 184 lines)\n</file>","title":"convex/tracks.ts","metadata":{"preview":"import { ConvexError, v } from \"convex/values\";\nimport { mutation, query } from \"./_generated/server\";\n\nconst MIN_YEAR = 1900;\nconst MAX_YEAR = 2030;\n\nexport const get = query({\n  args: { trackIds: v.array(v.id(\"tracks\")) },\n  handler: async (ctx, args) => {\n    const { trackIds } = args;\n\n    const tracks = await Promise.all(trackIds.map((trackId) => ctx.db.get(trackId)));\n\n    return tracks;\n  },\n});\n\nexport const list = query({\n  args: {},\n  handler: async (ctx) => {","truncated":false},"time":{"start":1768791384829,"end":1768791384830}}}}
