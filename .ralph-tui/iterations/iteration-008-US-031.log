sionId: \"host-session-empty\",\n00045|   });\n00046| \n00047|   expect(result).toBeNull();\n00048| });\n00049| \n00050| test(\"getCurrent returns current round for active game\", async () => {\n00051|   const t = convexTest(schema);\n00052| \n00053|   await seedTestData(t);\n00054| \n00055|   const { code } = await t.mutation(api.lobbies.create, {\n00056|     sessionId: \"host-session-current\",\n00057|     displayName: \"HostCurrent\",\n00058|   });\n00059| \n00060|   await t.mutation(api.lobbies.join, {\n00061|     code,\n00062|     sessionId: \"player-session-current\",\n00063|     displayName: \"PlayerCurrent\",\n00064|   });\n00065| \n00066|   const lobby = await t.query(api.lobbies.get, { code });\n00067| \n00068|   await t.mutation(api.games.start, {\n00069|     lobbyId: lobby!._id,\n00070|     sessionId: \"host-session-current\",\n00071|   });\n00072| \n00073|   const result = await t.query(api.rounds.getCurrent, {\n00074|     lobbyId: lobby!._id,\n00075|     sessionId: \"host-session-current\",\n00076|   });\n00077| \n00078|   expect(result).not.toBeNull();\n00079|   expect(result?.phase).toBe(\"placing\");\n00080|   expect(result?.roundNumber).toBe(1);\n00081|   expect(result?.turnPlayerId).toBeDefined();\n00082|   expect(result?.startedAt).toBeDefined();\n00083| });\n00084| \n00085| test(\"getCurrent hides track details during placing phase for non-host\", async () => {\n00086|   const t = convexTest(schema);\n00087| \n00088|   await seedTestData(t);\n00089| \n00090|   const { code } = await t.mutation(api.lobbies.create, {\n00091|     sessionId: \"host-session-hide\",\n00092|     displayName: \"HostHide\",\n00093|   });\n00094| \n00095|   await t.mutation(api.lobbies.join, {\n00096|     code,\n00097|     sessionId: \"player-session-hide\",\n00098|     displayName: \"PlayerHide\",\n00099|   });\n00100| \n00101|   const lobby = await t.query(api.lobbies.get, { code });\n00102| \n00103|   await t.mutation(api.games.start, {\n00104|     lobbyId: lobby!._id,\n00105|     sessionId: \"host-session-hide\",\n00106|   });\n00107| \n00108|   const result = await t.query(api.rounds.getCurrent, {\n00109|     lobbyId: lobby!._id,\n00110|     sessionId: \"player-session-hide\",\n00111|   });\n00112| \n00113|   if (!result) throw new Error(\"Result is null\");\n00114|   if (!result.track) throw new Error(\"Result is null\");\n00115|   expect(result).not.toBeNull();\n00116|   expect(result?.phase).toBe(\"placing\");\n00117|   expect(result?.track).not.toBeNull();\n00118|   expect(result?.track.trackId).toBeDefined();\n00119|   expect(result?.isHost).toBe(false);\n00120| });\n00121| \n00122| test(\"getCurrent shows track details during placing phase for host\", async () => {\n00123|   const t = convexTest(schema);\n00124| \n00125|   await seedTestData(t);\n00126| \n00127|   const { code } = await t.mutation(api.lobbies.create, {\n00128|     sessionId: \"host-session-show\",\n00129|     displayName: \"HostShow\",\n00130|   });\n00131| \n00132|   await t.mutation(api.lobbies.join, {\n00133|     code,\n00134|     sessionId: \"player-session-show\",\n00135|     displayName: \"PlayerShow\",\n00136|   });\n00137| \n00138|   const lobby = await t.query(api.lobbies.get, { code });\n00139| \n00140|   await t.mutation(api.games.start, {\n00141|     lobbyId: lobby!._id,\n00142|     sessionId: \"host-session-show\",\n00143|   });\n00144| \n00145|   const result = await t.query(api.rounds.getCurrent, {\n00146|     lobbyId: lobby!._id,\n00147|     sessionId: \"host-session-show\",\n00148|   });\n00149| \n00150|   expect(result).not.toBeNull();\n00151|   expect(result?.phase).toBe(\"placing\");\n00152|   expect(result?.track).not.toBeNull();\n00153|   expect(result?.isHost).toBe(true);\n00154| });\n00155| \n00156| test(\"getCurrent includes placementPreview\", async () => {\n00157|   const t = convexTest(schema);\n00158| \n00159|   await seedTestData(t);\n00160| \n00161|   const { code } = await t.mutation(api.lobbies.create, {\n00162|     sessionId: \"host-session-preview\",\n00163|     displayName: \"HostPreview\",\n00164|   });\n00165| \n00166|   await t.mutation(api.lobbies.join, {\n00167|     code,\n00168|     sessionId: \"player-session-preview\",\n00169|     displayName: \"PlayerPreview\",\n00170|   });\n00171| \n00172|   const lobby = await t.query(api.lobbies.get, { code });\n00173| \n00174|   await t.mutation(api.games.start, {\n00175|     lobbyId: lobby!._id,\n00176|     sessionId: \"host-session-preview\",\n00177|   });\n00178| \n00179|   const game = await t.query(api.games.getCurrent, { lobbyId: lobby!._id });\n00180| \n00181|   const roundId = game?.currentRoundId;\n00182| \n00183|   await t.run(async (ctx) => {\n00184|     if (roundId) {\n00185|       await ctx.db.patch(roundId, {\n00186|         placementPreview: { proposedIndex: 2, updatedAt: Date.now() },\n00187|       });\n00188|     }\n00189|   });\n00190| \n00191|   const result = await t.query(api.rounds.getCurrent, {\n00192|     lobbyId: lobby!._id,\n00193|     sessionId: \"host-session-preview\",\n00194|   });\n00195| \n00196|   expect(result).not.toBeNull();\n00197|   expect(result?.placementPreview).not.toBeNull();\n00198|   expect(result?.placementPreview?.proposedIndex).toBe(2);\n00199| });\n00200| \n00201| test(\"setPlacementPreview allows turn player to preview placement\", async () => {\n00202|   const t = convexTest(schema);\n00203| \n00204|   await seedTestData(t);\n00205| \n00206|   const { code } = await t.mutation(api.lobbies.create, {\n00207|     sessionId: \"host-session-preview\",\n00208|     displayName: \"HostPreview\",\n00209|   });\n00210| \n00211|   await t.mutation(api.lobbies.join, {\n00212|     code,\n00213|     sessionId: \"player-session-preview\",\n00214|     displayName: \"PlayerPreview\",\n00215|   });\n00216| \n00217|   const lobby = await t.query(api.lobbies.get, { code });\n00218| \n00219|   await t.mutation(api.games.start, {\n00220|     lobbyId: lobby!._id,\n00221|     sessionId: \"host-session-preview\",\n00222|   });\n00223| \n00224|   let turnPlayerSessionId: string | null = null;\n00225|   await t.run(async (ctx) => {\n00226|     const game = await ctx.db.query(\"games\").first();\n00227|     if (game?.currentRoundId) {\n00228|       const round = await ctx.db.get(game.currentRoundId);\n00229|       if (round) {\n00230|         const player = await ctx.db.get(round.turnPlayerId);\n00231|         if (player) {\n00232|           turnPlayerSessionId = player.sessionId;\n00233|         }\n00234|       }\n00235|     }\n00236|   });\n00237| \n00238|   expect(turnPlayerSessionId).not.toBeNull();\n00239| \n00240|   const result = await t.mutation(api.rounds.setPlacementPreview, {\n00241|     lobbyId: lobby!._id,\n00242|     sessionId: turnPlayerSessionId!,\n00243|     proposedIndex: 0,\n00244|   });\n00245| \n00246|   expect(result).toBeNull();\n00247| \n00248|   const round = await t.query(api.rounds.getCurrent, {\n00249|     lobbyId: lobby!._id,\n00250|     sessionId: \"host-session-preview\",\n00251|   });\n00252| \n00253|   expect(round?.placementPreview).not.toBeNull();\n00254|   expect(round?.placementPreview?.proposedIndex).toBe(0);\n00255|   expect(round?.placementPreview?.updatedAt).toBeDefined();\n00256| });\n00257| \n00258| test(\"setPlacementPreview fails for non-turn player\", async () => {\n00259|   const t = convexTest(schema);\n00260| \n00261|   await seedTestData(t);\n00262| \n00263|   const { code } = await t.mutation(api.lobbies.create, {\n00264|     sessionId: \"host-session-notturn\",\n00265|     displayName: \"HostNotTurn\",\n00266|   });\n00267| \n00268|   await t.mutation(api.lobbies.join, {\n00269|     code,\n00270|     sessionId: \"player-session-notturn\",\n00271|     displayName: \"PlayerNotTurn\",\n00272|   });\n00273| \n00274|   const lobby = await t.query(api.lobbies.get, { code });\n00275| \n00276|   await t.mutation(api.games.start, {\n00277|     lobbyId: lobby!._id,\n00278|     sessionId: \"host-session-notturn\",\n00279|   });\n00