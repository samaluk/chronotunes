{"type":"tool_use","timestamp":1768790796561,"sessionID":"ses_42bde3593ffewMjoFeBKVAd3J5","part":{"id":"prt_bd4257c80001MM8X1jxaBE3XPe","sessionID":"ses_42bde3593ffewMjoFeBKVAd3J5","messageID":"msg_bd4256557001hryu0eSSxT2y2t","type":"tool","callID":"call_function_kafefhkrfmcr_1","tool":"write","state":{"status":"completed","input":{"content":"import { render, screen } from \"@testing-library/react\";\nimport { expect, test, vi } from \"vitest\";\nimport { YouTubePlayer } from \"./YouTubePlayer\";\n\nglobal.window.YT = {\n  Player: vi.fn().mockImplementation(() => ({\n    playVideo: vi.fn(),\n    pauseVideo: vi.fn(),\n    destroy: vi.fn(),\n  })),\n  PlayerState: {\n    PLAYING: 1,\n    PAUSED: 2,\n    ENDED: 0,\n  },\n} as unknown as typeof window.YT;\n\ntest(\"renders with play button initially\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  expect(screen.getByRole(\"button\", { name: \"Play audio\" })).toBeInTheDocument();\n});\n\ntest(\"displays loading state initially\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  expect(screen.getByText(\"Loading audio...\")).toBeInTheDocument();\n});\n\ntest(\"displays error state when video ID is empty\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"\" />);\n\n  expect(screen.getByText(\"Video unavailable\")).toBeInTheDocument();\n});\n\ntest(\"displays error state when video ID is undefined\", () => {\n  render(<YouTubePlayer youtubeVideoId={undefined as unknown as string} />);\n\n  expect(screen.getByText(\"Video unavailable\")).toBeInTheDocument();\n});\n\ntest(\"play button is disabled while loading\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  const button = screen.getByRole(\"button\", { name: \"Play audio\" });\n  expect(button).toBeDisabled();\n});\n\ntest(\"applies custom className\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" className=\"custom-class\" />);\n\n  const container = screen.getByText(\"Loading audio...\").closest(\"div\");\n  expect(container?.parentElement).toHaveClass(\"custom-class\");\n});\n\ntest(\"contains hidden YouTube iframe container\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  const hiddenContainer = screen.getByLabelText(\"hidden-youtube-player\");\n  expect(hiddenContainer).toHaveClass(\n    \"w-[1px] h-[1px] -translate-x-full -translate-y-full\",\n  );\n});\n\ntest(\"renders play icon when not playing\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  const playIcon = screen.getByTestId(\"play-icon\");\n  expect(playIcon).toBeInTheDocument();\n});\n\ntest(\"error state has correct styling\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"\" />);\n\n  const errorContainer = screen.getByText(\"Video unavailable\").closest(\"div\");\n  expect(errorContainer).toHaveClass(\"rounded-lg\");\n  expect(errorContainer).toHaveClass(\"border\");\n});\n\ntest(\"error state contains alert icon\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"\" />);\n\n  const alertIcon = screen.getByTestId(\"alert-icon\");\n  expect(alertIcon).toBeInTheDocument();\n});\n","filePath":"/Users/smaluk/dev/personal/chronotunes/src/components/player/YouTubePlayer.test.tsx"},"output":"Wrote file successfully.","title":"src/components/player/YouTubePlayer.test.tsx","metadata":{"diagnostics":{"/Users/smaluk/dev/personal/chronotunes/convex/schema.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/rounds.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/components/ui/button.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/SoftTimer.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/CurrentRoundPanel.tsx":[{"range":{"start":{"line":135,"character":16},"end":{"line":135,"character":40}},"message":"'_turnPlayerTimelineEntry' is declared but its value is never read.","severity":4,"code":6133,"source":"typescript"},{"range":{"start":{"line":136,"character":16},"end":