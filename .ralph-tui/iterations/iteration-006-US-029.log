{"type":"tool_use","timestamp":1768790739811,"sessionID":"ses_42bde3593ffewMjoFeBKVAd3J5","part":{"id":"prt_bd4248eb1001Ahbh1hCvNvXSco","sessionID":"ses_42bde3593ffewMjoFeBKVAd3J5","messageID":"msg_bd42482a3001iUVcKL9hR4O34q","type":"tool","callID":"call_function_pqd33zf9am7l_1","tool":"write","state":{"status":"completed","input":{"content":"import { render, screen, fireEvent, waitFor } from \"@testing-library/react\";\nimport { expect, test, vi, beforeEach, afterEach } from \"vitest\";\nimport { YouTubePlayer } from \"./YouTubePlayer\";\n\nglobal.window.YT = {\n  Player: vi.fn().mockImplementation(() => ({\n    playVideo: vi.fn(),\n    pauseVideo: vi.fn(),\n    destroy: vi.fn(),\n  })),\n  PlayerState: {\n    PLAYING: 1,\n    PAUSED: 2,\n    ENDED: 0,\n  },\n} as unknown as typeof window.YT;\n\ntest(\"renders with play button initially\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  expect(screen.getByRole(\"button\", { name: \"Play audio\" })).toBeInTheDocument();\n});\n\ntest(\"displays loading state initially\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  expect(screen.getByText(\"Loading audio...\")).toBeInTheDocument();\n});\n\ntest(\"displays error state when video ID is empty\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"\" />);\n\n  expect(screen.getByText(\"Video unavailable\")).toBeInTheDocument();\n});\n\ntest(\"toggles play/pause when button is clicked\", async () => {\n  const mockPlayer = {\n    playVideo: vi.fn(),\n    pauseVideo: vi.fn(),\n    destroy: vi.fn(),\n  };\n\n  global.window.YT = {\n    Player: vi.fn().mockImplementation(() => mockPlayer),\n    PlayerState: {\n      PLAYING: 1,\n      PAUSED: 2,\n      ENDED: 0,\n    },\n  } as unknown as typeof window.YT;\n\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  await waitFor(() => {\n    expect(screen.getByRole(\"button\", { name: \"Play audio\" })).toBeInTheDocument();\n  });\n\n  const playButton = screen.getByRole(\"button\", { name: \"Play audio\" });\n  fireEvent.click(playButton);\n\n  await waitFor(() => {\n    expect(mockPlayer.playVideo).toHaveBeenCalled();\n  });\n});\n\ntest(\"shows playing state after play\", async () => {\n  const mockPlayer = {\n    playVideo: vi.fn(),\n    pauseVideo: vi.fn(),\n    destroy: vi.fn(),\n  };\n\n  global.window.YT = {\n    Player: vi.fn().mockImplementation(() => mockPlayer),\n    PlayerState: {\n      PLAYING: 1,\n      PAUSED: 2,\n      ENDED: 0,\n    },\n  } as unknown as typeof window.YT;\n\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  await waitFor(() => {\n    expect(screen.getByRole(\"button\", { name: \"Play audio\" })).toBeInTheDocument();\n  });\n\n  const playButton = screen.getByRole(\"button\", { name: \"Play audio\" });\n  fireEvent.click(playButton);\n\n  await waitFor(() => {\n    expect(mockPlayer.playVideo).toHaveBeenCalled();\n  });\n});\n\ntest(\"applies custom className\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" className=\"custom-class\" />);\n\n  const container = screen.getByText(\"Loading audio...\").closest(\"div\");\n  expect(container?.parentElement).toHaveClass(\"custom-class\");\n});\n\ntest(\"cleans up player on unmount\", async () => {\n  const mockPlayer = {\n    playVideo: vi.fn(),\n    pauseVideo: vi.fn(),\n    destroy: vi.fn(),\n  };\n\n  global.window.YT = {\n    Player: vi.fn().mockImplementation(() => mockPlayer),\n    PlayerState: {\n      PLAYING: 1,\n      PAUSED: 2,\n      ENDED: 0,\n    },\n  } as unknown as typeof window.YT;\n\n  const { unmount } = render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  await waitFor(() => {\n    expect(screen.getByRole(\"button\", { name: \"Play audio\" })).toBeInTheDocument();\n  });\n\n  unmount();\n\n  expect(mockPlayer.destroy).toHaveBeenCalled();\n});\n","filePath":"/Users/smaluk/dev/personal/chronotunes/src/components/player/YouTubePlayer.test.tsx"},"output":"Wrote file successful