{"type":"tool_use","timestamp":1768790764571,"sessionID":"ses_42bde3593ffewMjoFeBKVAd3J5","part":{"id":"prt_bd4250958001rW6a4uRH2WLK5b","sessionID":"ses_42bde3593ffewMjoFeBKVAd3J5","messageID":"msg_bd424e7590012y6s3cM5Ad2IAF","type":"tool","callID":"call_function_e6f371k4g4h0_1","tool":"write","state":{"status":"completed","input":{"content":"import { render, screen } from \"@testing-library/react\";\nimport { expect, test, vi, beforeEach, afterEach } from \"vitest\";\nimport { YouTubePlayer } from \"./YouTubePlayer\";\n\nglobal.window.YT = {\n  Player: vi.fn().mockImplementation(() => ({\n    playVideo: vi.fn(),\n    pauseVideo: vi.fn(),\n    destroy: vi.fn(),\n  })),\n  PlayerState: {\n    PLAYING: 1,\n    PAUSED: 2,\n    ENDED: 0,\n  },\n} as unknown as typeof window.YT;\n\ntest(\"renders with play button initially\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  expect(screen.getByRole(\"button\", { name: \"Play audio\" })).toBeInTheDocument();\n});\n\ntest(\"displays loading state initially\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  expect(screen.getByText(\"Loading audio...\")).toBeInTheDocument();\n});\n\ntest(\"displays error state when video ID is empty\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"\" />);\n\n  expect(screen.getByText(\"Video unavailable\")).toBeInTheDocument();\n});\n\ntest(\"displays error state when video ID is undefined\", () => {\n  render(<YouTubePlayer youtubeVideoId={undefined as unknown as string} />);\n\n  expect(screen.getByText(\"Video unavailable\")).toBeInTheDocument();\n});\n\ntest(\"play button is disabled while loading\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  const button = screen.getByRole(\"button\", { name: \"Play audio\" });\n  expect(button).toBeDisabled();\n});\n\ntest(\"applies custom className\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" className=\"custom-class\" />);\n\n  const container = screen.getByText(\"Loading audio...\").closest(\"div\");\n  expect(container?.parentElement).toHaveClass(\"custom-class\");\n});\n\ntest(\"contains hidden YouTube iframe container\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  const hiddenContainer = screen.getByRole(\"presentation\", {\n    hidden: true,\n  });\n  expect(hiddenContainer).toHaveClass(\n    \"w-[1px] h-[1px] -translate-x-full -translate-y-full\",\n  );\n});\n\ntest(\"renders play icon when not playing\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"test-video-id\" />);\n\n  const playIcon = screen.getByTestId(\"play-icon\");\n  expect(playIcon).toBeInTheDocument();\n});\n\ntest(\"error state has correct styling\", () => {\n  render(<YouTubePlayer youtubeVideoId=\"\" />);\n\n  const errorContainer = screen.getByText(\"Video unavailable\").closest(\"div\");\n  expect(errorContainer).toHaveClass(\n    \"bg-destructive/10 border-destructive/20\",\n  );\n});\n","filePath":"/Users/smaluk/dev/personal/chronotunes/src/components/player/YouTubePlayer.test.tsx"},"output":"Wrote file successfully.","title":"src/components/player/YouTubePlayer.test.tsx","metadata":{"diagnostics":{"/Users/smaluk/dev/personal/chronotunes/convex/schema.ts":[],"/Users/smaluk/dev/personal/chronotunes/convex/rounds.ts":[],"/Users/smaluk/dev/personal/chronotunes/src/components/ui/button.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/SoftTimer.tsx":[],"/Users/smaluk/dev/personal/chronotunes/src/components/game/CurrentRoundPanel.tsx":[{"range":{"start":{"line":135,"character":16},"end":{"line":135,"character":40}},"message":"'_turnPlayerTimelineEntry' is declared but its value is never read.","severity":4,"code":6133,"source":"typescript"},{"range":{"start":{"line":136,"character":16},"end":{"line":136,"character":44}},"message":"'_turnPlayerTimelineSizeValue' is declared but its value is never read.","severity":4,"code":6133,"source":"typescript"}],"/Users/smaluk/dev/per