{"type":"tool_use","timestamp":1768790588303,"sessionID":"ses_42bde3593ffewMjoFeBKVAd3J5","part":{"id":"prt_bd4227a01001cwyQ2zea40GvC3","sessionID":"ses_42bde3593ffewMjoFeBKVAd3J5","messageID":"msg_bd4226ff7001HnnZ5gLbzlJK4j","type":"tool","callID":"call_function_t968dvaoaqh3_1","tool":"read","state":{"status":"completed","input":{"filePath":"/Users/smaluk/dev/personal/chronotunes/src/components/game/SoftTimer.tsx"},"output":"<file>\n00001| \"use client\";\n00002| \n00003| import { AlertTriangle, Timer } from \"lucide-react\";\n00004| import { useEffect, useState } from \"react\";\n00005| import { Progress, ProgressIndicator, ProgressTrack } from \"@/components/ui/progress\";\n00006| \n00007| interface SoftTimerProps {\n00008|   startedAt: number;\n00009|   turnSeconds: number;\n00010|   lowTimeThreshold?: number;\n00011|   showProgress?: boolean;\n00012|   className?: string;\n00013| }\n00014| \n00015| export function SoftTimer({\n00016|   startedAt,\n00017|   turnSeconds,\n00018|   lowTimeThreshold = 10,\n00019|   showProgress = true,\n00020|   className,\n00021| }: SoftTimerProps): React.ReactNode {\n00022|   const [timeRemaining, setTimeRemaining] = useState<number | null>(null);\n00023| \n00024|   useEffect(() => {\n00025|     const calculateTimeRemaining = (): number => {\n00026|       const elapsed = (Date.now() - startedAt) / 1000;\n00027|       const remaining = turnSeconds - elapsed;\n00028|       return remaining;\n00029|     };\n00030| \n00031|     setTimeRemaining(calculateTimeRemaining());\n00032| \n00033|     const interval = setInterval(() => {\n00034|       const remaining = calculateTimeRemaining();\n00035|       setTimeRemaining(remaining);\n00036|     }, 100);\n00037| \n00038|     return () => clearInterval(interval);\n00039|   }, [startedAt, turnSeconds]);\n00040| \n00041|   const formatTime = (seconds: number): string => {\n00042|     const absSeconds = Math.abs(seconds);\n00043|     const mins = Math.floor(absSeconds / 60);\n00044|     const secs = Math.floor(absSeconds % 60);\n00045|     const sign = seconds < 0 ? \"-\" : \"\";\n00046|     return `${sign}${mins}:${secs.toString().padStart(2, \"0\")}`;\n00047|   };\n00048| \n00049|   const isLowTime =\n00050|     timeRemaining !== null && timeRemaining <= lowTimeThreshold && timeRemaining > -60;\n00051|   const isOverdue = timeRemaining !== null && timeRemaining <= -60;\n00052|   const progressValue =\n00053|     timeRemaining !== null ? Math.max(0, Math.min(100, (timeRemaining / turnSeconds) * 100)) : null;\n00054| \n00055|   return (\n00056|     <div className={className}>\n00057|       <div\n00058|         className={`\n00059|           inline-flex items-center gap-2 px-4 py-2 rounded-lg font-mono text-lg\n00060|           ${isLowTime && !isOverdue ? \"bg-destructive/10 text-destructive animate-pulse\" : \"\"}\n00061|           ${isOverdue ? \"bg-muted text-muted-foreground\" : \"bg-muted\"}\n00062|         `}\n00063|       >\n00064|         <Timer className={`h-5 w-5 ${isLowTime && !isOverdue ? \"animate-pulse\" : \"\"}`} />\n00065|         <span>{timeRemaining !== null ? formatTime(timeRemaining) : \"--:--\"}</span>\n00066|         {isLowTime && !isOverdue && (\n00067|           <AlertTriangle data-testid=\"alert-triangle\" className=\"h-4 w-4 animate-pulse\" />\n00068|         )}\n00069|       </div>\n00070|       {showProgress && progressValue !== null && (\n00071|         <div className=\"mt-2\">\n00072|           <Progress value={progressValue} className=\"h-1.5\">\n00073|             <ProgressTrack>\n00074|               <ProgressIndicator\n00075|                 className={\n00076|                   progressValue <= (lowTimeThreshold / turnSeconds) * 100\n00077|                     ? \"bg-destructive animate-pulse\"\n00078|                     : \"\"\n00079|                 }\n00080|               />\n00081|             </ProgressTrack>\n00082|           </Progress>\n00083|         </div>\n00084|       )}\n00085|     </div>\n00086|   );\n00087| }\n00088| \n\n(End of file - total 88 lines)\n</file>","title":"src/components/game/SoftTimer.tsx","metadata":{"preview":"\"use client\";\n\nimport { AlertTriangle, Timer } from \"lucide-react\";\nimport { useEffect, useState } from \"react\";\nimport { Progress, ProgressIndicator, ProgressTrack } from \"@/components/ui/progress\";\n\ninterface SoftTimerProps {\n  startedAt: number;\n  turnSeconds: number;\n  lowTimeThreshold?: number;\n  showProgress?: boolean;\n  className?: string;\n}\n\nexport function SoftTimer({\n  startedAt,\n  turnSeconds,\n  lowTimeThreshold = 10,\n  showProgress = true,\n  className,","truncated":false},"time":{"start":1768790588301,"end":1768790588303}}}}
