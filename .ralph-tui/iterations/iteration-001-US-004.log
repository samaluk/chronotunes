{"type":"tool_use","timestamp":1768789122584,"sessionID":"ses_42bf48a4bffezEPnBhXIQDwbU9","part":{"id":"prt_bd40c1c8f001Sv7ZmcQEhL2BCD","sessionID":"ses_42bf48a4bffezEPnBhXIQDwbU9","messageID":"msg_bd40c0c070012QE3PawrMqNMAz","type":"tool","callID":"call_function_dopjywzp0odm_1","tool":"read","state":{"status":"completed","input":{"filePath":"/Users/smaluk/dev/personal/chronotunes/convex/schema.ts"},"output":"<file>\n00001| import { defineSchema, defineTable } from \"convex/server\";\n00002| import { v } from \"convex/values\";\n00003| \n00004| // Lobby status enum values\n00005| const lobbyStatus = v.union(v.literal(\"lobby\"), v.literal(\"in_game\"), v.literal(\"finished\"));\n00006| \n00007| // Game status enum values\n00008| const gameStatus = v.union(v.literal(\"active\"), v.literal(\"paused\"), v.literal(\"finished\"));\n00009| \n00010| // Round phase enum values\n00011| const roundPhase = v.union(v.literal(\"placing\"), v.literal(\"betting\"), v.literal(\"resolved\"));\n00012| \n00013| // Bet status enum values\n00014| const betStatus = v.union(v.literal(\"pending\"), v.literal(\"won\"), v.literal(\"lost\"));\n00015| \n00016| // Lobby settings object\n00017| const lobbySettings = v.object({\n00018|   targetTimelineSize: v.number(),\n00019|   startingCoins: v.number(),\n00020|   turnSeconds: v.number(),\n00021|   bettingWindowSeconds: v.number(),\n00022|   allowGuessTitleArtist: v.boolean(),\n00023|   showLiveBets: v.boolean(),\n00024|   allowBetRetraction: v.boolean(),\n00025|   minYear: v.number(),\n00026|   maxYear: v.number(),\n00027| });\n00028| \n00029| // Timeline entry for player's timeline (embedded array)\n00030| const timelineEntry = v.object({\n00031|   trackId: v.id(\"tracks\"),\n00032|   year: v.number(),\n00033|   earnedAtRoundNumber: v.number(),\n00034|   earnedBy: v.union(v.literal(\"placement\"), v.literal(\"bet\")),\n00035| });\n00036| \n00037| // Placement preview object\n00038| const placementPreview = v.object({\n00039|   proposedIndex: v.number(),\n00040|   updatedAt: v.number(),\n00041| });\n00042| \n00043| // Placement object\n00044| const placement = v.object({\n00045|   proposedIndex: v.number(),\n00046|   submittedAt: v.number(),\n00047| });\n00048| \n00049| // Guess object for title/artist guessing\n00050| const guess = v.object({\n00051|   guessedTitle: v.optional(v.string()),\n00052|   guessedArtist: v.optional(v.string()),\n00053|   isCorrect: v.boolean(),\n00054|   awardedCoin: v.boolean(),\n00055|   submittedAt: v.number(),\n00056| });\n00057| \n00058| // Round resolution object\n00059| const resolution = v.object({\n00060|   validIndexMin: v.number(),\n00061|   validIndexMax: v.number(),\n00062|   turnPlayerWasCorrect: v.boolean(),\n00063|   awardedPlayerIds: v.array(v.id(\"players\")),\n00064|   coinDeltas: v.array(\n00065|     v.object({\n00066|       playerId: v.id(\"players\"),\n00067|       delta: v.number(),\n00068|     }),\n00069|   ),\n00070|   resolvedAt: v.number(),\n00071| });\n00072| \n00073| // External IDs for tracks (Spotify, YouTube, Deezer)\n00074| const externalIds = v.object({\n00075|   spotifyTrackId: v.optional(v.string()),\n00076|   youtubeVideoId: v.optional(v.string()),\n00077|   deezerTrackId: v.optional(v.string()),\n00078| });\n00079| \n00080| // Links for tracks\n00081| const trackLinks = v.object({\n00082|   spotifyUrl: v.optional(v.string()),\n00083|   youtubeUrl: v.optional(v.string()),\n00084|   deezerUrl: v.optional(v.string()),\n00085| });\n00086| \n00087| export default defineSchema({\n00088|   // Lobbies table\n00089|   lobbies: defineTable({\n00090|     code: v.string(),\n00091|     hostSessionId: v.string(),\n00092|     hostTransferDeadline: v.optional(v.number()),\n00093|     status: lobbyStatus,\n00094|     settings: lobbySettings,\n00095|     activeGameId: v.optional(v.id(\"games\")),\n00096|   }).index(\"by_code\", [\"code\"]),\n00097| \n00098|   // Players table\n00099|   players: defineTable({\n00100|     lobbyId: v.id(\"lobbies\"),\n00101|     sessionId: v.string(),\n00102|     displayName: v.string(),\n00103|     isHost: v.boolean(),\n00104|     coins: v.number(),\n00105|     timeline: v.array(timelineEntry),\n00106|     timelineSize: v.number(),\n00107|     createdAt: v.number(),\n00108|   })\n00109|     .index(\"by_lobby\", [\"lobbyId\"])\n00110|     .index(\"by_lobby_and_session\", [\"lobbyId\", \"sessionId\"]),\n00111| \n00112|   // Games table\n00113|   games: defineTable({\n00114|     lobbyId: v.id(\"lobbies\"),\n00115|     status: gameStatus,\n00116|     startedAt: v.number(),\n00117|     endedAt: v.optional(v.number()),\n00118|     currentRoundNumber: v.number(),\n00119|     currentRoundId: v.optional(v.id(\"rounds\")),\n00120|     turnPlayerId: v.optional(v.id(\"players\")),\n00121|     turnOrder: v.array(v.id(\"players\")),\n00122|     winnerPlayerId: v.optional(v.id(\"players\")),\n00123|   }).index(\"by_lobby\", [\"lobbyId\"]),\n00124| \n00125|   // Rounds table\n00126|   rounds: defineTable({\n00127|     gameId: v.id(\"games\"),\n00128|     roundNumber: v.number(),\n00129|     turnPlayerId: v.id(\"players\"),\n00130|     trackId: v.id(\"tracks\"),\n00131|     phase: roundPhase,\n00132|     startedAt: v.number(),\n00133|     placementPreview: v.optional(placementPreview),\n00134|     placement: v.optional(placement),\n00135|     guess: v.optional(guess),\n00136|     resolution: v.optional(resolution),\n00137|   }).index(\"by_game\", [\"gameId\"]),\n00138| \n00139|   // RoundBets table\n00140|   roundBets: defineTable({\n00141|     roundId: v.id(\"rounds\"),\n00142|     playerId: v.id(\"players\"),\n00143|     proposedIndex: v.number(),\n00144|     placedAt: v.number(),\n00145|     lockedIn: v.boolean(),\n00146|     status: betStatus,\n00147|   })\n00148|     .index(\"by_round\", [\"roundId\"])\n00149|     .index(\"by_round_and_player\", [\"roundId\", \"playerId\"]),\n00150| \n00151|   // Tracks table\n00152|   tracks: defineTable({\n00153|     mbid: v.optional(v.string()),\n00154|     title: v.string(),\n00155|     artist: v.string(),\n00156|     year: v.number(),\n00157|     durationMs: v.optional(v.number()),\n00158|     externalIds: externalIds,\n00159|     links: trackLinks,\n00160|     createdAt: v.number(),\n00161|     source: v.string(),\n00162|   })\n00163|     .index(\"by_year\", [\"year\"])\n00164|     .index(\"by_year_and_creation\", [\"year\", \"createdAt\"]),\n00165| });\n00166| \n\n(End of file - total 166 lines)\n</file>","title":"convex/schema.ts","metadata":{"preview":"import { defineSchema, defineTable } from \"convex/server\";\nimport { v } from \"convex/values\";\n\n// Lobby status enum values\nconst lobbyStatus = v.union(v.literal(\"lobby\"), v.literal(\"in_game\"), v.literal(\"finished\"));\n\n// Game status enum values\nconst gameStatus = v.union(v.literal(\"active\"), v.literal(\"paused\"), v.literal(\"finished\"));\n\n// Round phase enum values\nconst roundPhase = v.union(v.literal(\"placing\"), v.literal(\"betting\"), v.literal(\"resolved\"));\n\n// Bet status enum values\nconst betStatus = v.union(v.literal(\"pending\"), v.literal(\"won\"), v.literal(\"lost\"));\n\n// Lobby settings object\nconst lobbySettings = v.object({\n  targetTimelineSize: v.number(),\n  startingCoins: v.number(),\n  turnSeconds: v.number(),","truncated":false},"time":{"start":1768789122582,"end":1768789122583}}}}
