{"type":"tool_use","timestamp":1768789112951,"sessionID":"ses_42bf48a4bffezEPnBhXIQDwbU9","part":{"id":"prt_bd40bf62c001A3tsHNnF07Ci5B","sessionID":"ses_42bf48a4bffezEPnBhXIQDwbU9","messageID":"msg_bd40bec07001RjWli26yT2j2Az","type":"tool","callID":"call_function_tpbcm9l0nw67_1","tool":"read","state":{"status":"completed","input":{"filePath":"/Users/smaluk/dev/personal/chronotunes/src/lib/session.ts"},"output":"<file>\n00001| /**\n00002|  * Client-side session ID management using localStorage.\n00003|  *\n00004|  * Sessions provide anonymous player identity without requiring user accounts.\n00005|  * The session ID is generated once and persisted in localStorage, surviving\n00006|  * page refreshes and browser restarts.\n00007|  */\n00008| \n00009| const SESSION_STORAGE_KEY = \"chronotunes-session-id\";\n00010| \n00011| /**\n00012|  * Generates a cryptographically random UUID v4.\n00013|  */\n00014| function generateSessionId(): string {\n00015|   return crypto.randomUUID();\n00016| }\n00017| \n00018| /**\n00019|  * Gets the current session ID from localStorage, creating a new one if needed.\n00020|  *\n00021|  * This function is safe to call in browser environments only.\n00022|  * It will throw an error if called during SSR (no window object).\n00023|  *\n00024|  * @returns The session ID (UUID v4 format)\n00025|  * @throws Error if called in a non-browser environment\n00026|  */\n00027| export function getSessionId(): string {\n00028|   if (typeof window === \"undefined\") {\n00029|     throw new Error(\"getSessionId() can only be called in browser environments\");\n00030|   }\n00031| \n00032|   let sessionId = localStorage.getItem(SESSION_STORAGE_KEY);\n00033| \n00034|   if (!sessionId) {\n00035|     sessionId = generateSessionId();\n00036|     localStorage.setItem(SESSION_STORAGE_KEY, sessionId);\n00037|   }\n00038| \n00039|   return sessionId;\n00040| }\n00041| \n00042| /**\n00043|  * Clears the current session ID from localStorage.\n00044|  * The next call to getSessionId() will generate a new session.\n00045|  *\n00046|  * This is useful for testing or when a user wants to start fresh.\n00047|  */\n00048| export function clearSessionId(): void {\n00049|   if (typeof window === \"undefined\") {\n00050|     throw new Error(\"clearSessionId() can only be called in browser environments\");\n00051|   }\n00052| \n00053|   localStorage.removeItem(SESSION_STORAGE_KEY);\n00054| }\n00055| \n00056| /**\n00057|  * Checks if a session ID currently exists in localStorage.\n00058|  *\n00059|  * @returns true if a session ID exists, false otherwise\n00060|  */\n00061| export function hasSessionId(): boolean {\n00062|   if (typeof window === \"undefined\") {\n00063|     return false;\n00064|   }\n00065| \n00066|   return localStorage.getItem(SESSION_STORAGE_KEY) !== null;\n00067| }\n00068| \n\n(End of file - total 68 lines)\n</file>","title":"src/lib/session.ts","metadata":{"preview":"/**\n * Client-side session ID management using localStorage.\n *\n * Sessions provide anonymous player identity without requiring user accounts.\n * The session ID is generated once and persisted in localStorage, surviving\n * page refreshes and browser restarts.\n */\n\nconst SESSION_STORAGE_KEY = \"chronotunes-session-id\";\n\n/**\n * Generates a cryptographically random UUID v4.\n */\nfunction generateSessionId(): string {\n  return crypto.randomUUID();\n}\n\n/**\n * Gets the current session ID from localStorage, creating a new one if needed.\n *","truncated":false},"time":{"start":1768789112949,"end":1768789112951}}}}
